## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache files
.vs/
*.vsix
*.vsp
*.vspx

# Visual Studio solution files (keep the .sln but ignore the cache)
*.slnx/
*.slnx/*

# NuGet packages
*.nupkg
*.snupkg
packages/
*.nuspec
*.pkgproj

# Web publish output
*.Publish.xml
*.pubxml.user
*.pubxml

# Publish Web Output
.publish/
Publish/
Web.Publish.config
*.deploy
*.deploy.cmd

# Entity Framework Core Migrations
[Mm]igrations/*.Designer.cs
[Mm]igrations/*.cs

# App settings with secrets
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
*.local.json
*.secrets.json

# User secrets
secrets.json

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Cc]overage/
*.TestResults.xml
*.coverage

# Logs
*.log
logs/
[Ll]ogFiles/

# Visual Studio Code
.vscode/

# Windows
Thumbs.db
*.desktop
Desktop.ini

# OSX
*.DS_Store
.DS_Store

# Node modules (if any)
node_modules/
npm-debug.log
yarn-error.log

# Temp files
*.tmp
*.temp
*~