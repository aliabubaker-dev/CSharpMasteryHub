@page
@model AboutModel
@{
    ViewData["Title"] = "About C# Mastery Hub";
}

<!-- ============================================================
     ABOUT PAGE - ENHANCED DESIGN
     ============================================================ -->

<div class="about-page">

    <!-- Hero Section -->
    <section class="about-hero text-center py-5" data-aos="fade-up" data-aos-duration="1000">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="hero-badge mb-3" data-aos="zoom-in" data-aos-delay="200">
                        <span class="badge bg-primary px-3 py-2 rounded-pill">
                            <i class="fas fa-code me-1"></i> Built with ❤️ by a Developer
                        </span>
                    </div>
                    <h1 class="display-4 fw-bold mb-3" data-aos="fade-up" data-aos-delay="300">
                        About <span class="text-primary">C# Mastery Hub</span>
                    </h1>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="400">
                        Your complete free guide to mastering C#. Built by a developer who believes quality education should be accessible to everyone.
                    </p>
                    <div class="mt-4" data-aos="fade-up" data-aos-delay="500">
                        <a href="https://crossplatformdev.com" target="_blank" class="btn btn-primary-custom pulse-btn">
                            <i class="fas fa-external-link-alt me-2"></i>Visit CrossPlatformDev
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Creator Spotlight -->
    <section class="creator-spotlight py-5" data-aos="fade-up" data-aos-duration="1000">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
                    <div class="creator-card p-4 rounded-4 bg-white shadow-sm">
                        <div class="d-flex align-items-center mb-3">
                            <div class="status-badge">
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="fas fa-circle text-success me-1" style="font-size: 0.6rem;"></i>
                                    Available for projects
                                </span>
                            </div>
                        </div>
                        <h2 class="display-6 fw-bold mb-2">Hi, I'm Ali 👋</h2>
                        <p class="lead text-muted">Building software that actually works.</p>
                        <div class="row g-3 mt-3">
                            <div class="col-4">
                                <div class="stat-mini text-center">
                                    <div class="number display-6 fw-bold text-primary">5+</div>
                                    <div class="label small text-muted">Years Experience</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-mini text-center">
                                    <div class="number display-6 fw-bold text-success">300+</div>
                                    <div class="label small text-muted">Support Cases</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-mini text-center">
                                    <div class="number display-6 fw-bold text-info">100%</div>
                                    <div class="label small text-muted">Test Coverage</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 p-3 bg-dark rounded-3">
                            <pre class="mb-0 text-light" style="font-size: 0.8rem; background: transparent; padding: 0; margin: 0;">
<code>developer@ali ~/portfolio
main
●
// ════════════════════════════════════════
// 👨‍💻 Full-Stack Developer · 5+ years
// 🚀 Building production software since 2019
// ════════════════════════════════════════</code></pre>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="ps-lg-4">
                        <h3 class="fw-bold mb-3">Who I Am</h3>
                        <p class="text-muted">
                            Senior software developer with 5+ years of experience in full-stack development, IT infrastructure, and operations. I've built and maintained production .NET and Node.js applications, with a strong foundation in cybersecurity and cloud architecture.
                        </p>
                        <div class="row g-3 mt-3">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-map-marker-alt text-primary"></i>
                                    <span>Hamilton, ON, Canada</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-globe text-primary"></i>
                                    <span>Available worldwide</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-language text-primary"></i>
                                    <span>English, Kurdish, Arabic</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-briefcase text-primary"></i>
                                    <span>.NET Software Developer</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <a href="https://crossplatformdev.com" target="_blank" class="btn btn-outline-primary">
                                <i class="fas fa-external-link-alt me-2"></i>Visit My Portfolio
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About C# Mastery Hub -->
    <section class="about-mission py-5 bg-light" data-aos="fade-up" data-aos-duration="1000">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
                    <h2 class="display-5 fw-bold mb-3">About <span class="text-primary">This Website</span></h2>
                    <p class="text-muted">
                        C# Mastery Hub was created with a single mission: to provide the most comprehensive, free, and accessible C# learning resource available online. I believe that quality programming education should be available to everyone, regardless of their financial situation.
                    </p>
                    <p class="text-muted">
                        This website is a reflection of my commitment to teaching and sharing knowledge. Everything here is built with the same care and attention to detail that I put into my professional work.
                    </p>
                    <div class="mt-4">
                        <div class="d-flex align-items-center gap-3">
                            <img src="~/img/logo-icon.png" alt="CrossPlatformDev" height="35">
                            <span class="fw-semibold">CrossPlatformDev</span>
                            <span class="text-muted">—</span>
                            <span class="text-muted small">Custom Websites, Mobile Apps &amp; Business Systems</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mission-card p-4 bg-white rounded-4 shadow-sm h-100">
                                <i class="fas fa-rocket fa-2x text-primary mb-3"></i>
                                <h5>Complete Curriculum</h5>
                                <p class="text-muted small">From absolute beginner to professional developer</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mission-card p-4 bg-white rounded-4 shadow-sm h-100">
                                <i class="fas fa-laptop-code fa-2x text-success mb-3"></i>
                                <h5>Hands-on Projects</h5>
                                <p class="text-muted small">Real-world projects that build your portfolio</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mission-card p-4 bg-white rounded-4 shadow-sm h-100">
                                <i class="fas fa-shield-alt fa-2x text-info mb-3"></i>
                                <h5>Best Practices</h5>
                                <p class="text-muted small">Clean code, SOLID principles, security</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mission-card p-4 bg-white rounded-4 shadow-sm h-100">
                                <i class="fas fa-mobile-alt fa-2x text-warning mb-3"></i>
                                <h5>Modern Tech</h5>
                                <p class="text-muted small">.NET 10, ASP.NET Core, SQL Server, MAUI</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- What I Build Section -->
    <section class="what-i-build py-5" data-aos="fade-up" data-aos-duration="1000">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up" data-aos-delay="200">
                <h2 class="display-5 fw-bold">What I Build</h2>
                <p class="lead text-muted">One developer, every layer of your product.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4" data-aos="flip-up" data-aos-delay="100">
                    <div class="build-card p-4 bg-white rounded-4 shadow-sm text-center h-100">
                        <div class="icon-circle mx-auto mb-3" style="background: rgba(81,43,212,0.1);">
                            <i class="fas fa-globe fa-2x text-primary"></i>
                        </div>
                        <h5>Website Development</h5>
                        <p class="text-muted small">Business websites, landing pages, and web apps built with modern frameworks</p>
                        <span class="badge bg-primary">Business Websites</span>
                        <span class="badge bg-secondary">Landing Pages</span>
                        <span class="badge bg-info text-dark">Web Apps</span>
                    </div>
                </div>
                <div class="col-md-4" data-aos="flip-up" data-aos-delay="200">
                    <div class="build-card p-4 bg-white rounded-4 shadow-sm text-center h-100">
                        <div class="icon-circle mx-auto mb-3" style="background: rgba(25,135,84,0.1);">
                            <i class="fas fa-mobile-alt fa-2x text-success"></i>
                        </div>
                        <h5>Mobile &amp; Android Apps</h5>
                        <p class="text-muted small">Native and cross-platform mobile applications for Android and iOS</p>
                        <span class="badge bg-success">Android</span>
                        <span class="badge bg-secondary">Cross-Platform</span>
                        <span class="badge bg-warning text-dark">App Store</span>
                    </div>
                </div>
                <div class="col-md-4" data-aos="flip-up" data-aos-delay="300">
                    <div class="build-card p-4 bg-white rounded-4 shadow-sm text-center h-100">
                        <div class="icon-circle mx-auto mb-3" style="background: rgba(13,110,253,0.1);">
                            <i class="fas fa-server fa-2x text-info"></i>
                        </div>
                        <h5>Business Management Systems</h5>
                        <p class="text-muted small">Custom systems for real operations — inventory, POS, and management software</p>
                        <span class="badge bg-info text-dark">Inventory</span>
                        <span class="badge bg-warning text-dark">POS</span>
                        <span class="badge bg-danger">Supermarket Systems</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Tech Stack -->
    <section class="tech-stack py-5 bg-light" data-aos="fade-up" data-aos-duration="1000">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up" data-aos-delay="200">
                <h2 class="display-5 fw-bold">Tech Stack</h2>
                <p class="lead text-muted">What I work with every single day.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4" data-aos="fade-right" data-aos-delay="100">
                    <div class="tech-card p-4 bg-white rounded-4 shadow-sm h-100">
                        <h5><i class="fas fa-code text-primary me-2"></i>Languages</h5>
                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span>C#</span>
                                <span>95%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: 95%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>JavaScript / TypeScript</span>
                                <span>90%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: 90%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>SQL</span>
                                <span>85%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-info" style="width: 85%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="tech-card p-4 bg-white rounded-4 shadow-sm h-100">
                        <h5><i class="fas fa-cogs text-success me-2"></i>Frameworks &amp; Tools</h5>
                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span>.NET Core / ASP.NET</span>
                                <span>95%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: 95%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>React / Bootstrap</span>
                                <span>85%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-warning" style="width: 85%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Git / Azure DevOps</span>
                                <span>95%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-danger" style="width: 95%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-left" data-aos-delay="300">
                    <div class="tech-card p-4 bg-white rounded-4 shadow-sm h-100">
                        <h5><i class="fas fa-cloud text-info me-2"></i>Cloud &amp; Databases</h5>
                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Azure</span>
                                <span>85%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-info" style="width: 85%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>SQL Server</span>
                                <span>90%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: 90%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>MongoDB / MySQL</span>
                                <span>80%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: 80%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section py-5" data-aos="fade-up" data-aos-duration="1000">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <div class="cta-box p-5 rounded-4" style="background: linear-gradient(135deg, var(--primary-color), #0D6EFD);">
                        <h3 class="text-white fw-bold mb-3">Ready to Build Something Amazing?</h3>
                        <p class="text-white-50 mb-4">From websites to mobile apps to full business systems — let's turn your idea into working software.</p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a href="https://crossplatformdev.com" target="_blank" class="btn btn-light btn-lg">
                                <i class="fas fa-external-link-alt me-2"></i>Visit CrossPlatformDev
                            </a>
                            <a href="/Contact" class="btn btn-outline-light btn-lg">
                                <i class="fas fa-envelope me-2"></i>Get in Touch
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ============================================================
     STYLES
     ============================================================ -->
<style>
    .about-hero {
        background: linear-gradient(135deg, rgba(81, 43, 212, 0.05), rgba(13, 110, 253, 0.05));
        border-bottom: 1px solid rgba(81, 43, 212, 0.1);
    }

    .creator-card {
        border: 1px solid rgba(0,0,0,0.05);
    }

    .mission-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }
        .mission-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

    .build-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }
        .build-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

    .tech-card {
        border: 1px solid rgba(0,0,0,0.05);
    }

    .status-badge .badge {
        animation: pulse-dot 2s infinite;
    }

    @@keyframes pulse-dot {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    .stat-mini .number {
        font-weight: 700;
    }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cta-box {
        background: linear-gradient(135deg, var(--primary-color), #0D6EFD);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .about-hero h1 {
            font-size: 2.2rem;
        }
        .creator-card .display-6 {
            font-size: 1.5rem;
        }
        .build-card {
            padding: 1.5rem !important;
        }
    }

    @@media (max-width: 576px) {
        .about-hero h1 {
            font-size: 1.8rem;
        }
        .mission-card {
            padding: 1rem !important;
        }
        .cta-box {
            padding: 2rem 1rem !important;
        }
            .cta-box .btn {
                font-size: 0.9rem;
                padding: 0.6rem 1.2rem;
            }
        .tech-card {
            padding: 1.5rem !important;
        }
        .stat-mini .display-6 {
            font-size: 1.5rem;
        }
        .stat-mini .label {
            font-size: 0.7rem;
        }
    }
</style>

<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize AOS if available
        if (typeof AOS !== 'undefined') {
            AOS.init({
                once: true,
                offset: 50,
                duration: 600
            });
        }
    });
</script>