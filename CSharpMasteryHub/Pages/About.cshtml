@page
@model AboutModel
@{
    ViewData["Title"] = "About C# Mastery Hub";
}

<h1 class="display-4 mb-4">About C# Mastery Hub</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">Our Mission</h4>
        <p class="card-text">
            C# Mastery Hub was created with a single mission: to provide the most comprehensive,
            free, and accessible C# learning resource available online. We believe that quality
            programming education should be available to everyone, regardless of their financial situation.
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">What We Offer</h4>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong>Complete Curriculum:</strong> From absolute beginner to professional developer
            </li>
            <li class="list-group-item">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong>Hands-on Projects:</strong> Real-world projects that build your portfolio
            </li>
            <li class="list-group-item">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong>Modern Technologies:</strong> .NET 10, ASP.NET Core, SQL Server, MAUI
            </li>
            <li class="list-group-item">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong>Best Practices:</strong> Clean code, SOLID principles, security, and performance
            </li>
            <li class="list-group-item">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong>SEO Optimized:</strong> Each lesson is optimized for search engines
            </li>
        </ul>
    </div>
</div>

<p><a href="/" class="btn btn-primary-custom">Start Learning Now</a></p>