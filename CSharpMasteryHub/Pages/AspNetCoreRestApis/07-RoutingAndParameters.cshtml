                    <a href="/AspNetCoreRestApis/08-StatusCodes" class="btn btn-primary-custom">Next Lesson <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
            </div>
        </div>
        <div class="col-lg-3">@await Html.PartialAsync("_SidebarNav", Model.SidebarNav)</div>
    </div>
</div>
