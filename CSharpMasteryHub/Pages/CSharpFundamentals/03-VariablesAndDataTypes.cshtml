                        Next Lesson <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            @await Html.PartialAsync("_SidebarNav", Model.SidebarNav)
        </div>
    </div>
</div>

@await Html.PartialAsync("_QuizButton", "CSharpFundamentals_Lesson3")

@section Scripts {
    <script>
        function toggleExercise() {
            var solution = document.getElementById('exerciseSolution');
            if (solution.style.display === 'none') {
                solution.style.display = 'block';
            } else {
                solution.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    once: true,
                    offset: 40,
                    duration: 600
                });
            }
        });
    </script>
    <style>
        .code-block pre {
            background: transparent !important;
            padding: 0 !important;
            margin: 0 !important;
        }
