                            <div class="code-block bg-dark p-3 rounded-3">
                                <pre><code class="language-csharp"><span class="comment">// Pizza Order Calculator</span>
<span class="keyword">using</span> <span class="class">System</span>;

<span class="keyword">class</span> <span class="class">Program</span>
{
    <span class="keyword">static void</span> <span class="function">Main</span>()
    {
        <span class="comment">// Prices</span>
        <span class="keyword">decimal</span> <span class="variable">pizzaPrice</span> = <span class="number">12.99</span><span class="keyword">m</span>;
        <span class="keyword">decimal</span> <span class="variable">toppingPrice</span> = <span class="number">2.50</span><span class="keyword">m</span>;
        <span class="keyword">decimal</span> <span class="variable">taxRate</span> = <span class="number">0.08</span><span class="keyword">m</span>;

        <span class="comment">// Order details</span>
        <span class="keyword">int</span> <span class="variable">numberOfPizzas</span> = <span class="number">3</span>;
        <span class="keyword">int</span> <span class="variable">toppingsPerPizza</span> = <span class="number">2</span>;

        <span class="comment">// Calculations</span>
        <span class="keyword">int</span> <span class="variable">totalToppings</span> = <span class="variable">numberOfPizzas</span> * <span class="variable">toppingsPerPizza</span>;
        <span class="keyword">decimal</span> <span class="variable">baseCost</span> = <span class="variable">pizzaPrice</span> * <span class="variable">numberOfPizzas</span>;
        <span class="keyword">decimal</span> <span class="variable">toppingCost</span> = <span class="variable">toppingPrice</span> * <span class="variable">totalToppings</span>;
        <span class="keyword">decimal</span> <span class="variable">subtotal</span> = <span class="variable">baseCost</span> + <span class="variable">toppingCost</span>;
        <span class="keyword">decimal</span> <span class="variable">taxAmount</span> = <span class="variable">subtotal</span> * <span class="variable">taxRate</span>;
        <span class="keyword">decimal</span> <span class="variable">total</span> = <span class="variable">subtotal</span> + <span class="variable">taxAmount</span>;

        <span class="comment">// Print results</span>
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Pizza Price: ${<span class="variable">pizzaPrice</span>:F2}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Number of Pizzas: {<span class="variable">numberOfPizzas</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Toppings per Pizza: {<span class="variable">toppingsPerPizza</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"--------------------------------"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Base Cost: ${<span class="variable">baseCost</span>:F2}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Topping Cost: ${<span class="variable">toppingCost</span>:F2}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Subtotal: ${<span class="variable">subtotal</span>:F2}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Tax ({(<span class="variable">taxRate</span> * <span class="number">100</span>):F0}%): ${<span class="variable">taxAmount</span>:F2}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"--------------------------------"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Total: ${<span class="variable">total</span>:F2}"</span>);

        <span class="comment">// Bonus: Check if total is even</span>
        <span class="keyword">int</span> <span class="variable">totalCents</span> = (<span class="keyword">int</span>)(<span class="variable">total</span> * <span class="number">100</span>);
        <span class="keyword">bool</span> <span class="variable">isEven</span> = <span class="variable">totalCents</span> % <span class="number">2</span> == <span class="number">0</span>;
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Total is {(<span class="variable">isEven</span> ? "even" : "odd")} cents."</span>);
    }
}</code></pre>
