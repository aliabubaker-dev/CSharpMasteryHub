@page
@model CSharpMasteryHub.Pages.CSharpFundamentals.ArraysAndCollectionsModel
@{
    ViewData["Title"] = "Arrays and Collections";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/CSharpFundamentals">C# Fundamentals</a></li>
                    <li class="breadcrumb-item active">Arrays and Collections</li>
                </ol>
            </nav>

            <div class="lesson-content" data-aos="fade-up">
                <h1 class="display-4 mb-3">Arrays and Collections</h1>
                <div class="d-flex gap-3 mb-4 flex-wrap">
                    <span class="badge bg-warning text-dark p-2 px-3">Intermediate</span>
                    <span class="badge bg-info text-dark p-2 px-3"><i class="far fa-clock me-1"></i> 25 min read</span>
                    <span class="badge bg-primary p-2 px-3">Lesson 7 of 13</span>
                </div>

                <!-- ===== INTRODUCTION ===== -->
                <div class="card mb-4 border-primary" data-aos="fade-right">
                    <div class="card-body">
                        <h2 class="h4 fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>What are Collections?</h2>
                        <p>
                            <strong>Collections</strong> are containers that hold <strong>multiple items</strong> of data.
                            Think of them like a shopping cart - you can put many items in it, add new ones, remove ones you don't want,
                            and access any item you need.
                        </p>

                        <div class="row mt-3">
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded text-center">
                                    <i class="fas fa-arrow-right fa-2x text-primary"></i>
                                    <p class="small mt-1"><strong>Array</strong><br>Fixed size</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded text-center">
                                    <i class="fas fa-list-ul fa-2x text-success"></i>
                                    <p class="small mt-1"><strong>List</strong><br>Dynamic size</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded text-center">
                                    <i class="fas fa-key fa-2x text-warning"></i>
                                    <p class="small mt-1"><strong>Dictionary</strong><br>Key-Value pairs</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded text-center">
                                    <i class="fas fa-cubes fa-2x text-info"></i>
                                    <p class="small mt-1"><strong>Others</strong><br>Queue, Stack, HashSet</p>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Think of it like this:</strong> Imagine you have a box of chocolates.
                            An <strong>array</strong> is a box with a fixed number of slots. A <strong>list</strong>
                            is a box that can grow. A <strong>dictionary</strong> is like a labeled box where each
                            chocolate has a name tag.
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 1: ARRAYS ===== -->
                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h2 class="h4 fw-bold text-primary"><i class="fas fa-cubes me-2"></i>1. Arrays</h2>
                        <p>
                            An <strong>array</strong> is a fixed-size collection of items of the same type.
                            <strong>Once you create an array, its size cannot change.</strong>
                        </p>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-success bg-opacity-10 rounded">
                                    <h6 class="fw-bold text-success"><i class="fas fa-check-circle me-2"></i>When to use Arrays</h6>
                                    <ul class="small mb-0">
                                        <li>You know the exact number of items</li>
                                        <li>You need the fastest performance</li>
                                        <li>You're working with a fixed dataset</li>
                                        <li>You need to store items of the same type</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-danger bg-opacity-10 rounded">
                                    <h6 class="fw-bold text-danger"><i class="fas fa-times-circle me-2"></i>When NOT to use Arrays</h6>
                                    <ul class="small mb-0">
                                        <li>You don't know how many items</li>
                                        <li>You need to add/remove items</li>
                                        <li>You need to insert items in the middle</li>
                                        <li>You need a dynamic collection</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="code-block bg-dark p-3 rounded-3 mt-3">
                            <pre><code class="language-csharp"><span class="comment">// ===== DECLARING ARRAYS =====</span>

<span class="comment">// Method 1: Create with size (all elements are default values)</span>
<span class="keyword">int</span>[] <span class="variable">numbers</span> = <span class="keyword">new</span> <span class="keyword">int</span>[<span class="number">5</span>];  <span class="comment">// 5 slots: [0, 0, 0, 0, 0]</span>

<span class="comment">// Method 2: Create and initialize with values</span>
<span class="keyword">string</span>[] <span class="variable">names</span> = { <span class="string">"Alice"</span>, <span class="string">"Bob"</span>, <span class="string">"Charlie"</span> };  <span class="comment">// Size is 3</span>

<span class="comment">// Method 3: Create with size and assign values</span>
<span class="keyword">int</span>[] <span class="variable">scores</span> = <span class="keyword">new</span> <span class="keyword">int</span>[<span class="number">3</span>] { <span class="number">95</span>, <span class="number">88</span>, <span class="number">76</span> };

<span class="comment">// ===== ACCESSING ARRAY ELEMENTS =====</span>
<span class="keyword">string</span>[] <span class="variable">fruits</span> = { <span class="string">"Apple"</span>, <span class="string">"Banana"</span>, <span class="string">"Orange"</span> };

<span class="keyword">string</span> <span class="variable">first</span> = <span class="variable">fruits</span>[<span class="number">0</span>];  <span class="comment">// "Apple" (first element - index 0)</span>
<span class="keyword">string</span> <span class="variable">second</span> = <span class="variable">fruits</span>[<span class="number">1</span>]; <span class="comment">// "Banana" (second element - index 1)</span>
<span class="keyword">string</span> <span class="variable">last</span> = <span class="variable">fruits</span>[<span class="number">2</span>];   <span class="comment">// "Orange" (third element - index 2)</span>

<span class="comment">// Change a value</span>
<span class="variable">fruits</span>[<span class="number">1</span>] = <span class="string">"Grape"</span>;  <span class="comment">// Now: ["Apple", "Grape", "Orange"]</span>

<span class="comment">// ===== ARRAY PROPERTIES =====</span>
<span class="keyword">int</span> <span class="variable">length</span> = <span class="variable">fruits</span>.<span class="property">Length</span>;  <span class="comment">// Gets the number of elements (3)</span>

<span class="comment">// ===== LOOPING THROUGH AN ARRAY =====</span>
<span class="comment">// Using for loop (with index)</span>
<span class="keyword">for</span> (<span class="keyword">int</span> <span class="variable">i</span> = <span class="number">0</span>; <span class="variable">i</span> &lt; <span class="variable">fruits</span>.<span class="property">Length</span>; <span class="variable">i</span>++)
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Index {<span class="variable">i</span>}: {<span class="variable">fruits</span>[<span class="variable">i</span>]}"</span>);
}

<span class="comment">// Using foreach (cleaner, no index)</span>
<span class="keyword">foreach</span> (<span class="keyword">string</span> <span class="variable">fruit</span> <span class="keyword">in</span> <span class="variable">fruits</span>)
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Fruit: {<span class="variable">fruit</span>}"</span>);
}

<span class="comment">// ===== MULTIDIMENSIONAL ARRAYS =====</span>
<span class="comment">// 2D array (like a grid or table)</span>
<span class="keyword">int</span>[,] <span class="variable">grid</span> = <span class="keyword">new</span> <span class="keyword">int</span>[<span class="number">2</span>, <span class="number">3</span>];  <span class="comment">// 2 rows, 3 columns</span>
<span class="variable">grid</span>[<span class="number">0</span>, <span class="number">0</span>] = <span class="number">1</span>;
<span class="variable">grid</span>[<span class="number">0</span>, <span class="number">1</span>] = <span class="number">2</span>;
<span class="variable">grid</span>[<span class="number">0</span>, <span class="number">2</span>] = <span class="number">3</span>;
<span class="variable">grid</span>[<span class="number">1</span>, <span class="number">0</span>] = <span class="number">4</span>;
<span class="variable">grid</span>[<span class="number">1</span>, <span class="number">1</span>] = <span class="number">5</span>;
<span class="variable">grid</span>[<span class="number">1</span>, <span class="number">2</span>] = <span class="number">6</span>;
<span class="comment">// grid = [[1,2,3], [4,5,6]]</span>

<span class="comment">// Initialize 2D array with values</span>
<span class="keyword">int</span>[,] <span class="variable">grid2</span> = { { <span class="number">1</span>, <span class="number">2</span> }, { <span class="number">3</span>, <span class="number">4</span> } };</code></pre>
                        </div>

                        <div class="alert alert-warning mt-2">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Remember:</strong> Arrays are <strong>zero-indexed</strong>. The first element is at index 0,
                            not 1. Trying to access an index that doesn't exist will cause an error!
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 2: LISTS ===== -->
                <div class="card mb-4" data-aos="fade-right">
                    <div class="card-body">
                        <h2 class="h4 fw-bold text-success"><i class="fas fa-list-ul me-2"></i>2. Lists (List&lt;T&gt;)</h2>
                        <p>
                            A <strong>List</strong> is like an array that can <strong>grow and shrink</strong>.
                            It's the most commonly used collection in C# because it's flexible and easy to use.
                        </p>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-success bg-opacity-10 rounded">
                                    <h6 class="fw-bold text-success"><i class="fas fa-check-circle me-2"></i>When to use Lists</h6>
                                    <ul class="small mb-0">
                                        <li>You don't know how many items you'll have</li>
                                        <li>You need to add or remove items</li>
                                        <li>You need to insert items in the middle</li>
                                        <li>You need to search for items</li>
                                        <li>You need to sort items</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-primary bg-opacity-10 rounded">
                                    <h6 class="fw-bold text-primary"><i class="fas fa-lightbulb me-2"></i>Most Common Use</h6>
                                    <p class="small mb-0">
                                        <strong>Lists are used in 90% of cases</strong> when you need a collection
                                        of items. They are the go-to choice for most developers.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="code-block bg-dark p-3 rounded-3 mt-3">
                            <pre><code class="language-csharp"><span class="comment">// ===== CREATING A LIST =====</span>
<span class="keyword">using</span> <span class="class">System</span>.<span class="class">Collections</span>.<span class="class">Generic</span>;  <span class="comment">// Required for List</span>

<span class="comment">// Create an empty list of strings</span>
<span class="class">List</span>&lt;<span class="keyword">string</span>&gt; <span class="variable">names</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt;();

<span class="comment">// Create a list with initial items</span>
<span class="class">List</span>&lt;<span class="keyword">int</span>&gt; <span class="variable">numbers</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">int</span>&gt; { <span class="number">1</span>, <span class="number">2</span>, <span class="number">3</span>, <span class="number">4</span>, <span class="number">5</span> };

<span class="comment">// ===== ADDING ITEMS =====</span>
<span class="variable">names</span>.<span class="function">Add</span>(<span class="string">"Alice"</span>);     <span class="comment">// Adds "Alice" at the end</span>
<span class="variable">names</span>.<span class="function">Add</span>(<span class="string">"Bob"</span>);       <span class="comment">// Adds "Bob" at the end</span>
<span class="variable">names</span>.<span class="function">Add</span>(<span class="string">"Charlie"</span>);  <span class="comment">// Adds "Charlie" at the end</span>

<span class="comment">// ===== INSERTING ITEMS =====</span>
<span class="variable">names</span>.<span class="function">Insert</span>(<span class="number">1</span>, <span class="string">"Dave"</span>);  <span class="comment">// Inserts "Dave" at index 1</span>
<span class="comment">// Now: ["Alice", "Dave", "Bob", "Charlie"]</span>

<span class="comment">// ===== ACCESSING ITEMS =====</span>
<span class="keyword">string</span> <span class="variable">first</span> = <span class="variable">names</span>[<span class="number">0</span>];  <span class="comment">// "Alice"</span>
<span class="keyword">string</span> <span class="variable">last</span> = <span class="variable">names</span>[<span class="variable">names</span>.<span class="property">Count</span> - <span class="number">1</span>];  <span class="comment">// "Charlie"</span>

<span class="comment">// ===== REMOVING ITEMS =====</span>
<span class="variable">names</span>.<span class="function">Remove</span>(<span class="string">"Bob"</span>);       <span class="comment">// Removes "Bob" by value</span>
<span class="variable">names</span>.<span class="function">RemoveAt</span>(<span class="number">0</span>);      <span class="comment">// Removes the first item (index 0)</span>
<span class="variable">names</span>.<span class="function">Clear</span>();           <span class="comment">// Removes all items</span>

<span class="comment">// ===== LIST PROPERTIES =====</span>
<span class="keyword">int</span> <span class="variable">count</span> = <span class="variable">names</span>.<span class="property">Count</span>;   <span class="comment">// Number of items (like Length for arrays)</span>
<span class="keyword">bool</span> <span class="variable">isEmpty</span> = <span class="variable">names</span>.<span class="property">Count</span> == <span class="number">0</span>;

<span class="comment">// ===== CHECKING IF AN ITEM EXISTS =====</span>
<span class="keyword">bool</span> <span class="variable">hasAlice</span> = <span class="variable">names</span>.<span class="function">Contains</span>(<span class="string">"Alice"</span>);  <span class="comment">// true or false</span>

<span class="comment">// ===== FINDING ITEMS =====</span>
<span class="keyword">int</span> <span class="variable">index</span> = <span class="variable">names</span>.<span class="function">IndexOf</span>(<span class="string">"Alice"</span>);  <span class="comment">// Returns the index, or -1 if not found</span>

<span class="comment">// ===== SORTING =====</span>
<span class="variable">names</span>.<span class="function">Sort</span>();  <span class="comment">// Sorts the list alphabetically</span>

<span class="comment">// ===== LOOPING THROUGH A LIST =====</span>
<span class="comment">// Using foreach (cleanest)</span>
<span class="keyword">foreach</span> (<span class="keyword">string</span> <span class="variable">name</span> <span class="keyword">in</span> <span class="variable">names</span>)
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Hello, {<span class="variable">name</span>}"</span>);
}

<span class="comment">// Using for loop (when you need the index)</span>
<span class="keyword">for</span> (<span class="keyword">int</span> <span class="variable">i</span> = <span class="number">0</span>; <span class="variable">i</span> &lt; <span class="variable">names</span>.<span class="property">Count</span>; <span class="variable">i</span>++)
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Index {<span class="variable">i</span>}: {<span class="variable">names</span>[<span class="variable">i</span>]}"</span>);
}</code></pre>
                        </div>

                        <div class="alert alert-success mt-2">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Pro Tip:</strong> Use <strong>List&lt;T&gt;</strong> by default. Only use arrays when
                            you have a very specific reason (like fixed size or performance-critical code).
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 3: DICTIONARY ===== -->
                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h2 class="h4 fw-bold text-warning"><i class="fas fa-key me-2"></i>3. Dictionary&lt;TKey, TValue&gt;</h2>
                        <p>
                            A <strong>Dictionary</strong> stores items as <strong>key-value pairs</strong>.
                            Think of it like a real dictionary - you look up a word (the key) to find its definition (the value).
                        </p>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-warning bg-opacity-10 rounded">
                                    <h6 class="fw-bold text-warning"><i class="fas fa-check-circle me-2"></i>When to use Dictionary</h6>
                                    <ul class="small mb-0">
                                        <li>You need to look up items by a unique key</li>
                                        <li>You need fast lookups</li>
                                        <li>You have key-value data</li>
                                        <li>Example: Student ID → Student Name</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-danger bg-opacity-10 rounded">
                                    <h6 class="fw-bold text-danger"><i class="fas fa-times-circle me-2"></i>When NOT to use Dictionary</h6>
                                    <ul class="small mb-0">
                                        <li>You don't have unique keys</li>
                                        <li>You need to access items by position</li>
                                        <li>You have a small collection</li>
                                        <li>You need to preserve order</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="code-block bg-dark p-3 rounded-3 mt-3">
                            <pre><code class="language-csharp"><span class="comment">// ===== CREATING A DICTIONARY =====</span>
<span class="keyword">using</span> <span class="class">System</span>.<span class="class">Collections</span>.<span class="class">Generic</span>;  <span class="comment">// Required</span>

<span class="comment">// Create a dictionary with string keys and int values</span>
<span class="class">Dictionary</span>&lt;<span class="keyword">string</span>, <span class="keyword">int</span>&gt; <span class="variable">ages</span> = <span class="keyword">new</span> <span class="class">Dictionary</span>&lt;<span class="keyword">string</span>, <span class="keyword">int</span>&gt;();

<span class="comment">// Create a dictionary with initial values</span>
<span class="class">Dictionary</span>&lt;<span class="keyword">string</span>, <span class="keyword">string</span>&gt; <span class="variable">countries</span> = <span class="keyword">new</span> <span class="class">Dictionary</span>&lt;<span class="keyword">string</span>, <span class="keyword">string</span>&gt;
{
    { <span class="string">"USA"</span>, <span class="string">"Washington D.C."</span> },
    { <span class="string">"Canada"</span>, <span class="string">"Ottawa"</span> },
    { <span class="string">"UK"</span>, <span class="string">"London"</span> }
};

<span class="comment">// ===== ADDING ITEMS =====</span>
<span class="variable">ages</span>[<span class="string">"Alice"</span>] = <span class="number">25</span>;        <span class="comment">// Adds or updates</span>
<span class="variable">ages</span>[<span class="string">"Bob"</span>] = <span class="number">30</span>;          <span class="comment">// Adds or updates</span>
<span class="variable">ages</span>.<span class="function">Add</span>(<span class="string">"Charlie"</span>, <span class="number">35</span>);  <span class="comment">// Only adds (throws error if exists)</span>

<span class="comment">// ===== ACCESSING VALUES =====</span>
<span class="keyword">int</span> <span class="variable">age</span> = <span class="variable">ages</span>[<span class="string">"Alice"</span>];  <span class="comment">// 25</span>

<span class="comment">// ===== SAFE ACCESS (Check if key exists first) =====</span>
<span class="keyword">if</span> (<span class="variable">ages</span>.<span class="function">ContainsKey</span>(<span class="string">"Bob"</span>))
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Bob is {<span class="variable">ages</span>[<span class="string">"Bob"</span>]} years old"</span>);
}

<span class="comment">// ===== TRYGETVALUE (Best way to safely access) =====</span>
<span class="keyword">if</span> (<span class="variable">ages</span>.<span class="function">TryGetValue</span>(<span class="string">"Dave"</span>, <span class="keyword">out</span> <span class="keyword">int</span> <span class="variable">age2</span>))
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Dave is {<span class="variable">age2</span>} years old"</span>);
}
<span class="keyword">else</span>
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Dave not found"</span>);
}

<span class="comment">// ===== REMOVING ITEMS =====</span>
<span class="variable">ages</span>.<span class="function">Remove</span>(<span class="string">"Bob"</span>);        <span class="comment">// Removes Bob</span>
<span class="variable">ages</span>.<span class="function">Clear</span>();               <span class="comment">// Removes all items</span>

<span class="comment">// ===== DICTIONARY PROPERTIES =====</span>
<span class="keyword">int</span> <span class="variable">count2</span> = <span class="variable">ages</span>.<span class="property">Count</span>;      <span class="comment">// Number of key-value pairs</span>
<span class="class">List</span>&lt;<span class="keyword">string</span>&gt; <span class="variable">keys</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt;(<span class="variable">ages</span>.<span class="property">Keys</span>);  <span class="comment">// Get all keys</span>
<span class="class">List</span>&lt;<span class="keyword">int</span>&gt; <span class="variable">values</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">int</span>&gt;(<span class="variable">ages</span>.<span class="property">Values</span>);  <span class="comment">// Get all values</span>

<span class="comment">// ===== LOOPING THROUGH A DICTIONARY =====</span>
<span class="keyword">foreach</span> (<span class="class">KeyValuePair</span>&lt;<span class="keyword">string</span>, <span class="keyword">int</span>&gt; <span class="variable">item</span> <span class="keyword">in</span> <span class="variable">ages</span>)
{
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"{<span class="variable">item</span>.<span class="property">Key</span>} is {<span class="variable">item</span>.<span class="property">Value</span>} years old"</span>);
}</code></pre>
                        </div>

                        <div class="alert alert-warning mt-2">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Important:</strong> Keys must be <strong>unique</strong>. If you try to add a key that
                            already exists, the program will throw an error.
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 4: OTHER COLLECTIONS ===== -->
                <div class="card mb-4" data-aos="fade-right">
                    <div class="card-body">
                        <h2 class="h4 fw-bold text-info"><i class="fas fa-cog me-2"></i>4. Other Collections</h2>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="p-3 border border-primary rounded">
                                    <h6 class="fw-bold text-primary"><i class="fas fa-hashtag me-2"></i>HashSet&lt;T&gt;</h6>
                                    <p class="small mb-0">Stores <strong>unique</strong> items. Duplicates are automatically ignored.</p>
                                    <code class="small">HashSet&lt;string&gt; unique = new HashSet&lt;string&gt;();</code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-success rounded">
                                    <h6 class="fw-bold text-success"><i class="fas fa-arrow-right me-2"></i>Queue&lt;T&gt;</h6>
                                    <p class="small mb-0"><strong>FIFO</strong> - First In, First Out. Like a line at a store.</p>
                                    <code class="small">Queue&lt;string&gt; queue = new Queue&lt;string&gt;();</code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-warning rounded">
                                    <h6 class="fw-bold text-warning"><i class="fas fa-arrow-left me-2"></i>Stack&lt;T&gt;</h6>
                                    <p class="small mb-0"><strong>LIFO</strong> - Last In, First Out. Like a stack of plates.</p>
                                    <code class="small">Stack&lt;string&gt; stack = new Stack&lt;string&gt;();</code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-info rounded">
                                    <h6 class="fw-bold text-info"><i class="fas fa-list me-2"></i>LinkedList&lt;T&gt;</h6>
                                    <p class="small mb-0">Each item points to the next. Fast insert/delete in the middle.</p>
                                    <code class="small">LinkedList&lt;string&gt; list = new LinkedList&lt;string&gt;();</code>
                                </div>
                            </div>
                        </div>

                        <div class="code-block bg-dark p-3 rounded-3 mt-3">
                            <pre><code class="language-csharp"><span class="comment">// ===== HASHSET - Unique Items Only =====</span>
<span class="class">HashSet</span>&lt;<span class="keyword">string</span>&gt; <span class="variable">uniqueNames</span> = <span class="keyword">new</span> <span class="class">HashSet</span>&lt;<span class="keyword">string</span>&gt;();
<span class="variable">uniqueNames</span>.<span class="function">Add</span>(<span class="string">"Alice"</span>);
<span class="variable">uniqueNames</span>.<span class="function">Add</span>(<span class="string">"Bob"</span>);
<span class="variable">uniqueNames</span>.<span class="function">Add</span>(<span class="string">"Alice"</span>);  <span class="comment">// Ignored - duplicate</span>
<span class="comment">// uniqueNames = ["Alice", "Bob"]</span>

<span class="comment">// ===== QUEUE - FIFO (First In, First Out) =====</span>
<span class="class">Queue</span>&lt;<span class="keyword">string</span>&gt; <span class="variable">queue</span> = <span class="keyword">new</span> <span class="class">Queue</span>&lt;<span class="keyword">string</span>&gt;();
<span class="variable">queue</span>.<span class="function">Enqueue</span>(<span class="string">"First"</span>);   <span class="comment">// Add to the end</span>
<span class="variable">queue</span>.<span class="function">Enqueue</span>(<span class="string">"Second"</span>);  <span class="comment">// Add to the end</span>
<span class="variable">queue</span>.<span class="function">Enqueue</span>(<span class="string">"Third"</span>);   <span class="comment">// Add to the end</span>

<span class="keyword">string</span> <span class="variable">firstItem</span> = <span class="variable">queue</span>.<span class="function">Dequeue</span>();  <span class="comment">// "First" (removes first)</span>
<span class="keyword">string</span> <span class="variable">nextItem</span> = <span class="variable">queue</span>.<span class="function">Dequeue</span>();   <span class="comment">// "Second"</span>
<span class="comment">// queue now has: ["Third"]</span>

<span class="comment">// Peek - look at the first item without removing</span>
<span class="keyword">string</span> <span class="variable">first</span> = <span class="variable">queue</span>.<span class="function">Peek</span>();  <span class="comment">// "Third" (doesn't remove)</span>

<span class="comment">// ===== STACK - LIFO (Last In, First Out) =====</span>
<span class="class">Stack</span>&lt;<span class="keyword">string</span>&gt; <span class="variable">stack</span> = <span class="keyword">new</span> <span class="class">Stack</span>&lt;<span class="keyword">string</span>&gt;();
<span class="variable">stack</span>.<span class="function">Push</span>(<span class="string">"First"</span>);   <span class="comment">// Add to the top</span>
<span class="variable">stack</span>.<span class="function">Push</span>(<span class="string">"Second"</span>);  <span class="comment">// Add to the top</span>
<span class="variable">stack</span>.<span class="function">Push</span>(<span class="string">"Third"</span>);   <span class="comment">// Add to the top</span>

<span class="keyword">string</span> <span class="variable">lastItem</span> = <span class="variable">stack</span>.<span class="function">Pop</span>();  <span class="comment">// "Third" (removes from top)</span>
<span class="keyword">string</span> <span class="variable">previous</span> = <span class="variable">stack</span>.<span class="function">Pop</span>();  <span class="comment">// "Second"</span>
<span class="comment">// stack now has: ["First"]</span>

<span class="comment">// Peek - look at the top item without removing</span>
<span class="keyword">string</span> <span class="variable">top</span> = <span class="variable">stack</span>.<span class="function">Peek</span>();  <span class="comment">// "First" (doesn't remove)</span>

<span class="comment">// ===== LINKEDLIST - Fast insert/delete in the middle =====</span>
<span class="class">LinkedList</span>&lt;<span class="keyword">string</span>&gt; <span class="variable">linkedList</span> = <span class="keyword">new</span> <span class="class">LinkedList</span>&lt;<span class="keyword">string</span>&gt;();
<span class="variable">linkedList</span>.<span class="function">AddLast</span>(<span class="string">"First"</span>);
<span class="variable">linkedList</span>.<span class="function">AddLast</span>(<span class="string">"Second"</span>);
<span class="variable">linkedList</span>.<span class="function">AddFirst</span>(<span class="string">"Zero"</span>);  <span class="comment">// Adds at the beginning</span>
<span class="comment">// linkedList = ["Zero", "First", "Second"]</span></code></pre>
                        </div>

                        <div class="alert alert-info mt-2">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Quick Summary:</strong>
                            <ul class="mb-0">
                                <li><strong>Queue</strong> → Line of people (first come, first served)</li>
                                <li><strong>Stack</strong> → Stack of plates (last one on top comes off first)</li>
                                <li><strong>HashSet</strong> → Unique items only (no duplicates)</li>
                                <li><strong>LinkedList</strong> → Fast insert/delete in the middle</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- ===== COMPARISON TABLE ===== -->
                <div class="card mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <h2 class="h4 fw-bold"><i class="fas fa-table text-info me-2"></i>Which Collection to Use?</h2>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Collection</th>
                                        <th>Use When</th>
