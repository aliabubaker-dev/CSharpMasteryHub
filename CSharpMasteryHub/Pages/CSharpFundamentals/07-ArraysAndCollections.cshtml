                        <button class="btn btn-outline-success btn-sm mt-2" onclick="toggleExercise()">
                            <i class="fas fa-code me-1"></i> Show Solution
                        </button>

                        <div id="exerciseSolution" style="display: none;" class="mt-3">
                            <div class="code-block bg-dark p-3 rounded-3">
                                <pre><code class="language-csharp"><span class="comment">// Student Management System</span>
<span class="keyword">using</span> <span class="class">System</span>;
<span class="keyword">using</span> <span class="class">System</span>.<span class="class">Collections</span>.<span class="class">Generic</span>;
<span class="keyword">using</span> <span class="class">System</span>.<span class="class">Linq</span>;

<span class="keyword">class</span> <span class="class">Program</span>
{
    <span class="keyword">static</span> <span class="class">List</span>&lt;<span class="class">Student</span>&gt; <span class="variable">students</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="class">Student</span>&gt;();
    <span class="keyword">static</span> <span class="class">Dictionary</span>&lt;<span class="keyword">int</span>, <span class="class">Student</span>&gt; <span class="variable">studentDict</span> = <span class="keyword">new</span> <span class="class">Dictionary</span>&lt;<span class="keyword">int</span>, <span class="class">Student</span>&gt;();

    <span class="keyword">static void</span> <span class="function">Main</span>()
    {
        <span class="keyword">bool</span> <span class="variable">running</span> = <span class="keyword">true</span>;

        <span class="keyword">while</span> (<span class="variable">running</span>)
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n--- Student Management System ---"</span>);
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"1. Add Student"</span>);
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"2. Find Student"</span>);
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"3. Display All Students"</span>);
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"4. Show Statistics"</span>);
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"5. Exit"</span>);
            <span class="function">Console</span>.<span class="function">Write</span>(<span class="string">"Choose an option: "</span>);
            <span class="keyword">string</span> <span class="variable">choice</span> = <span class="function">Console</span>.<span class="function">ReadLine</span>();

            <span class="keyword">switch</span> (<span class="variable">choice</span>)
            {
                <span class="keyword">case</span> <span class="string">"1"</span>:
                    <span class="function">AddStudent</span>();
                    <span class="keyword">break</span>;
                <span class="keyword">case</span> <span class="string">"2"</span>:
                    <span class="function">FindStudent</span>();
                    <span class="keyword">break</span>;
                <span class="keyword">case</span> <span class="string">"3"</span>:
                    <span class="function">DisplayAllStudents</span>();
                    <span class="keyword">break</span>;
                <span class="keyword">case</span> <span class="string">"4"</span>:
                    <span class="function">ShowStatistics</span>();
                    <span class="keyword">break</span>;
                <span class="keyword">case</span> <span class="string">"5"</span>:
                    <span class="variable">running</span> = <span class="keyword">false</span>;
                    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Goodbye!"</span>);
                    <span class="keyword">break</span>;
                <span class="keyword">default</span>:
                    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Invalid choice!"</span>);
                    <span class="keyword">break</span>;
            }
        }
    }

    <span class="keyword">static void</span> <span class="function">AddStudent</span>()
    {
        <span class="function">Console</span>.<span class="function">Write</span>(<span class="string">"Enter student ID: "</span>);
        <span class="keyword">int</span> <span class="variable">id</span> = <span class="keyword">int</span>.<span class="function">Parse</span>(<span class="function">Console</span>.<span class="function">ReadLine</span>());

        <span class="comment">// Check if ID already exists</span>
        <span class="keyword">if</span> (<span class="variable">studentDict</span>.<span class="function">ContainsKey</span>(<span class="variable">id</span>))
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Student ID already exists!"</span>);
            <span class="keyword">return</span>;
        }

        <span class="function">Console</span>.<span class="function">Write</span>(<span class="string">"Enter student name: "</span>);
        <span class="keyword">string</span> <span class="variable">name</span> = <span class="function">Console</span>.<span class="function">ReadLine</span>();
        <span class="function">Console</span>.<span class="function">Write</span>(<span class="string">"Enter student grade: "</span>);
        <span class="keyword">double</span> <span class="variable">grade</span> = <span class="keyword">double</span>.<span class="function">Parse</span>(<span class="function">Console</span>.<span class="function">ReadLine</span>());

        <span class="class">Student</span> <span class="variable">student</span> = <span class="keyword">new</span> <span class="class">Student</span>
        {
            <span class="property">ID</span> = <span class="variable">id</span>,
            <span class="property">Name</span> = <span class="variable">name</span>,
            <span class="property">Grade</span> = <span class="variable">grade</span>
        };

        <span class="variable">students</span>.<span class="function">Add</span>(<span class="variable">student</span>);
        <span class="variable">studentDict</span>[<span class="variable">id</span>] = <span class="variable">student</span>;

        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Student added successfully!"</span>);
    }

    <span class="keyword">static void</span> <span class="function">FindStudent</span>()
    {
        <span class="function">Console</span>.<span class="function">Write</span>(<span class="string">"Enter student ID: "</span>);
        <span class="keyword">int</span> <span class="variable">id</span> = <span class="keyword">int</span>.<span class="function">Parse</span>(<span class="function">Console</span>.<span class="function">ReadLine</span>());

        <span class="keyword">if</span> (<span class="variable">studentDict</span>.<span class="function">TryGetValue</span>(<span class="variable">id</span>, <span class="keyword">out</span> <span class="class">Student</span> <span class="variable">student</span>))
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"ID: {<span class="variable">student</span>.<span class="property">ID</span>}, Name: {<span class="variable">student</span>.<span class="property">Name</span>}, Grade: {<span class="variable">student</span>.<span class="property">Grade</span>}"</span>);
        }
        <span class="keyword">else</span>
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Student not found!"</span>);
        }
    }

    <span class="keyword">static void</span> <span class="function">DisplayAllStudents</span>()
    {
        <span class="keyword">if</span> (<span class="variable">students</span>.<span class="property">Count</span> == <span class="number">0</span>)
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"No students found!"</span>);
            <span class="keyword">return</span>;
        }

        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n--- All Students ---"</span>);
        <span class="keyword">foreach</span> (<span class="class">Student</span> <span class="variable">student</span> <span class="keyword">in</span> <span class="variable">students</span>)
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"ID: {<span class="variable">student</span>.<span class="property">ID</span>}, Name: {<span class="variable">student</span>.<span class="property">Name</span>}, Grade: {<span class="variable">student</span>.<span class="property">Grade</span>}"</span>);
        }
    }

    <span class="keyword">static void</span> <span class="function">ShowStatistics</span>()
    {
        <span class="keyword">if</span> (<span class="variable">students</span>.<span class="property">Count</span> == <span class="number">0</span>)
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"No students to analyze!"</span>);
            <span class="keyword">return</span>;
        }

        <span class="keyword">double</span> <span class="variable">average</span> = <span class="variable">students</span>.<span class="function">Average</span>(<span class="variable">s</span> => <span class="variable">s</span>.<span class="property">Grade</span>);
        <span class="keyword">double</span> <span class="variable">highest</span> = <span class="variable">students</span>.<span class="function">Max</span>(<span class="variable">s</span> => <span class="variable">s</span>.<span class="property">Grade</span>);
        <span class="keyword">double</span> <span class="variable">lowest</span> = <span class="variable">students</span>.<span class="function">Min</span>(<span class="variable">s</span> => <span class="variable">s</span>.<span class="property">Grade</span>);
        <span class="class">Student</span> <span class="variable">topStudent</span> = <span class="variable">students</span>.<span class="function">First</span>(<span class="variable">s</span> => <span class="variable">s</span>.<span class="property">Grade</span> == <span class="variable">highest</span>);
        <span class="class">Student</span> <span class="variable">bottomStudent</span> = <span class="variable">students</span>.<span class="function">First</span>(<span class="variable">s</span> => <span class="variable">s</span>.<span class="property">Grade</span> == <span class="variable">lowest</span>);

        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n--- Statistics ---"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Total Students: {<span class="variable">students</span>.<span class="property">Count</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Average Grade: {<span class="variable">average</span>:F2}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Highest Grade: {<span class="variable">highest</span>} (Student: {<span class="variable">topStudent</span>.<span class="property">Name</span>})"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Lowest Grade: {<span class="variable">lowest</span>} (Student: {<span class="variable">bottomStudent</span>.<span class="property">Name</span>})"</span>);
