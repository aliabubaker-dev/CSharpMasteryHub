                </div>

                <!-- ===== EXERCISE ===== -->
                <div class="card mb-4 border-success" data-aos="fade-up">
                    <div class="card-body">
                        <h2 class="h4 fw-bold text-success"><i class="fas fa-pencil-alt me-2"></i>Exercise: Text Analyzer</h2>

                        <p class="fw-bold">Task: Create a program that analyzes text using string methods.</p>

                        <div class="bg-light p-3 rounded-3 mb-3">
                            <h6 class="fw-bold">Instructions:</h6>
                            <ol>
                                <li>Create a console application called "TextAnalyzer"</li>
                                <li>Ask the user to enter a sentence</li>
                                <li>Analyze the text and display:
                                    <ul>
                                        <li>Total number of characters</li>
                                        <li>Total number of words</li>
                                        <li>Total number of vowels</li>
                                        <li>Text in uppercase</li>
                                        <li>Text in lowercase</li>
                                        <li>The first 10 characters</li>
                                        <li>Whether the text contains the word "C#"</li>
                                    </ul>
                                </li>
                                <li>Use <strong>at least 6 different string methods</strong></li>
                                <li>Use <strong>string interpolation</strong> for all output</li>
                            </ol>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Hints:</strong>
                            <ul class="mb-0">
                                <li>Use <code>Console.ReadLine()</code> to get user input</li>
                                <li>Use <code>Split()</code> to count words</li>
                                <li>Use <code>ToLower()</code> and <code>Count()</code> to count vowels</li>
                                <li>Use <code>Substring()</code> to get first 10 characters</li>
                                <li>Use <code>Contains()</code> to check for "C#"</li>
                            </ul>
                        </div>

                        <div class="alert alert-warning mt-2">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Expected Output:</strong>
                            <pre class="mt-2 mb-0 bg-dark text-light p-2 rounded">Enter a sentence: I love learning C# programming!
--- Text Analysis ---
Characters: 31
Words: 5
Vowels: 9
Uppercase: I LOVE LEARNING C# PROGRAMMING!
Lowercase: i love learning c# programming!
First 10 chars: I love lea
Contains "C#": True</pre>
                        </div>

                        <button class="btn btn-outline-success btn-sm mt-2" onclick="toggleExercise()">
                            <i class="fas fa-code me-1"></i> Show Solution
                        </button>

                        <div id="exerciseSolution" style="display: none;" class="mt-3">
                            <div class="code-block bg-dark p-3 rounded-3">
                                <pre><code class="language-csharp"><span class="comment">// Text Analyzer</span>
<span class="keyword">using</span> <span class="class">System</span>;
<span class="keyword">using</span> <span class="class">System</span>.<span class="class">Linq</span>;

<span class="keyword">class</span> <span class="class">Program</span>
{
    <span class="keyword">static void</span> <span class="function">Main</span>()
    {
        <span class="comment">// Get user input</span>
        <span class="function">Console</span>.<span class="function">Write</span>(<span class="string">"Enter a sentence: "</span>);
        <span class="keyword">string</span> <span class="variable">text</span> = <span class="function">Console</span>.<span class="function">ReadLine</span>();

        <span class="comment">// 1. Total characters</span>
        <span class="keyword">int</span> <span class="variable">charCount</span> = <span class="variable">text</span>.<span class="property">Length</span>;

        <span class="comment">// 2. Total words</span>
        <span class="keyword">string</span>[] <span class="variable">words</span> = <span class="variable">text</span>.<span class="function">Split</span>(<span class="string">' '</span>, <span class="class">StringSplitOptions</span>.<span class="property">RemoveEmptyEntries</span>);
        <span class="keyword">int</span> <span class="variable">wordCount</span> = <span class="variable">words</span>.<span class="property">Length</span>;

        <span class="comment">// 3. Total vowels</span>
        <span class="keyword">string</span> <span class="variable">lowerText</span> = <span class="variable">text</span>.<span class="function">ToLower</span>();
        <span class="keyword">int</span> <span class="variable">vowelCount</span> = <span class="variable">lowerText</span>.<span class="function">Count</span>(<span class="variable">c</span> => <span class="string">"aeiou"</span>.<span class="function">Contains</span>(<span class="variable">c</span>));

        <span class="comment">// 4. Uppercase</span>
        <span class="keyword">string</span> <span class="variable">upper</span> = <span class="variable">text</span>.<span class="function">ToUpper</span>();

        <span class="comment">// 5. Lowercase</span>
        <span class="keyword">string</span> <span class="variable">lower</span> = <span class="variable">text</span>.<span class="function">ToLower</span>();

        <span class="comment">// 6. First 10 characters</span>
        <span class="keyword">string</span> <span class="variable">first10</span> = <span class="variable">text</span>.<span class="property">Length</span> > <span class="number">10</span> 
            ? <span class="variable">text</span>.<span class="function">Substring</span>(<span class="number">0</span>, <span class="number">10</span>) 
            : <span class="variable">text</span>;

        <span class="comment">// 7. Contains "C#"</span>
        <span class="keyword">bool</span> <span class="variable">containsCSharp</span> = <span class="variable">text</span>.<span class="function">Contains</span>(<span class="string">"C#"</span>);

        <span class="comment">// Display results</span>
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n--- Text Analysis ---"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Characters: {<span class="variable">charCount</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Words: {<span class="variable">wordCount</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Vowels: {<span class="variable">vowelCount</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Uppercase: {<span class="variable">upper</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Lowercase: {<span class="variable">lower</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"First 10 chars: {<span class="variable">first10</span>}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Contains \"C#\": {<span class="variable">containsCSharp</span>}"</span>);
    }
}</code></pre>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== KEY TAKEAWAY ===== -->
                <div class="card bg-info bg-opacity-10 mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>
                            Strings are everywhere in C#. Remember these key points:
                            <br><br>
                            ✅ Strings are <strong>immutable</strong> - every change creates a new string<br>
                            ✅ Use <strong>string interpolation</strong> (<code>$"..."</code>) for clean formatting<br>
                            ✅ Use <strong>StringBuilder</strong> when modifying strings many times<br>
                            ✅ Master the common methods: <code>Length</code>, <code>Substring</code>, <code>Split</code>, 
                            <code>Replace</code>, <code>Contains</code>, <code>Trim</code><br>
                            ✅ Always check for <strong>null</strong> or <strong>empty</strong> strings before using them
                        </p>
                    </div>
                </div>

