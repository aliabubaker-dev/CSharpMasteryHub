                <!-- ===== EXERCISE ===== -->
                <div class="card mb-4 border-success" data-aos="fade-up">
                    <div class="card-body">
                        <h2 class="h4 fw-bold text-success"><i class="fas fa-pencil-alt me-2"></i>Exercise: Shopping Cart</h2>

                        <p class="fw-bold">Task: Create a shopping cart system with methods.</p>

                        <div class="bg-light p-3 rounded-3 mb-3">
                            <h6 class="fw-bold">Instructions:</h6>
                            <ol>
                                <li>Create a <strong>Product</strong> class with: Name, Price, Quantity</li>
                                <li>
                                    Create a <strong>ShoppingCart</strong> class with:
                                    <ul>
                                        <li><code>AddItem()</code> - Add a product</li>
                                        <li><code>RemoveItem()</code> - Remove a product</li>
                                        <li><code>GetTotal()</code> - Calculate total price</li>
                                        <li><code>ApplyDiscount()</code> - Apply a discount percentage</li>
                                        <li><code>GetItemCount()</code> - Get total number of items</li>
                                        <li><code>ClearCart()</code> - Remove all items</li>
                                    </ul>
                                </li>
                                <li>Use <strong>overloading</strong> for adding items (single item and multiple items)</li>
                                <li>Use <strong>optional parameters</strong> for discount</li>
                                <li>Return <strong>bool</strong> for success/failure operations</li>
                            </ol>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Hints:</strong>
                            <ul class="mb-0">
                                <li>Use a <code>List&lt;Product&gt;</code> to store items</li>
                                <li>Use <code>foreach</code> to calculate totals</li>
                                <li>Use <code>return true/false</code> for Add/Remove methods</li>
                            </ul>
                        </div>

                        <button class="btn btn-outline-success btn-sm mt-2" onclick="toggleExercise()">
                            <i class="fas fa-code me-1"></i> Show Solution
                        </button>

                        <div id="exerciseSolution" style="display: none;" class="mt-3">
                            <div class="code-block bg-dark p-3 rounded-3">
                                <pre><code class="language-csharp"><span class="comment">// ===== Product Class =====</span>
<span class="keyword">public class</span> <span class="class">Product</span>
{
    <span class="keyword">public string</span> <span class="property">Name</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }
    <span class="keyword">public decimal</span> <span class="property">Price</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }
    <span class="keyword">public int</span> <span class="property">Quantity</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }

    <span class="keyword">public</span> <span class="function">Product</span>(<span class="keyword">string</span> <span class="variable">name</span>, <span class="keyword">decimal</span> <span class="variable">price</span>, <span class="keyword">int</span> <span class="variable">quantity</span> = <span class="number">1</span>)
    {
        <span class="property">Name</span> = <span class="variable">name</span>;
        <span class="property">Price</span> = <span class="variable">price</span>;
        <span class="property">Quantity</span> = <span class="variable">quantity</span>;
    }
}

<span class="comment">// ===== ShoppingCart Class =====</span>
<span class="keyword">public class</span> <span class="class">ShoppingCart</span>
{
    <span class="keyword">private</span> <span class="class">List</span>&lt;<span class="class">Product</span>&gt; <span class="variable">_items</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="class">Product</span>&gt;();

    <span class="comment">// Add a single item</span>
    <span class="keyword">public bool</span> <span class="function">AddItem</span>(<span class="class">Product</span> <span class="variable">product</span>)
    {
        <span class="keyword">if</span> (<span class="variable">product</span> == <span class="keyword">null</span> || <span class="variable">product</span>.<span class="property">Quantity</span> <= <span class="number">0</span>)
            <span class="keyword">return</span> <span class="keyword">false</span>;

        <span class="comment">// Check if product already exists</span>
        <span class="keyword">var</span> <span class="variable">existing</span> = <span class="variable">_items</span>.<span class="function">Find</span>(<span class="variable">p</span> => <span class="variable">p</span>.<span class="property">Name</span> == <span class="variable">product</span>.<span class="property">Name</span>);
        <span class="keyword">if</span> (<span class="variable">existing</span> != <span class="keyword">null</span>)
        {
            <span class="variable">existing</span>.<span class="property">Quantity</span> += <span class="variable">product</span>.<span class="property">Quantity</span>;
        }
        <span class="keyword">else</span>
        {
            <span class="variable">_items</span>.<span class="function">Add</span>(<span class="variable">product</span>);
        }
        <span class="keyword">return</span> <span class="keyword">true</span>;
    }

    <span class="comment">// Overload: Add multiple items</span>
    <span class="keyword">public bool</span> <span class="function">AddItem</span>(<span class="class">List</span>&lt;<span class="class">Product</span>&gt; <span class="variable">products</span>)
    {
        <span class="keyword">if</span> (<span class="variable">products</span> == <span class="keyword">null</span> || <span class="variable">products</span>.<span class="property">Count</span> == <span class="number">0</span>)
            <span class="keyword">return</span> <span class="keyword">false</span>;

        <span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">product</span> <span class="keyword">in</span> <span class="variable">products</span>)
        {
            <span class="function">AddItem</span>(<span class="variable">product</span>);
        }
        <span class="keyword">return</span> <span class="keyword">true</span>;
    }

    <span class="comment">// Remove an item</span>
    <span class="keyword">public bool</span> <span class="function">RemoveItem</span>(<span class="keyword">string</span> <span class="variable">name</span>)
    {
        <span class="keyword">var</span> <span class="variable">item</span> = <span class="variable">_items</span>.<span class="function">Find</span>(<span class="variable">p</span> => <span class="variable">p</span>.<span class="property">Name</span> == <span class="variable">name</span>);
        <span class="keyword">if</span> (<span class="variable">item</span> == <span class="keyword">null</span>) <span class="keyword">return</span> <span class="keyword">false</span>;

        <span class="variable">_items</span>.<span class="function">Remove</span>(<span class="variable">item</span>);
        <span class="keyword">return</span> <span class="keyword">true</span>;
    }

    <span class="comment">// Get total price</span>
    <span class="keyword">public decimal</span> <span class="function">GetTotal</span>()
    {
        <span class="keyword">decimal</span> <span class="variable">total</span> = <span class="number">0</span>;
        <span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">item</span> <span class="keyword">in</span> <span class="variable">_items</span>)
        {
            <span class="variable">total</span> += <span class="variable">item</span>.<span class="property">Price</span> * <span class="variable">item</span>.<span class="property">Quantity</span>;
        }
        <span class="keyword">return</span> <span class="variable">total</span>;
    }

    <span class="comment">// Apply discount (optional parameter)</span>
    <span class="keyword">public decimal</span> <span class="function">ApplyDiscount</span>(<span class="keyword">int</span> <span class="variable">percentage</span> = <span class="number">10</span>)
    {
        <span class="keyword">decimal</span> <span class="variable">total</span> = <span class="function">GetTotal</span>();
        <span class="keyword">return</span> <span class="variable">total</span> - (<span class="variable">total</span> * <span class="variable">percentage</span> / <span class="number">100</span>);
    }

    <span class="comment">// Get total item count</span>
    <span class="keyword">public int</span> <span class="function">GetItemCount</span>()
    {
        <span class="keyword">int</span> <span class="variable">count</span> = <span class="number">0</span>;
        <span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">item</span> <span class="keyword">in</span> <span class="variable">_items</span>)
        {
            <span class="variable">count</span> += <span class="variable">item</span>.<span class="property">Quantity</span>;
        }
        <span class="keyword">return</span> <span class="variable">count</span>;
    }

    <span class="comment">// Clear cart</span>
    <span class="keyword">public void</span> <span class="function">ClearCart</span>()
    {
        <span class="variable">_items</span>.<span class="function">Clear</span>();
    }

    <span class="comment">// Display cart items</span>
    <span class="keyword">public void</span> <span class="function">DisplayCart</span>()
    {
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n--- Shopping Cart ---"</span>);
        <span class="keyword">if</span> (<span class="variable">_items</span>.<span class="property">Count</span> == <span class="number">0</span>)
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"Cart is empty"</span>);
            <span class="keyword">return</span>;
        }

        <span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">item</span> <span class="keyword">in</span> <span class="variable">_items</span>)
        {
            <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"{<span class="variable">item</span>.<span class="property">Name</span>} x{<span class="variable">item</span>.<span class="property">Quantity</span>} = ${<span class="variable">item</span>.<span class="property">Price</span> * <span class="variable">item</span>.<span class="property">Quantity</span>}"</span>);
        }
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Total: ${<span class="function">GetTotal</span>()}"</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Items: {<span class="function">GetItemCount</span>()}"</span>);
    }
}

<span class="comment">// ===== USAGE EXAMPLE =====</span>
<span class="keyword">class</span> <span class="class">Program</span>
{
    <span class="keyword">static void</span> <span class="function">Main</span>()
    {
        <span class="keyword">var</span> <span class="variable">cart</span> = <span class="keyword">new</span> <span class="class">ShoppingCart</span>();

        <span class="comment">// Add items</span>
        <span class="variable">cart</span>.<span class="function">AddItem</span>(<span class="keyword">new</span> <span class="class">Product</span>(<span class="string">"Laptop"</span>, <span class="number">999.99</span><span class="keyword">m</span>));
        <span class="variable">cart</span>.<span class="function">AddItem</span>(<span class="keyword">new</span> <span class="class">Product</span>(<span class="string">"Mouse"</span>, <span class="number">29.99</span><span class="keyword">m</span>, <span class="number">2</span>));
        <span class="variable">cart</span>.<span class="function">AddItem</span>(<span class="keyword">new</span> <span class="class">Product</span>(<span class="string">"Keyboard"</span>, <span class="number">79.99</span><span class="keyword">m</span>));

        <span class="comment">// Display</span>
        <span class="variable">cart</span>.<span class="function">DisplayCart</span>();

        <span class="comment">// Apply discount</span>
        <span class="keyword">decimal</span> <span class="variable">discountedTotal</span> = <span class="variable">cart</span>.<span class="function">ApplyDiscount</span>(<span class="number">15</span>);
        <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"Discounted Total (15%): ${<span class="variable">discountedTotal</span>}"</span>);

        <span class="comment">// Remove an item</span>
        <span class="variable">cart</span>.<span class="function">RemoveItem</span>(<span class="string">"Mouse"</span>);
        <span class="variable">cart</span>.<span class="function">DisplayCart</span>();
    }
}</code></pre>
                            </div>
