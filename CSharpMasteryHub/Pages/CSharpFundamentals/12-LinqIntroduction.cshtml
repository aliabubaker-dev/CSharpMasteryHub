                            <ul class="mb-0">
                                <li>Use <code>Where()</code> for filtering</li>
                                <li>Use <code>GroupBy()</code> for department grouping</li>
                                <li>Use <code>OrderByDescending()</code> for sorting</li>
                                <li>Use <code>Take()</code> for top 3</li>
                                <li>Use <code>Sum()</code> and <code>Average()</code> for calculations</li>
                            </ul>
                        </div>

                        <button class="btn btn-outline-success btn-sm mt-2" onclick="toggleExercise()">
                            <i class="fas fa-code me-1"></i> Show Solution
                        </button>

                        <div id="exerciseSolution" style="display: none;" class="mt-3">
                            <div class="code-block bg-dark p-3 rounded-3">
                                <pre><code class="language-csharp"><span class="comment">// ===== Employee Class =====</span>
<span class="keyword">public class</span> <span class="class">Employee</span>
{
    <span class="keyword">public string</span> <span class="property">Name</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }
    <span class="keyword">public string</span> <span class="property">Department</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }
    <span class="keyword">public decimal</span> <span class="property">Salary</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }
    <span class="keyword">public int</span> <span class="property">YearsOfExperience</span> { <span class="keyword">get</span>; <span class="keyword">set</span>; }
}

<span class="comment">// ===== Sample Data =====</span>
<span class="keyword">var</span> <span class="variable">employees</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="class">Employee</span>&gt;
{
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"John"</span>, <span class="property">Department</span> = <span class="string">"IT"</span>, <span class="property">Salary</span> = <span class="number">75000</span>, <span class="property">YearsOfExperience</span> = <span class="number">5</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Jane"</span>, <span class="property">Department</span> = <span class="string">"HR"</span>, <span class="property">Salary</span> = <span class="number">65000</span>, <span class="property">YearsOfExperience</span> = <span class="number">8</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Bob"</span>, <span class="property">Department</span> = <span class="string">"IT"</span>, <span class="property">Salary</span> = <span class="number">90000</span>, <span class="property">YearsOfExperience</span> = <span class="number">12</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Alice"</span>, <span class="property">Department</span> = <span class="string">"Sales"</span>, <span class="property">Salary</span> = <span class="number">82000</span>, <span class="property">YearsOfExperience</span> = <span class="number">6</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Charlie"</span>, <span class="property">Department</span> = <span class="string">"HR"</span>, <span class="property">Salary</span> = <span class="number">58000</span>, <span class="property">YearsOfExperience</span> = <span class="number">3</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Diana"</span>, <span class="property">Department</span> = <span class="string">"IT"</span>, <span class="property">Salary</span> = <span class="number">85000</span>, <span class="property">YearsOfExperience</span> = <span class="number">10</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Eve"</span>, <span class="property">Department</span> = <span class="string">"Sales"</span>, <span class="property">Salary</span> = <span class="number">95000</span>, <span class="property">YearsOfExperience</span> = <span class="number">15</span> },
    <span class="keyword">new</span> <span class="class">Employee</span> { <span class="property">Name</span> = <span class="string">"Frank"</span>, <span class="property">Department</span> = <span class="string">"Sales"</span>, <span class="property">Salary</span> = <span class="number">70000</span>, <span class="property">YearsOfExperience</span> = <span class="number">4</span> }
};

<span class="comment">// ===== SOLUTIONS =====</span>

<span class="comment">// 1. Employees making more than $60,000</span>
<span class="keyword">var</span> <span class="variable">highEarners</span> = <span class="variable">employees</span>
    .<span class="function">Where</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Salary</span> > <span class="number">60000</span>)
    .<span class="function">ToList</span>();

<span class="comment">// 2. Average salary by department</span>
<span class="keyword">var</span> <span class="variable">avgByDept</span> = <span class="variable">employees</span>
    .<span class="function">GroupBy</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Department</span>)
    .<span class="function">Select</span>(<span class="variable">g</span> => <span class="keyword">new</span>
    {
        <span class="property">Department</span> = <span class="variable">g</span>.<span class="property">Key</span>,
        <span class="property">AverageSalary</span> = <span class="variable">g</span>.<span class="function">Average</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Salary</span>)
    });

<span class="comment">// 3. Top 3 highest paid</span>
<span class="keyword">var</span> <span class="variable">top3</span> = <span class="variable">employees</span>
    .<span class="function">OrderByDescending</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Salary</span>)
    .<span class="function">Take</span>(<span class="number">3</span>)
    .<span class="function">ToList</span>();

<span class="comment">// 4. Sorted by experience (descending)</span>
<span class="keyword">var</span> <span class="variable">byExperience</span> = <span class="variable">employees</span>
    .<span class="function">OrderByDescending</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">YearsOfExperience</span>)
    .<span class="function">ToList</span>();

<span class="comment">// 5. Total salary by department</span>
<span class="keyword">var</span> <span class="variable">totalByDept</span> = <span class="variable">employees</span>
    .<span class="function">GroupBy</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Department</span>)
    .<span class="function">Select</span>(<span class="variable">g</span> => <span class="keyword">new</span>
    {
        <span class="property">Department</span> = <span class="variable">g</span>.<span class="property">Key</span>,
        <span class="property">TotalSalary</span> = <span class="variable">g</span>.<span class="function">Sum</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Salary</span>)
    });

<span class="comment">// 6. Any employee with more than 20 years</span>
<span class="keyword">bool</span> <span class="variable">hasVeteran</span> = <span class="variable">employees</span>.<span class="function">Any</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">YearsOfExperience</span> > <span class="number">20</span>);

<span class="comment">// 7. Highest salary in each department (Query Syntax)</span>
<span class="keyword">var</span> <span class="variable">highestInDept</span> = <span class="keyword">from</span> <span class="variable">e</span> <span class="keyword">in</span> <span class="variable">employees</span>
    <span class="keyword">group</span> <span class="variable">e</span> <span class="keyword">by</span> <span class="variable">e</span>.<span class="property">Department</span> <span class="keyword">into</span> <span class="variable">g</span>
    <span class="keyword">select</span> <span class="keyword">new</span>
    {
        <span class="property">Department</span> = <span class="variable">g</span>.<span class="property">Key</span>,
        <span class="property">HighestSalary</span> = <span class="variable">g</span>.<span class="function">Max</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Salary</span>),
        <span class="property">Employee</span> = <span class="variable">g</span>.<span class="function">First</span>(<span class="variable">e</span> => <span class="variable">e</span>.<span class="property">Salary</span> == <span class="variable">g</span>.<span class="function">Max</span>(<span class="variable">e2</span> => <span class="variable">e2</span>.<span class="property">Salary</span>))
    };

<span class="comment">// Display results</span>
<span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"=== High Earners ==="</span>);
<span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">e</span> <span class="keyword">in</span> <span class="variable">highEarners</span>)
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"{<span class="variable">e</span>.<span class="property">Name</span>}: ${<span class="variable">e</span>.<span class="property">Salary</span>}"</span>);

<span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n=== Top 3 Paid ==="</span>);
<span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">e</span> <span class="keyword">in</span> <span class="variable">top3</span>)
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"{<span class="variable">e</span>.<span class="property">Name</span>}: ${<span class="variable">e</span>.<span class="property">Salary</span>}"</span>);

<span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">"\n=== Average Salary by Department ==="</span>);
<span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">d</span> <span class="keyword">in</span> <span class="variable">avgByDept</span>)
    <span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"{<span class="variable">d</span>.<span class="property">Department</span>}: ${<span class="variable">d</span>.<span class="property">AverageSalary</span>:F2}"</span>);

<span class="function">Console</span>.<span class="function">WriteLine</span>(<span class="string">$"\nHas veteran: {<span class="variable">hasVeteran</span>}"</span>);</code></pre>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== KEY TAKEAWAY ===== -->
                <div class="card bg-info bg-opacity-10 mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>
                            LINQ makes working with data <strong>simple and powerful</strong>:
                            <br><br>
                            ✅ Use <strong>Where()</strong> to filter data<br>
