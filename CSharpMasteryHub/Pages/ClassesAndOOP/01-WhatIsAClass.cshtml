                                                    <i class="fas fa-home fa-2x text-primary me-3"></i>
                                                    <div>
                                                        <h6 class="mb-0"><strong>Blueprint (The Class)</strong></h6>
                                                        <small class="text-muted">The plan, not the house</small>
                                                    </div>
                                                </div>
                                                <ul class="mb-0">
                                                    <li><strong>Fields/Properties</strong> = Characteristics (color, size, rooms)</li>
                                                    <li><strong>Methods</strong> = Actions (open doors, turn on lights)</li>
