                        <!-- Basic Syntax -->
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; border: none;">
                                <h4 class="mb-0"><i class="fas fa-code me-2"></i>Basic Class Syntax</h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="code-block">
                                    <pre><code class="language-csharp"><span class="comment">// A simple class that represents a Person</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Person</span>
{
    <span class="comment">// Fields - data that describes the person</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Name;
    <span class="keyword">public</span> <span class="keyword">int</span> Age;
    <span class="keyword">public</span> <span class="keyword">string</span> Email;
    
    <span class="comment">// Method - behavior the person can do</span>
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Introduce</span>()
    {
        Console.WriteLine(<span class="string">$"Hi, I'm {Name}, I'm {Age} years old."</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">SendEmail</span>(<span class="keyword">string</span> message)
    {
        Console.WriteLine(<span class="string">$"Sending email to {Email}: {message}"</span>);
    }
}

<span class="comment">// Creating an object from the class</span>
<span class="class">Person</span> john = <span class="keyword">new</span> <span class="class">Person</span>();
john.Name = <span class="string">"John Doe"</span>;
john.Age = <span class="number">25</span>;
john.Email = <span class="string">"john@example.com"</span>;
john.<span class="function">Introduce</span>();  <span class="comment">// Output: Hi, I'm John Doe, I'm 25 years old.</span>
john.<span class="function">SendEmail</span>(<span class="string">"Welcome!"</span>);  <span class="comment">// Output: Sending email to john@example.com: Welcome!</span></code></pre>
                                </div>
                                <div class="mt-3 p-3" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 12px; color: white;">
                                    <h6 class="text-white"><i class="fas fa-key me-2"></i>Breaking It Down:</h6>
                                    <ul class="mb-0">
                                        <li><strong>public class Person</strong> - Creates a new class called "Person"</li>
                                        <li><strong>public string Name;</strong> - A field that stores text (the person's name)</li>
                                        <li><strong>public int Age;</strong> - A field that stores a number (the person's age)</li>
                                        <li><strong>public void Introduce()</strong> - A method that makes the person introduce themselves</li>
                                        <li><strong>new Person()</strong> - Creates a new object (instance) of the Person class</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Real-World Industry Example -->
                    <section class="mb-5" data-aos="fade-up">
                        <h2 class="display-6 fw-bold border-bottom pb-3">
                            <i class="fas fa-industry text-warning me-3"></i>Real-World Industry Example
                        </h2>
                        
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h4 class="mb-0"><i class="fas fa-bank me-2"></i>Banking Application - Customer Account</h4>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">In a real banking system, every customer account is an <strong>object</strong> created from an <strong>Account</strong> class.</p>
                                
                                <div class="code-block">
                                    <pre><code class="language-csharp"><span class="keyword">using</span> System;
<span class="keyword">using</span> System.Collections.Generic;

<span class="comment">/// &lt;summary&gt;
/// Represents a bank account in a real banking system.
/// Used by millions of customers worldwide!
/// &lt;/summary&gt;</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">BankAccount</span>
{
    <span class="comment">// Private fields - sensitive data</span>
    <span class="keyword">private</span> <span class="keyword">string</span> accountNumber;
    <span class="keyword">private</span> <span class="keyword">string</span> accountHolder;
    <span class="keyword">private</span> <span class="keyword">decimal</span> balance;
    <span class="keyword">private</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt; transactionHistory = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt;();
    <span class="keyword">private</span> <span class="keyword">DateTime</span> createdDate;
    
    <span class="comment">// Properties - controlled access</span>
    <span class="keyword">public</span> <span class="keyword">string</span> AccountNumber
    {
        <span class="function">get</span> { <span class="keyword">return</span> accountNumber; }
        <span class="keyword">private</span> <span class="function">set</span> { accountNumber = value; } <span class="comment">// Read-only outside</span>
    }
    
    <span class="keyword">public</span> <span class="keyword">string</span> AccountHolder
    {
        <span class="function">get</span> { <span class="keyword">return</span> accountHolder; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(value))
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Account holder name is required"</span>);
            accountHolder = value; 
        }
    }
    
    <span class="keyword">public</span> <span class="keyword">decimal</span> Balance
    {
        <span class="function">get</span> { <span class="keyword">return</span> balance; }
        <span class="keyword">private</span> <span class="function">set</span> <span class="comment">// Only modified through methods</span>
        { 
            <span class="keyword">if</span> (value &lt; <span class="number">0</span>)
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">InvalidOperationException</span>(<span class="string">"Balance cannot be negative"</span>);
            balance = value; 
        }
    }
    
    <span class="keyword">public</span> <span class="keyword">DateTime</span> CreatedDate => createdDate;
    <span class="keyword">public</span> <span class="keyword">int</span> TransactionCount => transactionHistory.Count;
    
    <span class="comment">// Constructor - creates a new account</span>
    <span class="keyword">public</span> <span class="function">BankAccount</span>(<span class="keyword">string</span> accountHolder, <span class="keyword">decimal</span> initialDeposit)
    {
        AccountNumber = <span class="function">GenerateAccountNumber</span>();
        AccountHolder = accountHolder;
        Balance = initialDeposit;
        createdDate = DateTime.Now;
        
        <span class="comment">// Log the initial deposit</span>
        <span class="function">AddTransaction</span>(<span class="string">$"Account created with deposit: ${initialDeposit:F2}"</span>);
    }
    
    <span class="comment">// Methods - account behavior</span>
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Deposit</span>(<span class="keyword">decimal</span> amount)
    {
        <span class="keyword">if</span> (amount &lt;= <span class="number">0</span>)
            <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Deposit amount must be positive"</span>);
        
        Balance += amount;
        <span class="function">AddTransaction</span>(<span class="string">$"Deposit: +${amount:F2}. New balance: ${Balance:F2}"</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Withdraw</span>(<span class="keyword">decimal</span> amount)
    {
        <span class="keyword">if</span> (amount &lt;= <span class="number">0</span>)
            <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Withdrawal amount must be positive"</span>);
        
        <span class="keyword">if</span> (amount > Balance)
            <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">InvalidOperationException</span>(<span class="string">"Insufficient funds"</span>);
        
        Balance -= amount;
        <span class="function">AddTransaction</span>(<span class="string">$"Withdrawal: -${amount:F2}. New balance: ${Balance:F2}"</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">DisplayAccountInfo</span>()
    {
        Console.WriteLine(<span class="string">$@@"</span>
<span class="string">╔══════════════════════════════════════════════════╗</span>
<span class="string">║              ACCOUNT DETAILS                    ║</span>
<span class="string">╠══════════════════════════════════════════════════╣</span>
<span class="string">║ Account Number: {AccountNumber,-22} ║</span>
<span class="string">║ Account Holder: {AccountHolder,-22} ║</span>
<span class="string">║ Balance:       ${Balance,-20:F2} ║</span>
<span class="string">║ Created:       {CreatedDate.ToShortDateString(),-22} ║</span>
<span class="string">║ Transactions:  {TransactionCount,-22} ║</span>
<span class="string">╚══════════════════════════════════════════════════╝</span>
<span class="string">"</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">ShowTransactionHistory</span>()
    {
        Console.WriteLine(<span class="string">$"\nTransaction History for {AccountNumber}:"</span>);
        <span class="keyword">foreach</span> (<span class="keyword">var</span> transaction <span class="keyword">in</span> transactionHistory)
        {
            Console.WriteLine(<span class="string">$"  • {transaction}"</span>);
        }
    }
    
    <span class="comment">// Private helper methods</span>
    <span class="keyword">private</span> <span class="keyword">string</span> <span class="function">GenerateAccountNumber</span>()
    {
        <span class="comment">// Simulate generating a unique account number</span>
        Random random = <span class="keyword">new</span> <span class="class">Random</span>();
        <span class="keyword">return</span> <span class="string">$"ACC-{random.Next(100000, 999999)}-{DateTime.Now.Year}"</span>;
    }
    
    <span class="keyword">private</span> <span class="keyword">void</span> <span class="function">AddTransaction</span>(<span class="keyword">string</span> description)
    {
        transactionHistory.Add(<span class="string">$"{DateTime.Now:yyyy-MM-dd HH:mm:ss} - {description}"</span>);
    }
}

<span class="comment">// Using the BankAccount class in a real application</span>
<span class="keyword">class</span> <span class="class">BankingSystem</span>
{
    <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">Main</span>()
    {
        Console.WriteLine(<span class="string">"🏦 Welcome to C# Mastery Bank System"</span>);
        Console.WriteLine(<span class="string">"═══════════════════════════════════════\n"</span>);
        
        <span class="comment">// Create customer accounts (objects)</span>
        <span class="class">BankAccount</span> account1 = <span class="keyword">new</span> <span class="class">BankAccount</span>(<span class="string">"John Smith"</span>, <span class="number">1000.00m</span>);
        <span class="class">BankAccount</span> account2 = <span class="keyword">new</span> <span class="class">BankAccount</span>(<span class="string">"Jane Doe"</span>, <span class="number">2500.00m</span>);
        
        <span class="comment">// Perform transactions</span>
        Console.WriteLine(<span class="string">"💰 Transaction 1: John deposits $500"</span>);
        account1.<span class="function">Deposit</span>(<span class="number">500.00m</span>);
        
        Console.WriteLine(<span class="string">"💰 Transaction 2: Jane withdraws $100"</span>);
        account2.<span class="function">Withdraw</span>(<span class="number">100.00m</span>);
        
        Console.WriteLine(<span class="string">"💰 Transaction 3: John withdraws $2000"</span>);
        <span class="keyword">try</span>
        {
            account1.<span class="function">Withdraw</span>(<span class="number">2000.00m</span>);
        }
        <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
        {
            Console.WriteLine(<span class="string">$"❌ Error: {ex.Message}"</span>);
        }
        
        Console.WriteLine(<span class="string">"\n📊 Account Information:"</span>);
        account1.<span class="function">DisplayAccountInfo</span>();
        account1.<span class="function">ShowTransactionHistory</span>();
        
        Console.WriteLine(<span class="string">"\n"</span> + <span class="string">"-"</span>.<span class="function">PadRight</span>(<span class="number">50</span>, <span class="string">'-'</span>));
        
        account2.<span class="function">DisplayAccountInfo</span>();
        account2.<span class="function">ShowTransactionHistory</span>();
    }
}</code></pre>
                                </div>
                                
                                <div class="mt-4 p-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; color: white;">
                                    <h6 class="text-white"><i class="fas fa-gem me-2"></i>What This Real-World Example Shows:</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="mb-0">
                                                <li><strong>Encapsulation</strong> - Private fields, public methods</li>
                                                <li><strong>Validation</strong> - Checking for valid inputs</li>
                                                <li><strong>Business Logic</strong> - Deposit, withdraw rules</li>
                                                <li><strong>Data Protection</strong> - Balance can't go negative</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="mb-0">
                                                <li><strong>Transaction History</strong> - Logging all activity</li>
                                                <li><strong>Object Independence</strong> - Each account has its own data</li>
                                                <li><strong>Error Handling</strong> - Proper exception throwing</li>
                                                <li><strong>Reusability</strong> - One class, many accounts</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Creating Objects -->
                    <section class="mb-5" data-aos="fade-up">
                        <h2 class="display-6 fw-bold border-bottom pb-3">
                            <i class="fas fa-plus-circle text-success me-3"></i>Creating Objects from a Class
                        </h2>
                        
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; border: none;">
                                <h4 class="mb-0"><i class="fas fa-cube me-2"></i>Object Creation - Two Methods</h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5 class="text-primary"><i class="fas fa-step-forward me-2"></i>Method 1: Create + Set</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="class">Person</span> person1 = <span class="keyword">new</span> <span class="class">Person</span>();
person1.Name = <span class="string">"John"</span>;
person1.Age = <span class="number">25</span>;
person1.<span class="function">Introduce</span>();</code></pre>
                                                </div>
                                                <div class="mt-2">
                                                    <span class="badge bg-primary">Step by step</span>
                                                    <small class="text-muted d-block">Create object → Set properties → Use it</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5 class="text-success"><i class="fas fa-bolt me-2"></i>Method 2: Object Initializer</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="class">Person</span> person2 = <span class="keyword">new</span> <span class="class">Person</span> 
{ 
    Name = <span class="string">"Jane"</span>, 
    Age = <span class="number">30</span> 
};
person2.<span class="function">Introduce</span>();</code></pre>
                                                </div>
                                                <div class="mt-2">
                                                    <span class="badge bg-success">⚡ Quick & Clean</span>
                                                    <small class="text-muted d-block">Set properties at creation time</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 p-3" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 12px; color: white;">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Important:</strong> Each object is <strong>independent</strong>! 
                                    Changing <code>person1.Name</code> doesn't affect <code>person2.Name</code>.
                                    They are separate instances with their own data.
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Class Components -->
                    <section class="mb-5" data-aos="fade-up">
                        <h2 class="display-6 fw-bold border-bottom pb-3">
                            <i class="fas fa-puzzle-piece text-warning me-3"></i>Class Components
                        </h2>
                        
                        <div class="row g-4">
                            <!-- Fields -->
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none;">
                                        <h5 class="mb-0"><i class="fas fa-database me-2"></i>Fields - Storing Data</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Student</span>
{
    <span class="comment">// Fields hold data</span>
    <span class="keyword">public</span> <span class="keyword">string</span> FirstName;
    <span class="keyword">public</span> <span class="keyword">string</span> LastName;
    <span class="keyword">public</span> <span class="keyword">int</span> StudentId;
    <span class="keyword">public</span> <span class="keyword">double</span> GPA;
}</code></pre>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge bg-info">Variables that belong to the class</span>
                                            <p class="mt-2 mb-0">Store the <strong>state</strong> or <strong>data</strong> of the object.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Properties -->
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                        <h5 class="mb-0"><i class="fas fa-sliders-h me-2"></i>Properties - Controlled Access</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Product</span>
{
    <span class="keyword">private</span> <span class="keyword">decimal</span> price;
    
    <span class="keyword">public</span> <span class="keyword">decimal</span> Price
    {
        <span class="function">get</span> { <span class="keyword">return</span> price; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (value &lt; <span class="number">0</span>)
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">Exception</span>();
            price = value; 
        }
    }
}</code></pre>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge bg-warning text-dark">✅ Add validation</span>
                                            <p class="mt-2 mb-0">Control <strong>how</strong> data is accessed and modified.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Methods -->
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                        <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Methods - Defining Behavior</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Calculator</span>
{
    <span class="keyword">public</span> <span class="keyword">int</span> <span class="function">Add</span>(<span class="keyword">int</span> a, <span class="keyword">int</span> b)
    {
        <span class="keyword">return</span> a + b;
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Display</span>(<span class="keyword">int</span> result)
    {
        Console.WriteLine(result);
    }
}</code></pre>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge bg-danger">Actions the object can perform</span>
                                            <p class="mt-2 mb-0">Define <strong>behavior</strong> and <strong>functionality</strong>.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Constructors -->
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                        <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Constructors - Creating Objects</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Book</span>
{
    <span class="keyword">public</span> <span class="function">Book</span>(<span class="keyword">string</span> title, <span class="keyword">string</span> author)
    {
        Title = title;
        Author = author;
    }
    
    <span class="keyword">public</span> <span class="keyword">string</span> Title { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">string</span> Author { <span class="function">get</span>; <span class="function">set</span>; }
}

<span class="comment">// Usage</span>
<span class="class">Book</span> book = <span class="keyword">new</span> <span class="class">Book</span>(<span class="string">"C# Programming"</span>, <span class="string">"John Doe"</span>);</code></pre>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge bg-success">Special method that runs when object is created</span>
                                            <p class="mt-2 mb-0">Initialize the object with <strong>required values</strong>.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Access Modifiers -->
                    <section class="mb-5" data-aos="fade-up">
                        <h2 class="display-6 fw-bold border-bottom pb-3">
                            <i class="fas fa-lock text-danger me-3"></i>Access Modifiers
                        </h2>
                        <p class="fs-5">Control <strong>visibility</strong> and <strong>access</strong> to class members.</p>
                        
                        <div class="row g-4">
                            <div class="col-lg-3 col-md-6">
                                <div class="card border-0 shadow-lg h-100 text-center" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-body p-4">
                                        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                                            <i class="fas fa-globe fa-2x text-white"></i>
                                        </div>
                                        <h4 class="text-primary">public</h4>
                                        <p>Accessible from <strong>anywhere</strong></p>
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">string</span> Name;</code></pre>
                                        </div>
                                        <span class="badge bg-success">100% visible</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-3 col-md-6">
                                <div class="card border-0 shadow-lg h-100 text-center" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-body p-4">
                                        <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                                            <i class="fas fa-eye-slash fa-2x text-white"></i>
                                        </div>
                                        <h4 class="text-danger">private</h4>
                                        <p>Accessible <strong>only inside</strong> the class</p>
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">private</span> <span class="keyword">string</span> _secret;</code></pre>
                                        </div>
                                        <span class="badge bg-danger">Hidden</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-3 col-md-6">
                                <div class="card border-0 shadow-lg h-100 text-center" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-body p-4">
                                        <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                                            <i class="fas fa-shield-alt fa-2x text-white"></i>
                                        </div>
                                        <h4 class="text-info">protected</h4>
                                        <p>Accessible in <strong>child classes</strong></p>
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">protected</span> <span class="keyword">string</span> _base;</code></pre>
                                        </div>
                                        <span class="badge bg-info">Inheritance</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-3 col-md-6">
                                <div class="card border-0 shadow-lg h-100 text-center" style="border-radius: 20px; overflow: hidden;">
                                    <div class="card-body p-4">
                                        <div style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                                            <i class="fas fa-box fa-2x text-white"></i>
                                        </div>
                                        <h4 class="text-success">internal</h4>
                                        <p>Accessible in <strong>same project</strong></p>
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">internal</span> <span class="keyword">class</span> Helper;</code></pre>
                                        </div>
                                        <span class="badge bg-success">Assembly</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Static vs Instance -->
                    <section class="mb-5" data-aos="fade-up">
                        <h2 class="display-6 fw-bold border-bottom pb-3">
                            <i class="fas fa-copy text-primary me-3"></i>Static vs Instance Members
                        </h2>
                        
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-cube text-success me-2"></i>Instance Members</h5>
                                                <p>Belong to <strong>each object</strong> individually.</p>
                                                <ul>
                                                    <li>Each object has its own copy</li>
                                                    <li>Accessed through an <strong>object variable</strong></li>
                                                    <li>Example: <code>person.Name</code></li>
                                                </ul>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-cubes text-warning me-2"></i>Static Members</h5>
                                                <p>Belong to the <strong>class itself</strong> (shared).</p>
                                                <ul>
                                                    <li>All objects share the same value</li>
                                                    <li>Accessed through the <strong>class name</strong></li>
                                                    <li>Example: <code>Math.PI</code></li>
                                                </ul>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">string</span> Version = <span class="string">"1.0"</span>;</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="mt-3 p-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; color: white;">
                                    <i class="fas fa-lightbulb me-2"></i>
                                    <strong>When to use Static:</strong>
                                    Utility methods (<code>Math.Sqrt()</code>), shared data (object counter), constants (never-changing values).
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Key Takeaway -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="flip-up" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-body p-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-key fa-3x"></i>
                                </div>
                                <div>
                                    <h3 class="fw-bold">Key Takeaway</h3>
                                    <p class="fs-5">
                                        A <strong>class</strong> is a blueprint that combines <strong>data</strong> (fields/properties) 
                                        and <strong>behavior</strong> (methods) into a single unit. 
                                        <strong>Objects</strong> are instances of classes. 
                                        This is the foundation of Object-Oriented Programming!
                                    </p>
                                    <div class="d-flex gap-3 flex-wrap">
                                        <span class="badge bg-white text-dark fs-6 px-4 py-2">🏗️ Blueprint</span>
                                        <span class="badge bg-white text-dark fs-6 px-4 py-2">🏠 Objects</span>
                                        <span class="badge bg-white text-dark fs-6 px-4 py-2">🔄 Reusability</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Exercise -->
                    <div class="card border-0 shadow-lg mt-5" data-aos="zoom-in" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                            <h3 class="mb-0"><i class="fas fa-pencil-alt me-2"></i>Exercise - Create a Movie Class</h3>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="fw-bold">Your Task:</h5>
                            <p>Create a class called <code>Movie</code> with the following:</p>
                            
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <div class="card bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="text-primary"><i class="fas fa-list me-2"></i>Requirements:</h6>
                                            <ol>
                                                <li><strong>Fields</strong> (private):
                                                    <ul>
                                                        <li><code>title</code> (string)</li>
                                                        <li><code>director</code> (string)</li>
                                                        <li><code>year</code> (int)</li>
                                                        <li><code>rating</code> (double)</li>
                                                    </ul>
                                                </li>
                                                <li><strong>Properties</strong> (public):
                                                    <ul>
                                                        <li>All fields with validation</li>
                                                        <li>Rating must be between 0 and 10</li>
                                                        <li>Year must be between 1888 and current year</li>
                                                    </ul>
                                                </li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="card bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="text-success"><i class="fas fa-code me-2"></i>Requirements Continued:</h6>
                                            <ol start="3">
                                                <li><strong>Constructor</strong>:
                                                    <ul>
                                                        <li>Accepts all 4 parameters</li>
                                                    </ul>
                                                </li>
                                                <li><strong>Methods</strong>:
                                                    <ul>
                                                        <li><code>DisplayInfo()</code> - shows all movie details</li>
                                                        <li><code>CalculateAge()</code> - returns how old the movie is</li>
                                                        <li><code>IsClassic()</code> - returns true if movie is 25+ years old</li>
                                                    </ul>
                                                </li>
                                            </ol>
                                            <div class="mt-2">
                                                <span class="badge bg-warning text-dark">💡 Use the Book example as reference!</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-primary mt-3" onclick="toggleSolution()" style="border-radius: 50px; padding: 12px 30px;">
                                <i class="fas fa-eye me-2"></i> Show Solution
                            </button>

                            <div id="solution" style="display: none; margin-top: 20px;">
                                <div class="p-3 rounded border" style="background: #1e1e2e;">
                                    <div class="code-block">
                                        <pre><code class="language-csharp"><span class="keyword">using</span> System;

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Movie</span>
{
    <span class="comment">// Private fields</span>
    <span class="keyword">private</span> <span class="keyword">string</span> title;
    <span class="keyword">private</span> <span class="keyword">string</span> director;
    <span class="keyword">private</span> <span class="keyword">int</span> year;
    <span class="keyword">private</span> <span class="keyword">double</span> rating;
    
    <span class="comment">// Properties with validation</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Title
    {
        <span class="function">get</span> { <span class="keyword">return</span> title; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(value))
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Title cannot be empty"</span>);
            title = value; 
        }
    }
    
    <span class="keyword">public</span> <span class="keyword">string</span> Director
    {
        <span class="function">get</span> { <span class="keyword">return</span> director; }
        <span class="function">set</span> { director = value; }
    }
    
    <span class="keyword">public</span> <span class="keyword">int</span> Year
    {
        <span class="function">get</span> { <span class="keyword">return</span> year; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (value &lt; <span class="number">1888</span> || value > DateTime.Now.Year)
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Invalid year"</span>);
            year = value; 
        }
    }
    
    <span class="keyword">public</span> <span class="keyword">double</span> Rating
    {
        <span class="function">get</span> { <span class="keyword">return</span> rating; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (value &lt; <span class="number">0</span> || value > <span class="number">10</span>)
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Rating must be between 0 and 10"</span>);
            rating = value; 
        }
    }
    
    <span class="comment">// Constructor</span>
    <span class="keyword">public</span> <span class="function">Movie</span>(<span class="keyword">string</span> title, <span class="keyword">string</span> director, <span class="keyword">int</span> year, <span class="keyword">double</span> rating)
    {
        Title = title;
        Director = director;
        Year = year;
        Rating = rating;
    }
    
    <span class="comment">// Methods</span>
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">DisplayInfo</span>()
    {
        Console.WriteLine(<span class="string">$"🎬 Title: {Title}"</span>);
        Console.WriteLine(<span class="string">$"🎥 Director: {Director}"</span>);
        Console.WriteLine(<span class="string">$"📅 Year: {Year}"</span>);
        Console.WriteLine(<span class="string">$"⭐ Rating: {Rating:F1}/10"</span>);
        Console.WriteLine(<span class="string">$"📆 Age: {CalculateAge()} years"</span>);
        Console.WriteLine(<span class="string">$"🏆 Classic: {(IsClassic() ? "Yes ✔️" : "No ❌")}"</span>);
        Console.WriteLine();
    }
    
    <span class="keyword">public</span> <span class="keyword">int</span> <span class="function">CalculateAge</span>()
    {
        <span class="keyword">return</span> DateTime.Now.Year - Year;
    }
    
    <span class="keyword">public</span> <span class="keyword">bool</span> <span class="function">IsClassic</span>()
    {
        <span class="keyword">return</span> <span class="function">CalculateAge</span>() >= <span class="number">25</span>;
    }
}

<span class="comment">// Test the class</span>
<span class="keyword">class</span> <span class="class">Program</span>
{
    <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">Main</span>()
    {
        <span class="class">Movie</span> matrix = <span class="keyword">new</span> <span class="class">Movie</span>(<span class="string">"The Matrix"</span>, <span class="string">"Wachowski Sisters"</span>, <span class="number">1999</span>, <span class="number">8.7</span>);
        matrix.<span class="function">DisplayInfo</span>();
        
        <span class="class">Movie</span> godfather = <span class="keyword">new</span> <span class="class">Movie</span>(<span class="string">"The Godfather"</span>, <span class="string">"Francis Ford Coppola"</span>, <span class="number">1972</span>, <span class="number">9.2</span>);
        godfather.<span class="function">DisplayInfo</span>();
        
        <span class="class">Movie</span> dune = <span class="keyword">new</span> <span class="class">Movie</span>(<span class="string">"Dune"</span>, <span class="string">"Denis Villeneuve"</span>, <span class="number">2021</span>, <span class="number">8.1</span>);
        dune.<span class="function">DisplayInfo</span>();
    }
}</code></pre>
                                    </div>
                                    <div class="mt-3">
                                        <span class="badge bg-success fs-6">✅ Solution Complete!</span>
                                        <span class="badge bg-info fs-6 ms-2">All concepts covered: fields, properties, constructor, methods</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="mt-5 d-flex flex-wrap justify-content-between">
                        <a href="/ClassesAndOOP" class="btn btn-outline-primary btn-lg" data-aos="fade-right" style="border-radius: 50px; padding: 12px 30px;">
                            <i class="fas fa-arrow-left me-2"></i>Back to Lessons
                        </a>
                        <a href="/ClassesAndOOP/02-FieldsAndProperties" class="btn btn-primary btn-lg" data-aos="fade-left" style="border-radius: 50px; padding: 12px 30px;">
                            Next Lesson <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>

                </div> <!-- end lesson-content -->
