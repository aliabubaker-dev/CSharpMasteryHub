                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Quantity cannot be negative!"</span>);
            quantity = value; 
        }
    }
    
    <span class="comment">// Auto-property</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Category { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="comment">// Read-only property (calculated)</span>
    <span class="keyword">public</span> <span class="keyword">decimal</span> TotalValue => Price * Quantity;
    
