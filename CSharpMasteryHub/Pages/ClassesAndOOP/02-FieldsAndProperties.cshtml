    }
}</code></pre>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <h5><i class="fas fa-play text-success me-2"></i>Program.cs (Using the Student)</h5>
                                        <div class="code-block">
                                            <pre><code class="language-csharp"><span class="keyword">using</span> System;

<span class="keyword">class</span> <span class="class">Program</span>
{
    <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">Main</span>()
    {
        <span class="comment">// Create a student using the constructor</span>
        <span class="class">Student</span> student1 = <span class="keyword">new</span> <span class="class">Student</span>(<span class="string">"John"</span>, <span class="string">"Smith"</span>, <span class="number">15</span>, <span class="number">10</span>);
