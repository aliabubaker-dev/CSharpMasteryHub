                                <div class="p-3 rounded border" style="background: #1e1e2e;">
                                    <div class="code-block">
                                        <pre><code class="language-csharp"><span class="comment">// Product.cs</span>
<span class="keyword">using</span> System;

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Product</span>
{
    <span class="comment">// Private fields</span>
    <span class="keyword">private</span> <span class="keyword">string</span> name;
    <span class="keyword">private</span> <span class="keyword">decimal</span> price;
    <span class="keyword">private</span> <span class="keyword">int</span> quantity;
    
    <span class="comment">// Properties with validation</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Name
    {
        <span class="function">get</span> { <span class="keyword">return</span> name; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(value))
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Name cannot be empty!"</span>);
            name = value; 
        }
    }
    
    <span class="keyword">public</span> <span class="keyword">decimal</span> Price
    {
        <span class="function">get</span> { <span class="keyword">return</span> price; }
        <span class="function">set</span> 
        { 
            <span class="keyword">if</span> (value &lt;= <span class="number">0</span>)
                <span class="keyword">throw</span> <span class="keyword">new</span> <span class="class">ArgumentException</span>(<span class="string">"Price must be greater than 0!"</span>);
