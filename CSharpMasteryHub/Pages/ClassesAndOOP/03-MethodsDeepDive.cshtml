                        <div class="card-body p-4">
                            <h5>Your Task:</h5>
                            <p>Create an <code>InventoryManager</code> class with the following:</p>

                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6><i class="fas fa-list text-primary me-2"></i>Requirements:</h6>
                                            <ol>
                                                <li>
                                                    <strong>AddItem</strong> - Add an item with name and quantity
                                                    <ul>
