        manager.<span class="function">RemoveStudent</span>(<span class="string">"Unknown"</span>);  <span class="comment">// This will show "not found"</span>
        
        Console.WriteLine();
        manager.<span class="function">DisplayAll</span>();
        
        <span class="comment">// Get a specific student</span>
        <span class="keyword">try</span>
        {
            <span class="keyword">string</span> student = manager.<span class="function">GetStudent</span>(<span class="number">0</span>);
            Console.WriteLine(<span class="string">$"👤 First student: {student}"</span>);
            
            <span class="comment">// This will throw an error</span>
            <span class="keyword">string</span> invalid = manager.<span class="function">GetStudent</span>(<span class="number">99</span>);
        }
        <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
        {
            Console.WriteLine(<span class="string">$"❌ Error: {ex.Message}"</span>);
        }
        
        Console.WriteLine(<span class="string">$"\n📊 Total students: {manager.Count}"</span>);
    }
}</code></pre>
