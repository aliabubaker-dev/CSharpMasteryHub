                                                <li>
                                                    <strong>RemoveItem</strong> - Remove item by name
                                                    <ul>
                                                        <li>Returns true if removed</li>
                                                        <li>Returns false if not found</li>
                                                    </ul>
                                                </li>
                                                <li>
                                                    <strong>FindItem</strong> - Find item by name
                                                    <ul>
                                                        <li>Uses <code>out</code> parameter to return quantity</li>
                                                        <li>Returns true if found</li>
                                                    </ul>
                                                </li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6><i class="fas fa-code text-success me-2"></i>More Requirements:</h6>
                                            <ol start="4">
                                                <li>
                                                    <strong>UpdateQuantity</strong> - Update quantity by name
                                                    <ul>
                                                        <li>New quantity must be positive</li>
                                                        <li>Returns true if updated</li>
                                                    </ul>
                                                </li>
                                                <li>
                                                    <strong>GetTotalValue</strong> - Calculate total value of all items
                                                    <ul>
                                                        <li>Uses price * quantity for each item</li>
                                                    </ul>
                                                </li>
                                                <li><strong>DisplayInventory</strong> - Show all items with formatting</li>
                                                <li><strong>Count</strong> - Read-only property for item count</li>
                                            </ol>
                                            <div class="mt-2">
                                                <span class="badge bg-warning text-dark">💡 Use the StudentManager as reference!</span>
                                            </div>
