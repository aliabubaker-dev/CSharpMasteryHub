        book2.<span class="function">Borrow</span>();
        
        Console.WriteLine(<span class="string">"📖 Borrowing 'Design Patterns'..."</span>);
        book3.<span class="function">Borrow</span>();
        
        Console.WriteLine(<span class="string">"\n📚 Updated Status:"</span>);
        book1.<span class="function">DisplayInfo</span>();
        book2.<span class="function">DisplayInfo</span>();
        book3.<span class="function">DisplayInfo</span>();
        
        Console.WriteLine(<span class="string">"📚 Returning 'Clean Code'..."</span>);
        book2.<span class="function">Return</span>();
        
        Console.WriteLine(<span class="string">"\n📚 Final Status:"</span>);
        book2.<span class="function">DisplayInfo</span>();
    }
}</code></pre>
