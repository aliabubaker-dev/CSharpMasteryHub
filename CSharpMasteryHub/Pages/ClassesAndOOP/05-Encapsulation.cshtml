        <span class="class">Employee</span> emp = <span class="keyword">new</span> <span class="class">Employee</span>(<span class="string">"John Doe"</span>, <span class="number">50000.00m</span>, <span class="number">3</span>);
        
        <span class="comment">// ✅ Can read public data</span>
