        <span class="comment">// Create different character types</span>
        <span class="class">Warrior</span> warrior = <span class="keyword">new</span> <span class="class">Warrior</span>(<span class="string">"Conan"</span>, <span class="number">100</span>, <span class="string">"Sword"</span>);
        <span class="class">Mage</span> mage = <span class="keyword">new</span> <span class="class">Mage</span>(<span class="string">"Merlin"</span>, <span class="number">80</span>, <span class="string">"Fireball"</span>);
        <span class="class">Archer</span> archer = <span class="keyword">new</span> <span class="class">Archer</span>(<span class="string">"Legolas"</span>, <span class="number">90</span>, <span class="string">"Longbow"</span>);
        
        <span class="comment">// Each attacks differently (override)</span>
        warrior.<span class="function">Attack</span>();  <span class="comment">// ⚔️ Conan swings Sword!</span>
        mage.<span class="function">Attack</span>();     <span class="comment">// 🔮 Merlin casts Fireball!</span>
        archer.<span class="function">Attack</span>();    <span class="comment">// 🏹 Legolas shoots Longbow!</span>
        
        <span class="comment">// Polymorphism - treating all as Character</span>
        Console.WriteLine(<span class="string">"\n🔄 Polymorphism: Treating all as Character"</span>);
        <span class="class">Character</span>[] characters = { warrior, mage, archer };
        <span class="keyword">foreach</span> (<span class="keyword">var</span> character <span class="keyword">in</span> characters)
        {
            character.<span class="function">Attack</span>();  <span class="comment">// Each uses its own override!</span>
        }
    }
}</code></pre>
