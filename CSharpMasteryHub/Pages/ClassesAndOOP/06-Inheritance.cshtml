    ViewData["Title"] = "Inheritance in C# - Learn Like a Pro (The Easy Way)";
}

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.8);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/ClassesAndOOP" style="color: rgba(255,255,255,0.8);">Classes and OOP</a></li>
                            <li class="breadcrumb-item active" style="color: white;">Inheritance</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                        Inheritance 🧬
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Learn How Classes Can Be Family! (It's Easier Than You Think!)
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-success fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-smile me-2"></i>Beginner Friendly
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>25 min read
                        </span>
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 6 of 11
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left">
                    <i class="fas fa-family fa-8x text-white" style="opacity: 0.3; text-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- 🎉 Welcome Section -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-body p-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-smile-wink fa-3x text-warning"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">Hey there, Future C# Master! 👋</h2>
                                    <p class="fs-5">
                                        Welcome to <strong>Inheritance</strong> - one of the coolest features in C#!
                                        Don't worry, I won't use big fancy words. We'll learn together, step by step.
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Quick Question:</strong> Did you inherit your eye color from your parents?
                                        Or maybe your height? That's exactly what inheritance in C# is about -
                                        <strong>children getting traits from their parents</strong>!
                                    </div>
                                    <div class="mt-3">
                                        <span class="badge bg-primary p-2">🎯 After this lesson, you'll be able to:</span>
                                        <ul class="mt-2">
                                            <li>✅ Explain inheritance like a pro (but in simple words)</li>
                                            <li>✅ Create parent and child classes</li>
                                            <li>✅ Use the 'base' keyword (it's not scary, I promise!)</li>
                                            <li>✅ Override methods (change how things work)</li>
                                            <li>✅ Build your own inheritance hierarchies</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 📚 Part 1: What is Inheritance? (Super Simple) -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-1 me-2"></i>Part 1: What is Inheritance? (The Easy Way)</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>In Simple Words:</strong> Inheritance is when one class <strong>inherits</strong> (gets) all the properties and methods from another class.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-user text-primary me-2"></i>👨‍👩‍👧‍👦 The Family Analogy</h5>
                                                <p>Imagine a <strong>Parent</strong> class called <code>Animal</code>:</p>
                                                <ul>
                                                    <li>🐾 Every animal has a <strong>Name</strong></li>
                                                    <li>🐾 Every animal has an <strong>Age</strong></li>
                                                    <li>🐾 Every animal can <strong>Eat()</strong></li>
                                                    <li>🐾 Every animal can <strong>Sleep()</strong></li>
                                                </ul>
                                                <p class="mt-2">Now, a <strong>Child</strong> class called <code>Dog</code> <strong>inherits</strong> from <code>Animal</code>:</p>
                                                <ul>
                                                    <li>🐕 Dog <strong>gets</strong> Name, Age, Eat(), Sleep()</li>
                                                    <li>🐕 Dog <strong>adds</strong> its own things: Breed, Bark()</li>
                                                </ul>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Result:</strong> Dog has <strong>everything</strong> Animal has + its own stuff!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 Code Time!</h5>
                                                <p><strong>Parent Class (Animal):</strong></p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name;
    <span class="keyword">public</span> <span class="keyword">int</span> Age;
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Eat</span>()
    {
        Console.WriteLine(<span class="string">$"{Name} is eating!"</span>);
    }
}</code></pre>
                                                </div>
                                                <p class="mt-2"><strong>Child Class (Dog):</strong></p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>  <span class="comment">// 👈 This means "inherits"</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Breed;
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Bark</span>()
    {
        Console.WriteLine(<span class="string">$"{Name} says Woof!"</span>);
    }
}</code></pre>
                                                </div>
                                                <div class="alert alert-warning mt-2">
                                                    <i class="fas fa-star me-2"></i>
                                                    <strong>🎉 Congratulations!</strong> You just created your first inheritance!
                                                    <br>
                                                    <span class="badge bg-success mt-1">Dog automatically has Name, Age, and Eat()!</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Fun Joke:</strong> Why did the inheritance class go to therapy?
                                        Because it had too many parent issues! (Get it? Parents? Inheritance? ...Okay, I'll stop 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🧩 Part 2: The ':' Symbol - The Magic Link -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-2 me-2"></i>Part 2: The ':' Symbol - The Magic Link</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-link text-primary me-2"></i>🔗 The Connection</h5>
                                                <p>The <strong>':'</strong> symbol is like a <strong>bridge</strong> between parent and child.</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Child</span> : <span class="class">Parent</span>  <span class="comment">// 👈 The ':' means "inherits from"</span>
{
    <span class="comment">// Child gets everything from Parent</span>
}</code></pre>
                                                </div>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Read it as:</strong> "Child <strong>inherits from</strong> Parent"<br>
                                                    or "Child <strong>is a</strong> Parent"
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-examples text-primary me-2"></i>📝 Real Examples</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Dog IS AN Animal</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span> { }

<span class="comment">// Car IS A Vehicle</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Car</span> : <span class="class">Vehicle</span> { }

<span class="comment">// Student IS A Person</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Student</span> : <span class="class">Person</span> { }</code></pre>
                                                </div>
                                                <div class="card bg-warning text-dark mt-2">
                                                    <div class="card-body">
                                                        <i class="fas fa-lightbulb me-2"></i>
                                                        <strong>Pro Tip:</strong> If you can say "X IS A Y", inheritance makes sense!
                                                        <br>
                                                        ✅ "A Dog IS AN Animal" <br>
                                                        ❌ "A Dog IS A Car" (That would be weird!)
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🏠 Part 3: The 'base' Keyword - Calling Mom and Dad -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-3 me-2"></i>Part 3: The 'base' Keyword - Calling Mom and Dad</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-phone me-2"></i>
                                    <strong>What is 'base'?</strong> It's like calling your parents when you need help!
                                    The 'base' keyword lets you call the parent's constructor or methods.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Calling Parent Constructor</h5>
                                                <p>When you create a child, the parent <strong>must be built first</strong>:</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name;
    
    <span class="keyword">public</span> <span class="function">Animal</span>(<span class="keyword">string</span> name)
    {
        Name = name;
        Console.WriteLine(<span class="string">"🐾 Animal created!"</span>);
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Breed;
    
    <span class="keyword">public</span> <span class="function">Dog</span>(<span class="keyword">string</span> name, <span class="keyword">string</span> breed) 
        : <span class="function">base</span>(name)  <span class="comment">// 👈 Calls parent first!</span>
    {
        Breed = breed;
        Console.WriteLine(<span class="string">"🐕 Dog created!"</span>);
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-success">Output:</span> "🐾 Animal created!" then "🐕 Dog created!"</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Calling Parent Methods</h5>
                                                <p>You can also call parent methods:</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Animal makes a sound"</span>);
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        <span class="function">base</span>.<span class="function">MakeSound</span>();  <span class="comment">// 👈 First, do parent's thing</span>
        Console.WriteLine(<span class="string">"Dog barks: Woof!"</span>);  <span class="comment">// Then add extra</span>
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-info">🔑</span> <code>base.MakeSound()</code> runs the parent's version first!</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Joke Time:</strong>
                                        Why did the child class call 'base'? Because it needed its parent's permission!
                                        (I know, I know... I'll stick to coding 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🎯 Part 4: Virtual and Override - Changing How Things Work -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>Part 4: Virtual and Override - Changing the Rules</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">Sometimes, children want to <strong>change</strong> how they do things. That's where <code>virtual</code> and <code>override</code> come in!</p>

                                <div class="row">
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-check-circle fa-2x text-primary"></i>
                                                <h5 class="mt-2">virtual</h5>
                                                <p><strong>Parent says:</strong> "You can change this if you want"</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">Speak</span>()
{
    Console.WriteLine(<span class="string">"I speak..."</span>);
}</code></pre>
                                                </div>
                                                <small class="text-muted">Parent gives permission</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-edit fa-2x text-success"></i>
                                                <h5 class="mt-2">override</h5>
                                                <p><strong>Child says:</strong> "I'm changing this!"</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">Speak</span>()
{
    Console.WriteLine(<span class="string">"I bark!"</span>);
}</code></pre>
                                                </div>
                                                <small class="text-muted">Child changes the behavior</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-question-circle fa-2x text-warning"></i>
                                                <h5 class="mt-2">Why Do This?</h5>
                                                <ul class="text-start">
                                                    <li>✅ Make animals <strong>sound</strong> different</li>
                                                    <li>✅ Make each car <strong>start</strong> differently</li>
                                                    <li>✅ Customize behavior <strong>without</strong> changing parent</li>
                                                </ul>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="class">Dog</span> d = <span class="keyword">new</span> <span class="class">Dog</span>();
d.<span class="function">Speak</span>();  <span class="comment">// "I bark!"</span></code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-light mt-3">
                                    <div class="card-body">
                                        <h5><i class="fas fa-example text-primary me-2"></i>🔄 Real Example</h5>
                                        <div class="code-block small">
                                            <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Sound!"</span>);
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Cat</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Meow!"</span>);
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Cow</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Moo!"</span>);
    }
}</code></pre>
                                        </div>
                                        <p class="mt-2"><span class="badge bg-success">🎉</span> Each animal makes its own sound!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔒 Part 5: Protected - The Family Secret -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-5 me-2"></i>Part 5: Protected - The Family Secret</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-shield-alt text-primary me-2"></i>🛡️ What is Protected?</h5>
                                                <p><strong>Protected</strong> means "Only me and my children can see this."</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Person</span>
{
    <span class="keyword">protected</span> <span class="keyword">string</span> SSN;  <span class="comment">// Family secret</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Name;     <span class="comment">// Everyone knows</span>
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>✅ Child Can See It</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Employee</span> : <span class="class">Person</span>
{
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">ShowSSN</span>()
    {
        Console.WriteLine(SSN);  <span class="comment">// ✅ Allowed! (Child can see)</span>
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-info">🔑</span> Children can access <strong>protected</strong> members</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-globe fa-2x text-primary"></i>
                                                <h5 class="mt-2">public</h5>
                                                <p>🌍 Everyone</p>
                                                <small>Like your name</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-users fa-2x text-warning"></i>
                                                <h5 class="mt-2">protected</h5>
                                                <p>👨‍👩‍👧‍👦 Family Only</p>
                                                <small>Like a family recipe</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-lock fa-2x text-danger"></i>
                                                <h5 class="mt-2">private</h5>
                                                <p>🔒 Just You</p>
                                                <small>Like your password</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🏗️ Part 6: Building a Family Tree (Hierarchy) -->
                    <section class="mb-5" data-aos="fade-up">
