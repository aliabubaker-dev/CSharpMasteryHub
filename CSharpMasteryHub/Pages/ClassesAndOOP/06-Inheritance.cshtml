<span class="comment">// This is a complete character system for a video game</span>
<span class="comment">// It shows how inheritance helps organize game code</span>

<span class="comment">// Base Character - The common traits all characters share</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Character</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">int</span> Health { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Character</span>(<span class="keyword">string</span> name, <span class="keyword">int</span> health)
    {
        Name = name;
        Health = health;
    }
    
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">Attack</span>()
    {
        Console.WriteLine(<span class="string">$"{Name} attacks!"</span>);
    }
}

<span class="comment">// Warrior - A powerful melee fighter</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Warrior</span> : <span class="class">Character</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Weapon { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Warrior</span>(<span class="keyword">string</span> name, <span class="keyword">int</span> health, <span class="keyword">string</span> weapon) 
        : <span class="function">base</span>(name, health)
    {
        Weapon = weapon;
    }
    
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">Attack</span>()
    {
        Console.WriteLine(<span class="string">$"⚔️ {Name} swings {Weapon}!"</span>);
    }
}

<span class="comment">// Mage - A powerful spell caster</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Mage</span> : <span class="class">Character</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Spell { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Mage</span>(<span class="keyword">string</span> name, <span class="keyword">int</span> health, <span class="keyword">string</span> spell) 
        : <span class="function">base</span>(name, health)
    {
        Spell = spell;
    }
    
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">Attack</span>()
    {
        Console.WriteLine(<span class="string">$"🔮 {Name} casts {Spell}!"</span>);
    }
}

<span class="comment">// Archer - A ranged combat specialist</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Archer</span> : <span class="class">Character</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Bow { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Archer</span>(<span class="keyword">string</span> name, <span class="keyword">int</span> health, <span class="keyword">string</span> bow) 
        : <span class="function">base</span>(name, health)
    {
        Bow = bow;
