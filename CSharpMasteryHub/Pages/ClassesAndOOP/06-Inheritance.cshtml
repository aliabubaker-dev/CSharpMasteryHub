@page
@model InheritanceModel
@{
    ViewData["Title"] = "Inheritance in C#";
}

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.8);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/ClassesAndOOP" style="color: rgba(255,255,255,0.8);">Classes and OOP</a></li>
                            <li class="breadcrumb-item active" style="color: white;">Inheritance</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                        Inheritance
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Reusing Code Like a Family Tree
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-graduation-cap me-2"></i>Intermediate
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>25 min read
                        </span>
                        <span class="badge bg-primary fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 6 of 11
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left">
                    <i class="fas fa-sitemap fa-8x text-white" style="opacity: 0.3; text-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- Introduction -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-body p-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-rocket fa-3x text-primary"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">Passing Down Properties Like a Family</h2>
                                    <p class="fs-5">
                                        In previous lessons, we learned about classes and encapsulation. Now let's learn
                                        <strong>how to reuse code</strong> using <strong class="text-success">Inheritance</strong>!
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Think of it like a family:</strong>
                                        <ul class="mb-0">
                                            <li><strong>Parent Class</strong> = The parent (passes down traits)</li>
                                            <li><strong>Child Class</strong> = The child (inherits traits from parent)</li>
                                            <li>Children <strong>inherit</strong> everything from their parents</li>
                                            <li>Children can also <strong>add</strong> their own unique traits</li>
                                        </ul>
                                    </div>
                                    <p class="mt-3">
                                        <strong>Why is inheritance useful?</strong> It lets you <strong>reuse code</strong>,
                                        <strong>save time</strong>, and create <strong>organized</strong> programs.
                                        You write code once in the parent, and all children get it automatically!
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 1: What is Inheritance? -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-1 me-2"></i>Step 1: What is Inheritance?</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Inheritance</strong> is when one class gets all the properties and methods from another class.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Parent Class (Base)</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">int</span> Age { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Eat</span>()
    {
        Console.WriteLine(<span class="string">$"{Name} is eating..."</span>);
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">Parent</span> Passes down traits</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>Child Class (Derived)</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>  <span class="comment">// : means inherits</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Breed { <span class="function">get</span>; <span class="function">set</span>; }  <span class="comment">// Own trait</span>
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Bark</span>()
    {
        Console.WriteLine(<span class="string">$"{Name} says Woof!"</span>);
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-success">Child</span> Gets everything from parent + own traits</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Result:</strong> Dog has <strong>Name</strong>, <strong>Age</strong>, <strong>Eat()</strong> (inherited)
                                    AND <strong>Breed</strong>, <strong>Bark()</strong> (its own)!
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Step 2: The "is-a" Relationship -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-2 me-2"></i>Step 2: The "is-a" Relationship</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">Inheritance means the child <strong>IS A</strong> type of the parent.</p>

                                <div class="row g-3">
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-dog fa-3x text-primary"></i>
                                                <h5 class="mt-2">Dog</h5>
                                                <p class="text-success">IS A</p>
                                                <i class="fas fa-paw fa-2x text-warning"></i>
                                                <h5>Animal</h5>
                                                <small class="text-muted">A dog is a type of animal</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-car fa-3x text-primary"></i>
                                                <h5 class="mt-2">Car</h5>
                                                <p class="text-success">IS A</p>
                                                <i class="fas fa-truck fa-2x text-warning"></i>
                                                <h5>Vehicle</h5>
                                                <small class="text-muted">A car is a type of vehicle</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-user-tie fa-3x text-primary"></i>
                                                <h5 class="mt-2">Manager</h5>
                                                <p class="text-success">IS A</p>
                                                <i class="fas fa-user fa-2x text-warning"></i>
                                                <h5>Employee</h5>
                                                <small class="text-muted">A manager is a type of employee</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-warning mt-3">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Remember:</strong> If you can say "X IS A Y", then inheritance makes sense!
                                    <br>
                                    Example: "A Dog IS AN Animal" ✅ | "A Dog IS A Car" ❌
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Step 3: Base Keyword - Calling the Parent -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-3 me-2"></i>Step 3: The 'base' Keyword - Calling the Parent</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">The <strong>base</strong> keyword lets you call the parent's constructor or methods.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Parent Constructor</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Animal</span>(<span class="keyword">string</span> name)
    {
        Name = name;
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-link text-success me-2"></i>Child Uses 'base'</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Breed { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Dog</span>(<span class="keyword">string</span> name, <span class="keyword">string</span> breed) 
        : <span class="function">base</span>(name)  <span class="comment">// ✅ Calls parent constructor</span>
    {
        Breed = breed;
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-lightbulb me-2"></i>
                                    <strong>Why use base?</strong> It makes sure the parent is properly set up before the child adds its own data.
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Step 4: Virtual and Override -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>Step 4: Virtual & Override - Changing Behavior</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Virtual</strong> allows a child to <strong>override</strong> (change) the parent's method.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Parent with Virtual</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Animal makes a sound"</span>);
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-info">virtual</span> Means child can change this</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>Child with Override</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Dog barks: Woof!"</span>);
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-success">override</span> Changes the parent's method</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-play text-primary me-2"></i>What Happens?</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="class">Animal</span> a = <span class="keyword">new</span> <span class="class">Animal</span>();
a.<span class="function">MakeSound</span>();  <span class="comment">// "Animal makes a sound"</span>

<span class="class">Dog</span> d = <span class="keyword">new</span> <span class="class">Dog</span>();
d.<span class="function">MakeSound</span>();  <span class="comment">// "Dog barks: Woof!"</span></code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-exclamation-triangle text-warning me-2"></i>Key Points</h5>
                                                <ul>
                                                    <li>✅ <strong>virtual</strong> = "You can change me"</li>
                                                    <li>✅ <strong>override</strong> = "I'm changing you"</li>
                                                    <li>✅ Child can <strong>change</strong> parent's behavior</li>
                                                    <li>✅ Child can also use <code>base.MakeSound()</code></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Step 5: Protected Members -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-5 me-2"></i>Step 5: Protected - Family Only</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Protected</strong> means only the class and its children can access it.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Parent with Protected</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Person</span>
{
    <span class="keyword">protected</span> <span class="keyword">string</span> SSN;  <span class="comment">// ✅ Family only</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-warning text-dark">protected</span> Like a family secret</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>Child Can Access</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Employee</span> : <span class="class">Person</span>
{
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">ShowSSN</span>()
    {
        Console.WriteLine(SSN);  <span class="comment">// ✅ Can access protected!</span>
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-success">Child</span> Can see protected members</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Access Levels Summary:</strong>
                                    <ul>
                                        <li><strong>public</strong> = Everyone</li>
                                        <li><strong>private</strong> = Only this class</li>
                                        <li><strong>protected</strong> = This class + children</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Step 6: Inheritance Hierarchy -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-6 me-2"></i>Step 6: Inheritance Hierarchy (Family Tree)</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">You can create a <strong>chain</strong> of inheritance - like a family tree!</p>

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h5>Animal Kingdom Hierarchy</h5>
                                                <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">
                                                    <div class="p-3 bg-primary text-white rounded">
                                                        <strong>Animal</strong> (Parent)
                                                    </div>
                                                    <i class="fas fa-arrow-down fa-2x"></i>
                                                    <div class="d-flex gap-3 flex-wrap">
                                                        <div class="p-3 bg-success text-white rounded">
                                                            <strong>Mammal</strong>
                                                        </div>
                                                        <div class="p-3 bg-warning text-dark rounded">
                                                            <strong>Bird</strong>
                                                        </div>
                                                        <div class="p-3 bg-info text-white rounded">
                                                            <strong>Fish</strong>
                                                        </div>
                                                    </div>
                                                    <i class="fas fa-arrow-down fa-2x"></i>
                                                    <div class="d-flex gap-3 flex-wrap">
                                                        <div class="p-3 bg-secondary text-white rounded">
                                                            <strong>Dog</strong>
                                                        </div>
                                                        <div class="p-3 bg-secondary text-white rounded">
                                                            <strong>Cat</strong>
                                                        </div>
                                                        <div class="p-3 bg-secondary text-white rounded">
                                                            <strong>Eagle</strong>
                                                        </div>
                                                        <div class="p-3 bg-secondary text-white rounded">
                                                            <strong>Salmon</strong>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Example Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span> { <span class="keyword">public</span> <span class="keyword">string</span> Name; }
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Mammal</span> : <span class="class">Animal</span> { <span class="keyword">public</span> <span class="keyword">int</span> Legs; }
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Mammal</span> { <span class="keyword">public</span> <span class="keyword">string</span> Breed; }</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>What Dog Inherits</h5>
                                                <ul>
                                                    <li>✅ <strong>From Animal:</strong> Name</li>
                                                    <li>✅ <strong>From Mammal:</strong> Legs</li>
                                                    <li>✅ <strong>Its own:</strong> Breed</li>
                                                </ul>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="class">Dog</span> d = <span class="keyword">new</span> <span class="class">Dog</span>();
d.Name = <span class="string">"Rex"</span>;   <span class="comment">// From Animal</span>
d.Legs = <span class="number">4</span>;      <span class="comment">// From Mammal</span>
d.Breed = <span class="string">"Lab"</span>;  <span class="comment">// Own</span></code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Step 7: Sealed Classes -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-7 me-2"></i>Step 7: Sealed Classes - The End of the Line</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Sealed</strong> classes cannot be inherited. They are the final class in the hierarchy.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Sealed Class</h5>
                                                <div class="code-block small">
