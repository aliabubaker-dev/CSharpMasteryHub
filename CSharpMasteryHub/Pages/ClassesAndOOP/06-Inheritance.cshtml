        <span class="class">Developer</span> dev = <span class="keyword">new</span> <span class="class">Developer</span>(<span class="string">"Bob"</span>, <span class="number">60000</span>, <span class="string">"C#"</span>);
        
        emp.<span class="function">Work</span>();  <span class="comment">// "John is working..."</span>
