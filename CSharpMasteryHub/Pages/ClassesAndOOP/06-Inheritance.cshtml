@page
@model InheritanceModel
@{
    ViewData["Title"] = "Inheritance in C# - Master Guide";
}

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.8);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/ClassesAndOOP" style="color: rgba(255,255,255,0.8);">Classes and OOP</a></li>
                            <li class="breadcrumb-item active" style="color: white;">Inheritance</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                        Inheritance Master Guide
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Become a Master of Code Reuse and Hierarchy
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-graduation-cap me-2"></i>Intermediate to Advanced
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>35 min read
                        </span>
                        <span class="badge bg-primary fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 6 of 11
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left">
                    <i class="fas fa-sitemap fa-8x text-white" style="opacity: 0.3; text-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- Introduction -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-body p-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-rocket fa-3x text-primary"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">The Foundation of Code Reuse</h2>
                                    <p class="fs-5">
                                        <strong>Inheritance</strong> is one of the most powerful features in C#.
                                        It allows you to create a <strong>hierarchy</strong> of classes where children
                                        <strong>inherit</strong> everything from their parents.
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Real-World Analogy:</strong>
                                        <ul class="mb-0">
                                            <li><strong>Parent Class</strong> = A blueprint for "Vehicle" (has wheels, engine, can move)</li>
                                            <li><strong>Child Class</strong> = "Car" (inherits everything from Vehicle, adds doors, radio)</li>
                                            <li><strong>Grandchild</strong> = "SportsCar" (inherits from Car, adds turbo, spoiler)</li>
                                            <li>Each level <strong>adds</strong> more specific features</li>
                                        </ul>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-4">
                                            <div class="card bg-white">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-tools fa-2x text-primary"></i>
                                                    <h6>Code Reuse</h6>
                                                    <small>Write once, use many times</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card bg-white">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-sitemap fa-2x text-success"></i>
                                                    <h6>Organization</h6>
                                                    <small>Logical class hierarchy</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card bg-white">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-expand fa-2x text-warning"></i>
                                                    <h6>Extensibility</h6>
                                                    <small>Easy to add new features</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Part 1: Understanding Inheritance Deeply -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-1 me-2"></i>Part 1: Understanding Inheritance Deeply</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="card bg-light mb-3">
                                            <div class="card-body">
                                                <h5><i class="fas fa-question-circle text-primary me-2"></i>What Exactly is Inheritance?</h5>
                                                <p>Inheritance is a mechanism where a <strong>child class</strong> receives all the members (fields, properties, methods) from its <strong>parent class</strong>. The child can then:</p>
                                                <ul>
                                                    <li>✅ <strong>Use</strong> everything from the parent (reuse code)</li>
                                                    <li>✅ <strong>Add</strong> its own new members</li>
                                                    <li>✅ <strong>Override</strong> (change) parent's behavior</li>
                                                    <li>✅ <strong>Extend</strong> the parent's functionality</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Parent Class (Base)</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">int</span> Age { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Eat</span>() 
    { 
        Console.WriteLine(<span class="string">$"{Name} is eating"</span>); 
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Sleep</span>() 
    { 
        Console.WriteLine(<span class="string">$"{Name} is sleeping"</span>); 
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">Parent</span> Has 4 members: Name, Age, Eat(), Sleep()</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>Child Class</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>  <span class="comment">// Inherits from Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Breed { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Bark</span>() 
    { 
        Console.WriteLine(<span class="string">$"{Name} says Woof!"</span>); 
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Fetch</span>() 
    { 
        Console.WriteLine(<span class="string">$"{Name} is fetching!"</span>); 
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-success">Child</span> Has 6 members: Inherits 4 + adds 2 new ones!</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Key Insight:</strong> The Dog class automatically has <strong>Name</strong>, <strong>Age</strong>,
                                    <strong>Eat()</strong>, and <strong>Sleep()</strong> without writing any code for them!
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Part 2: The 'base' Keyword - Calling the Parent -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-2 me-2"></i>Part 2: The 'base' Keyword - Parent Connection</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">The <strong>base</strong> keyword is like a phone line to your parent class. It lets you:</p>
                                <ul>
                                    <li>✅ Call the <strong>parent's constructor</strong> (initialize parent data)</li>
                                    <li>✅ Call the <strong>parent's methods</strong> (reuse parent logic)</li>
                                    <li>✅ Access <strong>protected</strong> members</li>
                                </ul>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Calling Parent Constructor</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">int</span> Age { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Animal</span>(<span class="keyword">string</span> name, <span class="keyword">int</span> age)
    {
        Name = name;
        Age = age;
        Console.WriteLine(<span class="string">"Animal created"</span>);
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Breed { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Dog</span>(<span class="keyword">string</span> name, <span class="keyword">int</span> age, <span class="keyword">string</span> breed) 
        : <span class="function">base</span>(name, age)  <span class="comment">// ✅ Parent constructor runs first</span>
    {
        Breed = breed;
        Console.WriteLine(<span class="string">"Dog created"</span>);
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-play text-success me-2"></i>What Happens</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="class">Dog</span> dog = <span class="keyword">new</span> <span class="class">Dog</span>(<span class="string">"Rex"</span>, <span class="number">3</span>, <span class="string">"Lab"</span>);

<span class="comment">// Output:</span>
<span class="comment">// "Animal created"  ← Parent constructor</span>
<span class="comment">// "Dog created"     ← Child constructor</span></code></pre>
                                                </div>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-lightbulb me-2"></i>
                                                    <strong>Why this matters:</strong> The parent must be properly initialized before the child adds its own data.
                                                    Like building a house - you need the foundation (parent) before adding the roof (child)!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-lg-12">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-link text-warning me-2"></i>Using 'base' to Call Parent Methods</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        Console.WriteLine(<span class="string">"Animal makes a sound"</span>);
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Dog</span> : <span class="class">Animal</span>
{
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">MakeSound</span>()
    {
        <span class="function">base</span>.<span class="function">MakeSound</span>();  <span class="comment">// ✅ First, do parent's version</span>
        Console.WriteLine(<span class="string">"Dog barks: Woof!"</span>);  <span class="comment">// Then add extra</span>
    }
}</code></pre>
                                                </div>
                                                <p class="mt-2"><span class="badge bg-info">base.MakeSound()</span> Let's you reuse parent logic before adding your own</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Part 3: Virtual, Override, and New -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-3 me-2"></i>Part 3: Virtual, Override, and New - Method Behavior Control</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5">C# gives you three ways to control how methods behave in inheritance:</p>

                                <div class="row g-3">
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-check-circle fa-2x text-primary"></i>
                                                <h5 class="mt-2">virtual</h5>
                                                <p><strong>Parent says:</strong> "You can change me"</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">Start</span>()
{
    Console.WriteLine(<span class="string">"Starting..."</span>);
}</code></pre>
                                                </div>
                                                <small class="text-muted">✅ Parent allows change</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-edit fa-2x text-success"></i>
                                                <h5 class="mt-2">override</h5>
                                                <p><strong>Child says:</strong> "I'm changing you"</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">Start</span>()
{
    Console.WriteLine(<span class="string">"Car starts..."</span>);
}</code></pre>
                                                </div>
                                                <small class="text-muted">✅ Child changes behavior</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fas fa-plus-circle fa-2x text-warning"></i>
                                                <h5 class="mt-2">new</h5>
                                                <p><strong>Child says:</strong> "I'll do my own thing"</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">new</span> <span class="keyword">void</span> <span class="function">Start</span>()
{
    Console.WriteLine(<span class="string">"New way..."</span>);
}</code></pre>
                                                </div>
                                                <small class="text-muted">🔨 Child hides parent version</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>When to use each:</strong>
                                    <ul>
                                        <li><strong>virtual</strong> - When you want children to be able to change behavior</li>
                                        <li><strong>override</strong> - When you want to completely change parent's behavior</li>
                                        <li><strong>new</strong> - When you want to hide parent's version (rarely used)</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Part 4: Abstract Classes -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>Part 4: Abstract Classes - Blueprint for Children</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Abstract classes</strong> are incomplete classes that cannot be instantiated. They serve as a <strong>template</strong> for other classes.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Abstract Class</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">abstract</span> <span class="keyword">class</span> <span class="class">Shape</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Color { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="comment">// Abstract method - no body</span>
    <span class="keyword">public</span> <span class="keyword">abstract</span> <span class="keyword">double</span> <span class="function">GetArea</span>();
    
    <span class="comment">// Regular method - has body</span>
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">DisplayColor</span>()
    {
        Console.WriteLine(<span class="string">$"Color: {Color}"</span>);
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>Child Must Implement</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Circle</span> : <span class="class">Shape</span>
{
    <span class="keyword">public</span> <span class="keyword">double</span> Radius { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">double</span> <span class="function">GetArea</span>()
    {
        <span class="keyword">return</span> Math.PI * Radius * Radius;
    }
}

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Rectangle</span> : <span class="class">Shape</span>
{
    <span class="keyword">public</span> <span class="keyword">double</span> Width { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">double</span> Height { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">double</span> <span class="function">GetArea</span>()
    {
        <span class="keyword">return</span> Width * Height;
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-warning mt-3">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Important Rules:</strong>
                                    <ul>
                                        <li>❌ Cannot create an instance of an abstract class: <code>new Shape()</code> is illegal</li>
                                        <li>✅ Abstract methods MUST be implemented by children (like a contract)</li>
                                        <li>✅ Abstract classes can have regular methods too (with bodies)</li>
                                        <li>✅ Children can add their own properties and methods</li>
                                    </ul>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Real-World Example:</strong> "Shape" is abstract - you can't create just a "Shape".
                                        But you CAN create a "Circle", "Rectangle", or "Triangle" which are all shapes.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Part 5: Protected Members -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-5 me-2"></i>Part 5: Protected Members - Family Access</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Protected</strong> is the perfect balance between private and public.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>Protected Example</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Person</span>
{
    <span class="keyword">protected</span> <span class="keyword">string</span> SSN { <span class="function">get</span>; <span class="function">set</span>; }  <span class="comment">// Only family</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }       <span class="comment">// Everyone</span>
    <span class="keyword">private</span> <span class="keyword">string</span> Password { <span class="function">get</span>; <span class="function">set</span>; }  <span class="comment">// Only this class</span>
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>Child Can Access</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Employee</span> : <span class="class">Person</span>
{
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">ShowInfo</span>()
    {
