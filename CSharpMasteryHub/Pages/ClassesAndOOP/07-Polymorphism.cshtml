    ViewData["Title"] = "Polymorphism in C# - Learn Like a Pro (The Easy Way)";
}

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container">
            <div class="row align-items-center">
