<span class="comment">// Truck - Weight-based rental</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Truck</span> : <span class="class">Vehicle</span>
{
    <span class="keyword">public</span> <span class="keyword">decimal</span> WeightRate { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">double</span> Weight { <span class="function">get</span>; <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">Truck</span>(<span class="keyword">string</span> model, <span class="keyword">int</span> year, <span class="keyword">int</span> days, 
