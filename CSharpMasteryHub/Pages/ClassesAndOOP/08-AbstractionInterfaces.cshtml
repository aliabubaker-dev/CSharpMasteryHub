        Console.WriteLine(<span class="string">$"🌡️ {Name} temperature set to {Temperature}°C"</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">override</span> <span class="keyword">void</span> <span class="function">DisplayInfo</span>()
    {
        Console.WriteLine(<span class="string">$"🌡️ {Name}: {Status} (Temperature: {Temperature}°C)"</span>);
    }
}

<span class="comment">// SecurityCamera - Can record</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">SecurityCamera</span> : <span class="class">SmartDevice</span>
{
    <span class="keyword">public</span> <span class="keyword">bool</span> IsRecording { <span class="function">get</span>; <span class="keyword">private</span> <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">SecurityCamera</span>(<span class="keyword">string</span> name) : <span class="function">base</span>(name)
    {
        IsRecording = <span class="keyword">false</span>;
    }
    
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">StartRecording</span>()
    {
