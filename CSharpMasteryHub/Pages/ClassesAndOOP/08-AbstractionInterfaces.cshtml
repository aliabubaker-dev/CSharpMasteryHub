<span class="comment">// Abstract Class - Common code for all devices</span>
<span class="keyword">public</span> <span class="keyword">abstract</span> <span class="keyword">class</span> <span class="class">SmartDevice</span> : <span class="class">IDevice</span>
{
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">string</span> Status { <span class="function">get</span>; <span class="keyword">protected</span> <span class="function">set</span>; }
    
    <span class="keyword">public</span> <span class="function">SmartDevice</span>(<span class="keyword">string</span> name)
    {
        Name = name;
        Status = <span class="string">"Off"</span>;
    }
    
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">TurnOn</span>()
    {
        Status = <span class="string">"On"</span>;
        Console.WriteLine(<span class="string">$"🟢 {Name} turned ON"</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">TurnOff</span>()
    {
        Status = <span class="string">"Off"</span>;
        Console.WriteLine(<span class="string">$"🔴 {Name} turned OFF"</span>);
    }
    
    <span class="keyword">public</span> <span class="keyword">virtual</span> <span class="keyword">void</span> <span class="function">DisplayInfo</span>()
    {
        Console.WriteLine(<span class="string">$"📱 {Name}: {Status}"</span>);
    }
}

<span class="comment">// Light - Can adjust brightness</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Light</span> : <span class="class">SmartDevice</span>
