    <span class="comment">// 🟢 INSTANCE MEMBERS - Belongs to each product</span>
    <span class="keyword">public</span> <span class="keyword">int</span> Id { <span class="function">get</span>; <span class="keyword">private</span> <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">decimal</span> Price { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">int</span> Quantity { <span class="function">get</span>; <span class="keyword">private</span> <span class="function">set</span>; }
    
    <span class="comment">// 🔵 Static method - shared functionality</span>
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">int</span> <span class="function">GetTotalProducts</span>() => totalProducts;
    
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">ResetInventory</span>()
    {
        totalProducts = <span class="number">0</span>;
        nextId = <span class="number">1000</span>;
        Console.WriteLine(<span class="string">"🔄 Inventory reset!"</span>);
    }
    
    <span class="comment">// 🟢 Constructor - creates new product</span>
    <span class="keyword">public</span> <span class="function">Product</span>(<span class="keyword">string</span> name, <span class="keyword">decimal</span> price, <span class="keyword">int</span> quantity)
    {
        Name = name;
        Price = price;
        Quantity = quantity;
        Id = <span class="function">GenerateId</span>();
        totalProducts++;
