                                            <pre><code class="language-csharp">    <span class="comment">// Private static method</span>
    <span class="keyword">private</span> <span class="keyword">static</span> <span class="keyword">string</span> <span class="function">GenerateAccountNumber</span>()
    {
        <span class="keyword">return</span> <span class="string">$"ACC-{DateTime.Now.Year}-{totalAccounts + 1:D4}"</span>;
