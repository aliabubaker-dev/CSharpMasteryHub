    <span class="keyword">private</span> <span class="keyword">static</span> <span class="keyword">int</span> totalAccounts = <span class="number">0</span>;
    <span class="keyword">private</span> <span class="keyword">static</span> <span class="keyword">double</span> interestRate = <span class="number">0.05</span>;
    
    <span class="comment">// 🟢 INSTANCE - Belongs to each account</span>
    <span class="keyword">public</span> <span class="keyword">string</span> AccountNumber { <span class="function">get</span>; <span class="keyword">private</span> <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">string</span> Owner { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">decimal</span> Balance { <span class="function">get</span>; <span class="keyword">private</span> <span class="function">set</span>; }
    
    <span class="comment">// Static method - shared functionality</span>
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">int</span> <span class="function">GetTotalAccounts</span>() => totalAccounts;
    
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">SetInterestRate</span>(<span class="keyword">double</span> rate)
    {
        <span class="keyword">if</span> (rate >= <span class="number">0</span>) interestRate = rate;
    }
    
    <span class="comment">// Constructor - creates new account</span>
    <span class="keyword">public</span> <span class="function">Bank</span>(<span class="keyword">string</span> owner, <span class="keyword">decimal</span> initial)
    {
        Owner = owner;
        Balance = initial;
        AccountNumber = <span class="function">GenerateAccountNumber</span>();
        totalAccounts++;
    }</code></pre>
