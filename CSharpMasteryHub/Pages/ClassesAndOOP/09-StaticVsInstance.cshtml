@page
@model StaticVsInstanceModel
@{
    ViewData["Title"] = "Static vs Instance Members - Learn Like a Pro";
}

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.8);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/ClassesAndOOP" style="color: rgba(255,255,255,0.8);">Classes and OOP</a></li>
                            <li class="breadcrumb-item active" style="color: white;">Static vs Instance</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                        Static vs Instance ⚡
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Shared vs Personal - What Belongs to Everyone vs Each Person?
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-success fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-smile me-2"></i>Beginner Friendly
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>20 min read
                        </span>
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 9 of 11
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left">
                    <i class="fas fa-users fa-8x text-white" style="opacity: 0.3; text-shadow: 2px 2px 4px rgba(0,0,0,0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- 🎉 Welcome Section -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-body p-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-smile-wink fa-3x text-warning"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">Hey There! Ready to Learn Static vs Instance? 🎯</h2>
                                    <p class="fs-5">
                                        <strong>Static</strong> and <strong>Instance</strong> are two types of members in C#.
                                        It's like the difference between <strong>something shared by everyone</strong> vs
                                        <strong>something that belongs to just one person</strong>.
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Quick Question:</strong> Think about a <strong>school</strong>!
                                        <ul class="mb-0 mt-2">
                                            <li>🏫 <strong>School Name</strong> is SHARED by everyone (static)</li>
                                            <li>👨‍🎓 <strong>Student Name</strong> belongs to each student (instance)</li>
                                        </ul>
                                    </div>
                                    <div class="mt-3">
                                        <span class="badge bg-primary p-2">🎯 After this lesson, you'll be able to:</span>
                                        <ul class="mt-2">
                                            <li>✅ Explain static vs instance like a pro</li>
                                            <li>✅ Use static members (shared stuff)</li>
                                            <li>✅ Use instance members (personal stuff)</li>
                                            <li>✅ Know when to use each</li>
                                            <li>✅ Build better, cleaner code</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 📚 Part 1: What's the Difference? (Super Simple) -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-1 me-2"></i>Part 1: What's the Difference? (The Easy Way)</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-users text-primary me-2"></i>👥 Static - Shared by Everyone</h5>
                                                <p><strong>Static</strong> members belong to the <strong>class itself</strong>, not to any specific object.</p>
                                                <ul>
                                                    <li>✅ <strong>One copy</strong> shared by all</li>
                                                    <li>✅ Accessed through the <strong>class name</strong></li>
                                                    <li>✅ Like a <strong>school name</strong> - everyone uses the same one</li>
                                                </ul>
                                                <div class="alert alert-primary mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Example:</strong> <code>Math.PI</code> - everyone uses the same Pi!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-user text-success me-2"></i>👤 Instance - Personal to Each</h5>
                                                <p><strong>Instance</strong> members belong to <strong>each object</strong> individually.</p>
                                                <ul>
                                                    <li>✅ <strong>Separate copies</strong> for each object</li>
                                                    <li>✅ Accessed through an <strong>object variable</strong></li>
                                                    <li>✅ Like a <strong>student name</strong> - each student has their own</li>
                                                </ul>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Example:</strong> <code>person.Name</code> - each person has their own name!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Remember:</strong>
                                        <ul class="mb-0">
                                            <li><strong>Static</strong> = <strong>Class</strong> level (one for all)</li>
                                            <li><strong>Instance</strong> = <strong>Object</strong> level (one per object)</li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Fun Joke:</strong> Why did the static method break up with the instance method?
                                        Because it couldn't handle the personal space! (Okay, I'll stop 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🧩 Part 2: Instance Members - Personal Stuff -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-2 me-2"></i>Part 2: Instance Members - Personal Stuff</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Instance members</strong> are like <strong>personal belongings</strong> - each object has its own copy.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>📝 Instance Fields</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Person</span>
{
    <span class="comment">// Each person has their own Name and Age</span>
    <span class="keyword">public</span> <span class="keyword">string</span> Name { <span class="function">get</span>; <span class="function">set</span>; }
    <span class="keyword">public</span> <span class="keyword">int</span> Age { <span class="function">get</span>; <span class="function">set</span>; }
}</code></pre>
                                                </div>
                                                <p>Each <strong>Person</strong> object has its <strong>own</strong> Name and Age!</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>🎯 Using Instance Members</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Create two people</span>
<span class="class">Person</span> person1 = <span class="keyword">new</span> <span class="class">Person</span>();
person1.Name = <span class="string">"Alice"</span>;
person1.Age = <span class="number">25</span>;

<span class="class">Person</span> person2 = <span class="keyword">new</span> <span class="class">Person</span>();
person2.Name = <span class="string">"Bob"</span>;
person2.Age = <span class="number">30</span>;

<span class="comment">// Each has their own values!</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-success">✅</span> person1 and person2 have <strong>different</strong> values</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Key Point:</strong> You MUST create an object to use instance members!
                                    <br>
                                    <code>Person p = new Person();</code> → <code>p.Name</code> works ✅
                                    <br>
                                    <code>Person.Name</code> doesn't work ❌ (needs an object)
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🏢 Part 3: Static Members - Shared Stuff -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-3 me-2"></i>Part 3: Static Members - Shared Stuff</h3>
                            </div>
                            <div class="card-body p-4">
                                <p class="fs-5"><strong>Static members</strong> are like <strong>shared resources</strong> - one copy for everyone.</p>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>📝 Static Fields</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">School</span>
{
    <span class="comment">// Shared by ALL students</span>
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">string</span> SchoolName = <span class="string">"C# Academy"</span>;
    
    <span class="comment">// Each student has their own</span>
    <span class="keyword">public</span> <span class="keyword">string</span> StudentName { <span class="function">get</span>; <span class="function">set</span>; }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-info">One SchoolName</span> for ALL students!</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>🎯 Using Static Members</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// ✅ Access through class name</span>
Console.WriteLine(<span class="class">School</span>.SchoolName);  <span class="comment">// "C# Academy"</span>

<span class="comment">// ❌ Can't access through object</span>
<span class="class">School</span> s = <span class="keyword">new</span> <span class="class">School</span>();
<span class="comment">// s.SchoolName doesn't work!</span></code></pre>
                                                </div>
                                                <div class="alert alert-warning mt-2">
                                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                                    <strong>Remember:</strong> Static members use the <strong>class name</strong>, not an object!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-light mt-3">
                                    <div class="card-body">
                                        <h5><i class="fas fa-question-circle text-primary me-2"></i>📊 Static vs Instance - Visual Comparison</h5>
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <thead class="table-primary">
                                                    <tr>
                                                        <th>Feature</th>
                                                        <th>Static</th>
                                                        <th>Instance</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><strong>Belongs to</strong></td>
                                                        <td>Class</td>
                                                        <td>Object</td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>How many copies</strong></td>
                                                        <td>One (shared)</td>
                                                        <td>Many (one per object)</td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>How to access</strong></td>
                                                        <td><code>ClassName.Member</code></td>
                                                        <td><code>object.Member</code></td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Example</strong></td>
                                                        <td><code>Math.PI</code></td>
                                                        <td><code>person.Name</code></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔧 Part 4: Static Methods -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>Part 4: Static Methods - Utility Functions</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>📝 Static Method Example</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">MathHelper</span>
{
    <span class="comment">// Static method - no object needed</span>
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">int</span> <span class="function">Add</span>(<span class="keyword">int</span> a, <span class="keyword">int</span> b)
    {
        <span class="keyword">return</span> a + b;
    }
    
    <span class="comment">// Instance method - needs an object</span>
    <span class="keyword">private</span> <span class="keyword">int</span> result;
    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">AddToResult</span>(<span class="keyword">int</span> value)
    {
        result += value;
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-play text-success me-2"></i>🎯 Using Static Methods</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// ✅ No object needed!</span>
<span class="keyword">int</span> sum = <span class="class">MathHelper</span>.<span class="function">Add</span>(<span class="number">5</span>, <span class="number">3</span>);
Console.WriteLine(sum);  <span class="comment">// 8</span>

<span class="comment">// ❌ Need an object for instance method</span>
<span class="class">MathHelper</span> helper = <span class="keyword">new</span> <span class="class">MathHelper</span>();
helper.<span class="function">AddToResult</span>(<span class="number">10</span>);</code></pre>
                                                </div>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>When to use static methods:</strong>
                                                    <ul class="mb-0">
                                                        <li>✅ Utility functions (like <code>Math.Sqrt()</code>)</li>
                                                        <li>✅ No object data needed</li>
                                                        <li>✅ Helper methods</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🏗️ Part 5: Static Constructor -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-5 me-2"></i>Part 5: Static Constructor - One-Time Setup</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-clock me-2"></i>
                                    <strong>What's a Static Constructor?</strong> It runs <strong>ONCE</strong> when the class is first used.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>📝 Static Constructor</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Config</span>
{
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">string</span> AppName;
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">string</span> Version;
    
    <span class="comment">// Runs ONCE when class is first used</span>
    <span class="keyword">static</span> <span class="function">Config</span>()
    {
        AppName = <span class="string">"MyApp"</span>;
        Version = <span class="string">"1.0.0"</span>;
        Console.WriteLine(<span class="string">"⚙️ Config loaded!"</span>);
    }
}</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-play text-success me-2"></i>🎯 When It Runs</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Static constructor runs HERE</span>
Console.WriteLine(<span class="class">Config</span>.AppName);  <span class="comment">// "MyApp"</span>

<span class="comment">// Static constructor already ran</span>
Console.WriteLine(<span class="class">Config</span>.Version);  <span class="comment">// "1.0.0"</span></code></pre>
                                                </div>
                                                <div class="alert alert-warning mt-2">
                                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                                    <strong>Key Points:</strong>
                                                    <ul class="mb-0">
                                                        <li>✅ Runs <strong>ONCE</strong> (not every time)</li>
                                                        <li>✅ No parameters allowed</li>
                                                        <li>✅ Used for <strong>one-time setup</strong></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🚫 Part 6: Static Classes -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-6 me-2"></i>Part 6: Static Classes - Pure Utility</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-box me-2"></i>
                                    <strong>What's a Static Class?</strong> A class that <strong>cannot be created</strong> - it's just a container for static members!
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>📝 Static Class</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">class</span> <span class="class">FileHelper</span>
{
    <span class="comment">// All members MUST be static</span>
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">WriteFile</span>(<span class="keyword">string</span> path)
    {
        Console.WriteLine(<span class="string">$"Writing to {path}"</span>);
    }
}</code></pre>
                                                </div>
                                                <p><span class="badge bg-danger">🚫</span> Cannot create <code>FileHelper</code> objects!</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>✅ Using Static Class</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// ✅ Use directly through class name</span>
<span class="class">FileHelper</span>.<span class="function">WriteFile</span>(<span class="string">"data.txt"</span>);

<span class="comment">// ❌ Can't do this:</span>
<span class="comment">// FileHelper helper = new FileHelper();</span></code></pre>
                                                </div>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>When to use static classes:</strong>
                                                    <ul class="mb-0">
                                                        <li>✅ <strong>Math</strong> - <code>Math.Sqrt()</code></li>
                                                        <li>✅ <strong>File helpers</strong> - <code>File.ReadAllText()</code></li>
                                                        <li>✅ <strong>Convert</strong> - <code>Convert.ToInt32()</code></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🌍 Part 7: Real-World Example - Bank System -->
                    <section class="mb-5" data-aos="fade-up">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-7 me-2"></i>Part 7: Real-World Example - Bank System 💰</h3>
                            </div>
                            <div class="card-body p-4">
