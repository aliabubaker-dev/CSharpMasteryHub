    <span class="keyword">public</span> <span class="keyword">bool</span> <span class="function">Withdraw</span>(<span class="keyword">decimal</span> amount)
    {
        <span class="keyword">if</span> (amount > <span class="number">0</span> &amp;&amp; amount <= Balance)
