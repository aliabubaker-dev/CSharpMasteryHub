                                            <pre><code class="language-csharp"><span class="comment">// Bank System - Static vs Instance</span>
<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">Bank</span>
{
    <span class="comment">// 🔵 STATIC - Shared by all accounts</span>
