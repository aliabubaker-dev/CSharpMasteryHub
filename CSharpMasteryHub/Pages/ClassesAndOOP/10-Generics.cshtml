        textCache.<span class="function">Add</span>(<span class="string">"name"</span>, <span class="string">"Alice"</span>);
        textCache.<span class="function">Add</span>(<span class="string">"city"</span>, <span class="string">"New York"</span>);
        
        <span class="comment">// 📦 Cache for products</span>
        <span class="class">Cache</span>&lt;<span class="class">Product</span>&gt; productCache = <span class="keyword">new</span> <span class="class">Cache</span>&lt;<span class="class">Product</span>&gt;();
        productCache.<span class="function">Add</span>(<span class="string">"laptop"</span>, <span class="keyword">new</span> <span class="class">Product</span> { Name = <span class="string">"Gaming Laptop"</span>, Price = <span class="number">999.99m</span> });
        
        Console.WriteLine();
        
        <span class="comment">// 🔍 Retrieve data</span>
        <span class="keyword">int</span> age = numCache.<span class="function">Get</span>(<span class="string">"age"</span>);
        <span class="keyword">string</span> name = textCache.<span class="function">Get</span>(<span class="string">"name"</span>);
        <span class="class">Product</span> laptop = productCache.<span class="function">Get</span>(<span class="string">"laptop"</span>);
        
        Console.WriteLine();
        
