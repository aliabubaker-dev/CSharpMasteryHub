    <span class="keyword">public</span> <span class="keyword">void</span> <span class="function">Return</span>() => IsAvailable = <span class="keyword">true</span>;
    <span class="keyword">public</span> <span class="keyword">abstract</span> <span class="keyword">void</span> <span class="function">Print</span>();
}</code></pre>
