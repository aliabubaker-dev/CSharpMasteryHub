                <h2>Introduction to File Handling</h2>
                <p>C# provides powerful file handling capabilities through the System.IO namespace. You can read, write, and manipulate files easily.</p>

                <h2>Basic File Operations</h2>

                <h3>Writing to a File</h3>
                <pre><code>using System.IO;

// Method 1: Using File.WriteAllText (overwrites file)
File.WriteAllText("example.txt", "Hello World!");

// Method 2: Using File.AppendAllText (adds to file)
File.AppendAllText("example.txt", "\nThis is appended text.");

// Method 3: Using StreamWriter
using (StreamWriter writer = new StreamWriter("example.txt"))
{
    writer.WriteLine("Line 1");
    writer.WriteLine("Line 2");
    writer.WriteLine("Line 3");
}</code></pre>

                <h3>Reading from a File</h3>
                <pre><code>// Method 1: Read all text at once
string content = File.ReadAllText("example.txt");
Console.WriteLine(content);

// Method 2: Read all lines into array
string[] lines = File.ReadAllLines("example.txt");
foreach (string line in lines)
    Console.WriteLine(line);

// Method 3: Using StreamReader
using (StreamReader reader = new StreamReader("example.txt"))
{
    string line;
    while ((line = reader.ReadLine()) != null)
        Console.WriteLine(line);
}</code></pre>
                @await Html.PartialAsync("_TryInDotnetFiddle", "Run this code")

                <h2>File Operations Example</h2>
                <pre><code>using System;
using System.IO;

class FileManager
{
    public static void CreateFile(string path, string content)
    {
        File.WriteAllText(path, content);
        Console.WriteLine($"File created: {path}");
    }
    
    public static void AppendToFile(string path, string content)
    {
        File.AppendAllText(path, content + "\n");
        Console.WriteLine($"Content appended to: {path}");
    }
    
    public static void ReadFile(string path)
    {
        if (File.Exists(path))
        {
            string content = File.ReadAllText(path);
            Console.WriteLine($"Content of {path}:");
            Console.WriteLine(content);
        }
        else
        {
            Console.WriteLine($"File not found: {path}");
        }
    }
    
    public static void CopyFile(string source, string destination)
    {
        if (File.Exists(source))
        {
            File.Copy(source, destination, true);
            Console.WriteLine($"File copied from {source} to {destination}");
        }
        else
        {
            Console.WriteLine($"Source file not found: {source}");
        }
    }
    
    public static void DeleteFile(string path)
    {
        if (File.Exists(path))
        {
            File.Delete(path);
            Console.WriteLine($"File deleted: {path}");
        }
        else
        {
            Console.WriteLine($"File not found: {path}");
        }
    }
}

class Program
{
    static void Main()
    {
        string filePath = "data.txt";
        
        // Create file
        FileManager.CreateFile(filePath, "This is the initial content.");
        
        // Append content
        FileManager.AppendToFile(filePath, "Appended line 1");
        FileManager.AppendToFile(filePath, "Appended line 2");
        
        // Read file
        FileManager.ReadFile(filePath);
        
        // Copy file
        FileManager.CopyFile(filePath, "backup.txt");
        
        // Delete file
        FileManager.DeleteFile("backup.txt");
    }
}</code></pre>
