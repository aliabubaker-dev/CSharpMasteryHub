                <h2>Working with Directories</h2>
                <pre><code>using System.IO;

// Create directory
Directory.CreateDirectory("MyFolder");

// Get all files in directory
string[] files = Directory.GetFiles(".");
foreach (string file in files)
    Console.WriteLine(file);

// Get all subdirectories
string[] directories = Directory.GetDirectories(".");
foreach (string dir in directories)
    Console.WriteLine(dir);

// Check if directory exists
if (Directory.Exists("MyFolder"))
    Console.WriteLine("Folder exists!");

// Delete directory
Directory.Delete("MyFolder", true); // true for recursive delete</code></pre>

                <h2>File Information</h2>
                <pre><code>using System.IO;

FileInfo fileInfo = new FileInfo("example.txt");
Console.WriteLine($"Name: {fileInfo.Name}");
Console.WriteLine($"Full Name: {fileInfo.FullName}");
Console.WriteLine($"Size: {fileInfo.Length} bytes");
Console.WriteLine($"Created: {fileInfo.CreationTime}");
Console.WriteLine($"Modified: {fileInfo.LastWriteTime}");
Console.WriteLine($"Read-Only: {fileInfo.IsReadOnly}");

// Change file attributes
fileInfo.Attributes = FileAttributes.Normal;</code></pre>
