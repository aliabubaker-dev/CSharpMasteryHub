@page
@model DiscussionModel
@{
    ViewData["Title"] = "Discussion - C# Mastery Hub";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="badge bg-info text-dark px-3 py-2 rounded-pill mb-2">
                    <i class="fas fa-comments me-1"></i> Community Discussion
                </div>
                <h1 class="display-4 fw-bold">@(Model.CurrentDiscussion != null ? Model.CurrentDiscussion.Title : "Discussion Forum")</h1>
                <p class="lead text-muted">share knowledge, and learn together</p>
            </div>

            @if (Model.CurrentDiscussion != null)
            {
                <!-- Single Discussion View -->
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <!-- Discussion Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h2 class="fw-bold mb-2">@Model.CurrentDiscussion.Title</h2>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-primary">@Model.CurrentDiscussion.Topic</span>
                                    <span class="badge bg-secondary">@Model.CurrentDiscussion.Lesson</span>
                                    @if (Model.CurrentDiscussion.IsPinned)
                                    {
                                        <span class="badge bg-warning text-dark">📌 Pinned</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end text-muted small">
                                <div>👁️ @Model.CurrentDiscussion.ViewCount views</div>
                                <div>💬 @Model.CurrentDiscussion.ReplyCount replies</div>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-3 bg-light rounded-3 mb-4">
                            <p class="mb-0">@Model.CurrentDiscussion.Content</p>
                            <div class="text-muted small mt-2">
                                Posted by <strong>@Model.CurrentDiscussion.AuthorName</strong> on @Model.CurrentDiscussion.CreatedDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        <!-- Replies -->
                        <h5 class="fw-bold mb-3"><i class="fas fa-reply-all me-2"></i>Replies (@Model.CurrentDiscussion.ReplyCount)</h5>

                        @if (Model.CurrentDiscussion.Replies.Any())
                        {
                            foreach (var reply in Model.CurrentDiscussion.Replies)
                            {
                                <div class="p-3 border-start border-4 border-primary bg-light bg-opacity-50 rounded-3 mb-3">
                                    <div class="d-flex justify-content-between">
                                        <strong>@reply.AuthorName</strong>
                                        <span class="text-muted small">@reply.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</span>
                                    </div>
                                    <p class="mb-0 mt-1">@reply.Content</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No replies yet. Be the first to answer!</p>
                        }

                       

                        <div class="mt-3">
                            <a href="/Discussion?Topic=@Model.CurrentDiscussion.Topic" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Discussions
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Discussions.Any())
            {
                <!-- Discussions List View -->
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        

                        

                        <!-- Discussion List -->
                        @foreach (var discussion in Model.Discussions)
                        {
                            <div class="discussion-item p-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <a href="/Discussion?Id=@discussion.Id" class="text-decoration-none text-dark">
                                            <h6 class="fw-bold mb-1">@discussion.Title</h6>
                                        </a>
                                        <div class="d-flex flex-wrap gap-2 small text-muted">
                                            <span>Posted by <strong>@discussion.AuthorName</strong></span>
                                            <span>•</span>
                                            <span>@discussion.CreatedDate.ToString("MMM dd, yyyy")</span>
                                            <span>•</span>
                                            <span>💬 @discussion.ReplyCount replies</span>
                                            <span>•</span>
                                            <span>👁️ @discussion.ViewCount views</span>
                                            @if (discussion.IsPinned)
                                            {
                                                <span class="badge bg-warning text-dark">📌 Pinned</span>
                                            }
                                        </div>
                                    </div>
                                    <a href="/Discussion?Id=@discussion.Id" class="btn btn-outline-primary btn-sm">
                                        View <i class="fas fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                    <h3>No discussions yet for this topic</h3>
                    <p class="text-muted">Be the first to start a discussion!</p>
                    <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newDiscussionForm">
                        <i class="fas fa-plus me-2"></i>Start a Discussion
                    </button>
                    <!-- Hidden form that appears when button is clicked -->
                    <div class="collapse mt-3" id="newDiscussionForm">
                        <div class="p-3 border rounded-3 text-start">
                            <h6 class="fw-bold mb-3">Start a New Discussion</h6>
                            <form method="post" asp-page-handler="NewDiscussion">
                                <input type="hidden" asp-for="Topic" />
                                <div class="mb-2">
                                    <input asp-for="NewDiscussion.Title" class="form-control" placeholder="Discussion title" required />
                                </div>
                                <div class="mb-2">
                                    <input asp-for="NewDiscussion.AuthorName" class="form-control" placeholder="Your name" required />
                                </div>
                                <div class="mb-2">
                                    <textarea asp-for="NewDiscussion.Content" class="form-control" rows="4" placeholder="Describe your question or topic..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fas fa-paper-plane me-2"></i>Post Discussion
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .discussion-item {
        transition: background-color 0.3s ease;
    }

        .discussion-item:hover {
            background-color: #f8f9fa;
        }

        .discussion-item:last-child {
            border-bottom: none !important;
        }

    .card {
        transition: all 0.3s ease;
    }
</style>