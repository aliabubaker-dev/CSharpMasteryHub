                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>GET</td><td>Read data</td></tr>
                            <tr><td>POST</td><td>Create new data</td></tr>
                            <tr><td>PUT</td><td>Replace/update existing data</td></tr>
                            <tr><td>DELETE</td><td>Remove data</td></tr>
                        </tbody>
                    </table>
                </div>

