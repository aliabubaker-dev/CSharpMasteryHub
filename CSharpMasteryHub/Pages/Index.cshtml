@page
@model IndexModel
@{
    ViewData["Title"] = "C# Mastery Hub - Learn C# Step by Step";
}

<!-- ===== HERO SECTION ===== -->
<section class="hero-section" data-aos="fade-up" data-aos-duration="800">
    <div class="container">
        <div class="row align-items-center min-vh-75 py-5">
            <div class="col-lg-8 mx-auto text-center">
                <div class="hero-badge mb-3" data-aos="zoom-in" data-aos-delay="200">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                        <i class="fas fa-graduation-cap me-1"></i> Free & Complete Course
                    </span>
                </div>
                <h1 class="display-2 fw-bold mb-4" data-aos="fade-up" data-aos-delay="400">
                    Master C# from <span class="text-warning">Zero</span> to <span class="text-success">Hero</span>
                </h1>
                <p class="lead mb-4" style="font-size: 1.25rem;" data-aos="fade-up" data-aos-delay="600">
                    Your complete free guide to learning C# programming. From fundamentals to professional development,
                    with .NET, ASP.NET Core, SQL Server, MAUI, and more.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap" data-aos="fade-up" data-aos-delay="800">
                    <a href="/GettingStarted" class="btn btn-primary-custom btn-lg pulse-btn">
                        <i class="fas fa-rocket me-2"></i>Start Learning
                    </a>
                    <a href="/DevOps" class="btn btn-warning btn-lg">
                        <i class="fas fa-infinity me-2"></i>Learn DevOps
                    </a>
                    <a href="#learning-path" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-road me-2"></i>View Learning Path
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== COMPANY BANNER ===== -->
<section class="company-banner py-2 bg-primary bg-opacity-10 border-top border-bottom border-primary">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">
                <a href="https://crossplatformdev.com" target="_blank" class="text-decoration-none d-inline-flex align-items-center gap-2">
                    <img src="~/img/logo-icon.png" alt="CrossPlatformDev" height="25">
                    <span class="fw-semibold text-dark">CrossPlatformDev</span>
                    <span class="text-muted small">|</span>
                    <span class="text-muted small">Custom Websites, Mobile Apps &amp; Business Systems</span>
                    <i class="fas fa-external-link-alt text-primary small"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ===== STATS SECTION ===== -->
<section class="stats-section py-4">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="100">
                <div class="stat-box text-center p-3 rounded-3 bg-white shadow-sm">
                    <div class="stat-number display-4 fw-bold text-primary" data-count="19">0</div>
                    <div class="stat-label text-muted">Topics Covered</div>
                </div>
            </div>
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-box text-center p-3 rounded-3 bg-white shadow-sm">
                    <div class="stat-number display-4 fw-bold text-primary" data-count="120">0</div>
                    <div class="stat-label text-muted">Lessons</div>
                </div>
            </div>
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="300">
                <div class="stat-box text-center p-3 rounded-3 bg-white shadow-sm">
                    <div class="stat-number display-4 fw-bold text-success">100%</div>
                    <div class="stat-label text-muted">Free Access</div>
                </div>
            </div>
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="400">
                <div class="stat-box text-center p-3 rounded-3 bg-white shadow-sm">
                    <div class="stat-number display-4 fw-bold text-warning">24/7</div>
                    <div class="stat-label text-muted">Available</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== LEARNING PATH ===== -->
<section id="learning-path" class="learning-path-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <h2 class="display-5 fw-bold">Your Learning Path</h2>
            <p class="lead text-muted">Follow this step-by-step journey from beginner to professional developer</p>
            <div class="mt-3 d-flex justify-content-center gap-3 flex-wrap">
                <span class="badge bg-success p-2 px-3">Beginner</span>
                <span class="badge bg-warning text-dark p-2 px-3">Intermediate</span>
                <span class="badge bg-danger p-2 px-3">Advanced</span>
                <span class="badge bg-primary p-2 px-3">19 Topics</span>
            </div>
        </div>

        <!-- Learning Path Timeline -->
        <div class="learning-path-timeline">
            <!-- Level 1: Beginner -->
            <div class="level-section mb-5" data-aos="fade-up">
                <div class="level-header d-flex align-items-center gap-3 mb-4">
                    <div class="level-icon bg-success text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fas fa-seedling fa-lg"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-success">Level 1: <span class="text-dark">Beginner</span></h3>
                    <span class="badge bg-success ms-auto">Start Here!</span>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-info">
                            <a href="/GettingStarted" class="text-decoration-none">
                                <div class="step-number bg-info text-white rounded-circle d-flex align-items-center justify-content-center mb-2">1</div>
                                <h5 class="fw-bold text-dark">Getting Started</h5>
                                <p class="text-muted small">Install Visual Studio, SQL Server, Git, and all necessary tools.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">4 Lessons</span>
                                    <span class="badge bg-success">Beginner</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="150">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-primary">
                            <a href="/CSharpFundamentals" class="text-decoration-none">
                                <div class="step-number bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mb-2">2</div>
                                <h5 class="fw-bold text-dark">C# Fundamentals</h5>
                                <p class="text-muted small">Variables, data types, control flow, loops, methods, and more.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">13 Lessons</span>
                                    <span class="badge bg-success">Beginner</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-success">
                            <a href="/ConsoleApp" class="text-decoration-none">
                                <div class="step-number bg-success text-white rounded-circle d-flex align-items-center justify-content-center mb-2">3</div>
                                <h5 class="fw-bold text-dark">Console Applications</h5>
                                <p class="text-muted small">Build console apps with input/output, file handling, and projects.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">4 Lessons</span>
                                    <span class="badge bg-success">Beginner</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Level 2: Intermediate -->
            <div class="level-section mb-5" data-aos="fade-up">
                <div class="level-header d-flex align-items-center gap-3 mb-4">
                    <div class="level-icon bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fas fa-cogs fa-lg"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-warning">Level 2: <span class="text-dark">Intermediate</span></h3>
                    <span class="badge bg-warning text-dark ms-auto">Getting Stronger!</span>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="250">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-warning">
                            <a href="/ClassesAndOOP" class="text-decoration-none">
                                <div class="step-number bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center mb-2">4</div>
                                <h5 class="fw-bold text-dark">Classes &amp; OOP</h5>
                                <p class="text-muted small">Master OOP with classes, inheritance, polymorphism, and SOLID.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">11 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-info">
                            <a href="/WindowsForms" class="text-decoration-none">
                                <div class="step-number bg-info text-white rounded-circle d-flex align-items-center justify-content-center mb-2">5</div>
                                <h5 class="fw-bold text-dark">Windows Forms</h5>
                                <p class="text-muted small">Create desktop apps with controls, events, data binding, and CRUD.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">7 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="350">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-danger">
                            <a href="/RazorPages" class="text-decoration-none">
                                <div class="step-number bg-danger text-white rounded-circle d-flex align-items-center justify-content-center mb-2">6</div>
                                <h5 class="fw-bold text-dark">ASP.NET Core</h5>
                                <p class="text-muted small">Build web apps with Razor Pages, routing, validation, and CRUD.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">8 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="400">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-secondary">
                            <a href="/SqlServer" class="text-decoration-none">
                                <div class="step-number bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mb-2">7</div>
                                <h5 class="fw-bold text-dark">SQL Server</h5>
                                <p class="text-muted small">Master databases, tables, joins, stored procedures, and performance.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">10 Lessons</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="450">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-primary">
                            <a href="/VsSqlConnection" class="text-decoration-none">
                                <div class="step-number bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mb-2">8</div>
                                <h5 class="fw-bold text-dark">VS &amp; SQL Connection</h5>
                                <p class="text-muted small">Connect SQL Server to VS. ADO.NET, EF Core, and CRUD operations.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">5 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="500">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-success">
                            <a href="/RdlcReports" class="text-decoration-none">
                                <div class="step-number bg-success text-white rounded-circle d-flex align-items-center justify-content-center mb-2">9</div>
                                <h5 class="fw-bold text-dark">RDLC Reports</h5>
                                <p class="text-muted small">Create professional reports in Windows Forms with SQL integration.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">5 Lessons</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="550">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-warning">
                            <a href="/DotNetMaui" class="text-decoration-none">
                                <div class="step-number bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center mb-2">10</div>
                                <h5 class="fw-bold text-dark">.NET MAUI</h5>
                                <p class="text-muted small">Build cross-platform mobile/desktop apps with .NET MAUI.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">8 Lessons</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Level 3: Advanced -->
            <div class="level-section mb-5" data-aos="fade-up">
                <div class="level-header d-flex align-items-center gap-3 mb-4">
                    <div class="level-icon bg-danger text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fas fa-rocket fa-lg"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-danger">Level 3: <span class="text-dark">Advanced</span></h3>
                    <span class="badge bg-danger ms-auto">Master Level!</span>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="600">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-danger">
                            <a href="/WebsiteDevelopment" class="text-decoration-none">
                                <div class="step-number bg-danger text-white rounded-circle d-flex align-items-center justify-content-center mb-2">11</div>
                                <h5 class="fw-bold text-dark">Website Development</h5>
                                <p class="text-muted small">Planning, structure, responsive design, and Git workflow.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">4 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="650">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-secondary">
                            <a href="/Seo" class="text-decoration-none">
                                <div class="step-number bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mb-2">12</div>
                                <h5 class="fw-bold text-dark">SEO Guide</h5>
                                <p class="text-muted small">Master SEO, meta tags, sitemaps, page speed, and Google Console.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">6 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="700">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-success">
                            <a href="/Security" class="text-decoration-none">
                                <div class="step-number bg-success text-white rounded-circle d-flex align-items-center justify-content-center mb-2">13</div>
                                <h5 class="fw-bold text-dark">Security</h5>
                                <p class="text-muted small">HTTPS, authentication, SQL injection prevention, security headers.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">6 Lessons</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="750">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-primary">
                            <a href="/ProjectWorkflow" class="text-decoration-none">
                                <div class="step-number bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mb-2">14</div>
                                <h5 class="fw-bold text-dark">Project Workflow</h5>
                                <p class="text-muted small">Requirements, Git branching, coding standards, and delivery.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">5 Lessons</span>
                                    <span class="badge bg-warning text-dark">Intermediate</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="800">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-warning">
                            <a href="/ExtraTopics" class="text-decoration-none">
                                <div class="step-number bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center mb-2">15</div>
                                <h5 class="fw-bold text-dark">Extra Topics</h5>
                                <p class="text-muted small">Git, unit testing, design patterns, async/await, REST APIs.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">6 Lessons</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="850">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4 border-info">
                            <a href="/Deployment" class="text-decoration-none">
                                <div class="step-number bg-info text-white rounded-circle d-flex align-items-center justify-content-center mb-2">16</div>
                                <h5 class="fw-bold text-dark">Deployment</h5>
                                <p class="text-muted small">Deploy for free using Azure, GitHub Actions, Netlify, and Vercel.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">5 Lessons</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="900">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4" style="border-color: #FF9900 !important;">
                            <a href="/AWS" class="text-decoration-none">
                                <div class="step-number rounded-circle d-flex align-items-center justify-content-center mb-2" style="background-color: #FF9900; color: #232F3E;">17</div>
                                <h5 class="fw-bold text-dark">AWS Cloud</h5>
                                <p class="text-muted small">Master Amazon Web Services. EC2, S3, Lambda, networking, databases, security, and deployment.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">8 Modules</span>
                                    <span class="badge" style="background-color: #FF9900; color: #232F3E;">Free Tier</span>
                                    <span class="badge bg-success">Beginner to Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- ===== Full WinForms Project ===== -->
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="950">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4" style="border-color: #6f42c1 !important;">
                            <a href="/WindowsForms/FullProject" class="text-decoration-none">
                                <div class="step-number rounded-circle d-flex align-items-center justify-content-center mb-2" style="background-color: #6f42c1; color: #fff;">18</div>
                                <h5 class="fw-bold text-dark">Full WinForms Project</h5>
                                <p class="text-muted small">Build a complete project using all 29 WinForms controls. Step-by-step guide from opening Visual Studio to the final product.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">1 Project</span>
                                    <span class="badge" style="background-color: #6f42c1; color: #fff;">All Controls</span>
                                    <span class="badge bg-danger">Advanced</span>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- ===== NEW: DevOps Learning Hub ===== -->
                    <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="1000">
                        <div class="path-card h-100 p-4 rounded-3 bg-white shadow-sm border-start border-4" style="border-color: #6366F1 !important;">
                            <a href="/DevOps" class="text-decoration-none">
                                <div class="step-number rounded-circle d-flex align-items-center justify-content-center mb-2" style="background-color: #6366F1; color: #fff;">19</div>
                                <h5 class="fw-bold text-dark">DevOps Learning Hub</h5>
                                <p class="text-muted small">Master Docker, CI/CD, Kubernetes, Terraform, and monitoring with real client scenarios in simple English.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">7 Lessons</span>
                                    <span class="badge" style="background-color: #6366F1; color: #fff;">New!</span>
                                    <span class="badge bg-success">Project</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Indicator -->
        <div class="progress-indicator mt-5 text-center" data-aos="fade-up">
            <div class="p-4 bg-primary bg-opacity-10 rounded-4">
                <h5 class="fw-bold mb-2"><i class="fas fa-trophy text-warning me-2"></i>Track Your Progress</h5>
                <p class="text-muted small mb-0">Complete each topic and mark it as done. Watch your progress grow!</p>
                <div class="mt-3">
                    <div class="progress mx-auto" style="height: 10px; max-width: 500px;">
                        <div class="progress-bar bg-success" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span class="text-muted small" id="progressText">0% Complete</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== FINAL CTA ===== -->
<section class="final-cta py-5" data-aos="fade-up">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <div class="p-5 bg-gradient-primary rounded-4" style="background: linear-gradient(135deg, #512BD4, #0D6EFD);">
                    <h3 class="text-white fw-bold mb-3">Ready to Become a C# Master?</h3>
                    <p class="text-white-50 mb-4">Start your journey today with our complete free guide. No registration required.</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="/CSharpFundamentals/01-Introduction" class="btn btn-warning btn-lg pulse-btn">
                            <i class="fas fa-arrow-right me-2"></i>Start First Lesson
