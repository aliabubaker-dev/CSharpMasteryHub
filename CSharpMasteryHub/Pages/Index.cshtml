        </div>
    </div>
</div>

<div class="row g-4 mt-4">
    <div class="col-md-6">
        <div class="progress-section">
            <h5><i class="fas fa-play-circle me-2 text-primary"></i>Getting Started</h5>
            <p>New to C#? Start here with installation guides and environment setup.</p>
            <a href="/GettingStarted" class="btn btn-outline-primary btn-sm">Get Started</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="progress-section">
            <h5><i class="fas fa-shield-alt me-2 text-success"></i>Security</h5>
            <p>Learn how to secure your web applications with best practices and security headers.</p>
            <a href="/Security" class="btn btn-outline-success btn-sm">Learn Security</a>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-lg-8 mx-auto text-center">
        <div class="p-5 bg-primary bg-opacity-10 rounded-4">
            <h3 class="mb-3">Ready to Become a C# Master?</h3>
            <p class="mb-4">Start your journey today with our complete free guide. No registration required.</p>
            <a href="/CSharpFundamentals/01-Introduction" class="btn btn-primary-custom">
                <i class="fas fa-arrow-right me-2"></i>Start First Lesson
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const numbers = document.querySelectorAll('.number');
            numbers.forEach(num => {
                const target = parseInt(num.textContent);
                let current = 0;
                const increment = target / 50;
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        num.textContent = target + (target > 10 ? '+' : '');
                        clearInterval(timer);
                    } else {
                        num.textContent = Math.floor(current);
                    }
                }, 30);
            });
        });
    </script>
}