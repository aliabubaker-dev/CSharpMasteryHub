<style>
    .learning-path-timeline {
        position: relative;
        padding-left: 20px;
    }

    .level-section {
        position: relative;
        padding-left: 20px;
    }

        .level-section::before {
            content: '';
            position: absolute;
            left: 3px;
            top: 50px;
            bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom, #198754, #ffc107, #dc3545);
            border-radius: 2px;
            opacity: 0.3;
        }

    .level-icon {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
    }

    .path-card {
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .path-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.12) !important;
        }

        .path-card .step-number {
            width: 35px;
            height: 35px;
            font-size: 0.9rem;
            font-weight: 700;
        }

        .path-card a {
            display: block;
            color: inherit;
        }

            .path-card a:hover {
                text-decoration: none;
            }

    .progress-indicator .progress {
        background-color: #e9ecef;
    }

    .progress-indicator .progress-bar {
        transition: width 0.5s ease;
    }

    .hero-section {
        background: linear-gradient(135deg, rgba(81, 43, 212, 0.05), rgba(13, 110, 253, 0.05));
        border-bottom: 1px solid rgba(81, 43, 212, 0.1);
    }

    .pulse-btn {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.4);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(255, 193, 7, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
        }
    }

    .stat-box {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }

        .stat-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

    @@media (max-width: 768px) {
        .hero-section h1 {
            font-size: 2.2rem;
        }

        .level-header h3 {
            font-size: 1.2rem;
        }

        .level-icon {
            width: 40px;
            height: 40px;
        }

        .path-card {
            padding: 1.25rem !important;
        }

            .path-card h5 {
                font-size: 1rem;
            }
    }

    @@media (max-width: 576px) {
        .hero-section h1 {
            font-size: 1.8rem;
        }

        .level-section::before {
