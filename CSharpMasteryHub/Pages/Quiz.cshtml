@page
@model QuizModel
@{
    ViewData["Title"] = $"{Model.Topic} Quiz - C# Mastery Hub";
    var topicName = Model.Topic switch
    {
        "CSharpFundamentals" => "C# Fundamentals",
        "ConsoleApp" => "Console Applications",
        "ClassesAndOOP" => "Classes & OOP",
        "WindowsForms" => "Windows Forms",
        "RazorPages" => "ASP.NET Core",
        "SqlServer" => "SQL Server",
        "VsSqlConnection" => "VS & SQL Connection",
        _ => Model.Topic
    };
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="badge bg-primary text-white px-3 py-2 rounded-pill mb-2">
                    <i class="fas fa-brain me-1"></i> Test Your Knowledge
                </div>
                <h1 class="display-4 fw-bold">@topicName Quiz</h1>
                <p class="lead text-muted">Answer all questions to test your understanding</p>
            </div>

            @if (!Model.IsSubmitted && Model.Questions.Count > 0)
            {
                <!-- Quiz Form -->
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <form method="post">
                            <input type="hidden" asp-for="Topic" />

                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var question = Model.Questions[i];
                                <div class="question-item mb-4 p-3 rounded-3 border-start border-4 border-primary">
                                    <h5 class="fw-bold mb-3">
                                        <span class="badge bg-primary rounded-circle me-2">@(i + 1)</span>
                                        @question.Question
                                    </h5>

                                    <div class="options">
                                        @for (int j = 0; j < question.Options.Count; j++)
                                        {
                                            var optionIndex = j;
                                            var isChecked = Model.Answers.Count > i && Model.Answers[i] == optionIndex;
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio"
                                                       name="Answers[@i]" value="@optionIndex"
                                                       id="q_@(i)_@(j)"
                                                @(isChecked ? "checked" : "") required />
                                                <label class="form-check-label" for="q_@(i)_@(j)">
                                                    @question.Options[j]
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-check-circle me-2"></i>Submit Quiz
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else if (Model.IsSubmitted)
            {
                <!-- Results -->
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <!-- Score -->
                        <div class="text-center mb-4">
                            <div class="score-circle mx-auto">
                                <span class="score-number">@Model.Result.Score%</span>
                            </div>
                            <h3 class="mt-3">@Model.Result.Grade</h3>
                            <p class="text-muted">
                                You got <strong>@Model.Result.CorrectAnswers</strong> out of
                                <strong>@Model.Result.TotalQuestions</strong> correct
                            </p>
                        </div>

                        <!-- Answer Details -->
                        <h5 class="fw-bold mb-3"><i class="fas fa-list me-2"></i>Review Your Answers</h5>

                        @for (int i = 0; i < Model.Result.AnswerDetails.Count; i++)
                        {
                            var detail = Model.Result.AnswerDetails[i];
                            var question = Model.Questions[i];
                            var isCorrect = detail.IsCorrect;

                            <div class="answer-review-item p-3 mb-3 rounded-3 border-start border-4 @(isCorrect ? "border-success" : "border-danger")">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge @(isCorrect ? "bg-success" : "bg-danger") rounded-circle mt-1">
                                        @(isCorrect ? "✓" : "✗")
                                    </span>
                                    <div>
                                        <h6 class="fw-bold mb-1">@detail.Question</h6>
                                        <p class="mb-1 small">
                                            <strong>Your answer:</strong>
                                            <span class="@(isCorrect ? "text-success" : "text-danger")">
                                                @(detail.UserAnswer >= 0 && detail.UserAnswer < question.Options.Count
                                                    ? question.Options[detail.UserAnswer]
                                                    : "Not answered")
                                            </span>
                                        </p>
                                        <p class="mb-1 small">
                                            <strong>Correct answer:</strong>
                                            <span class="text-success">@question.Options[detail.CorrectAnswer]</span>
                                        </p>
                                        <p class="mb-0 small text-muted">
                                            <i class="fas fa-info-circle me-1"></i>@detail.Explanation
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-3 mt-4 flex-wrap">
                            <a href="/@Model.Topic" class="btn btn-outline-primary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Lesson
                            </a>
                            <a href="/Quiz?Topic=@Model.Topic" class="btn btn-primary">
                                <i class="fas fa-redo me-2"></i>Retry Quiz
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .score-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #512BD4, #0D6EFD);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 30px rgba(81,43,212,0.3);
    }

    .score-number {
        font-size: 2.2rem;
        font-weight: 700;
        color: white;
    }

    .question-item {
        background: #f8f9fa;
        transition: all 0.3s ease;
    }

        .question-item:hover {
            background: #f0f1f2;
        }

    .answer-review-item {
        background: #f8f9fa;
    }

        .answer-review-item.border-success {
            border-color: #198754 !important;
        }

        .answer-review-item.border-danger {
            border-color: #dc3545 !important;
        }

    .form-check-input:checked {
        background-color: #512BD4;
        border-color: #512BD4;
    }

    .form-check-label {
        cursor: pointer;
    }

        .form-check-label:hover {
            color: #512BD4;
        }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-scroll to results
            if (@Model.IsSubmitted.ToString().ToLower()) {
                document.querySelector('.score-circle').scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }

            // Confirm before submitting
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const checked = document.querySelectorAll('input[type="radio"]:checked').length;
                    const total = @Model.Questions.Count;

                    if (checked < total) {
                        const confirm = window.confirm(
                            `You have answered ${checked} out of ${total} questions. Continue?`
                        );
                        if (!confirm) {
                            e.preventDefault();
                        }
                    }
                });
            }
        });
    </script>
}