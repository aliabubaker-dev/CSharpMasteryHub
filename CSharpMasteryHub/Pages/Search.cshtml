@page
@model SearchModel
@{
    ViewData["Title"] = "Search Results";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <h1 class="display-4 mb-3">Search Results</h1>
            <p class="lead mb-4">Showing results for: <strong>"@Model.Query"</strong></p>

            @if (Model.Results.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No results found for "<strong>@Model.Query</strong>". Try searching for something else.
                </div>
            }
            else
            {
                <p>Found <strong>@Model.Results.Count</strong> result(s)</p>

                @foreach (var result in Model.Results)
                {
                    <div class="lesson-card">
                        <a href="@result.Url">
                            <h5><span class="card-number">@(Model.Results.IndexOf(result) + 1)</span>@result.Title</h5>
                            <p>@result.Description</p>
                            <span class="badge bg-primary">@result.Category</span>
                        </a>
                    </div>
                }
            }

            <div class="mt-4">
                <a href="/" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Home
                </a>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="sidebar-nav">
                <h5 class="mb-3"><i class="fas fa-search me-2"></i>Search Tips</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Search by topic name</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Search by lesson title</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Search by keyword</li>
                </ul>
            </div>
        </div>
    </div>
</div>