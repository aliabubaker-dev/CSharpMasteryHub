@page
@model SeoFundamentalsModel
@{
    ViewData["Title"] = "SEO Fundamentals";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Seo">SEO Guide</a></li>
                    <li class="breadcrumb-item active">SEO Fundamentals</li>
                </ol>
            </nav>

            <div class="lesson-content">
                <h1 class="display-4 mb-3">SEO Fundamentals</h1>
                <div class="d-flex gap-3 mb-4">
                    <span class="badge bg-success">Beginner</span>
                    <span class="badge bg-info text-dark">15 min read</span>
                    <span class="badge bg-primary">Lesson 1 of 6</span>
                </div>

                <h2>What is SEO?</h2>
                <p>Search Engine Optimization (SEO) is the practice of improving your website to increase its visibility in search engines.</p>

                <h2>Why SEO Matters</h2>
                <ul>
                    <li>Increases organic traffic</li>
                    <li>Improves brand visibility</li>
                    <li>Builds trust and credibility</li>
                    <li>Cost-effective marketing</li>
                    <li>Better user experience</li>
                </ul>

                <h2>SEO Pillars</h2>

                <h3>1. On-Page SEO</h3>
                <ul>
                    <li>Title tags and meta descriptions</li>
                    <li>Heading structure (H1, H2, H3)</li>
                    <li>Content optimization</li>
                    <li>Image optimization</li>
                    <li>Internal linking</li>
                </ul>

                <h3>2. Off-Page SEO</h3>
                <ul>
                    <li>Backlink building</li>
                    <li>Social media presence</li>
                    <li>Guest blogging</li>
                    <li>Brand mentions</li>
                </ul>

                <h3>3. Technical SEO</h3>
                <ul>
                    <li>Site speed optimization</li>
                    <li>Mobile-friendliness</li>
                    <li>Sitemap and robots.txt</li>
                    <li>Structured data</li>
                    <li>SSL/HTTPS</li>
                </ul>

                <h3>4. Content SEO</h3>
                <ul>
                    <li>Keyword research</li>
                    <li>Content quality and relevance</li>
                    <li>Content structure</li>
                    <li>Fresh and updated content</li>
                </ul>

                <div class="card bg-info bg-opacity-10 mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>SEO is a combination of technical, content, and off-page strategies to improve search visibility.</p>
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between">
                    <a href="/Seo" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Lessons
                    </a>
                    <a href="/Seo/02-MetaTagsTitleDescription" class="btn btn-primary-custom">
                        Next Lesson <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            @await Html.PartialAsync("_SidebarNav", Model.SidebarNav)
        </div>
    </div>
</div>
@await Html.PartialAsync("_QuizButton", "Seo_Lesson1")


