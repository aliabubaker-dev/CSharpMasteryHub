@model string

<div class="card border-info mt-3" data-aos="fade-up">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="flex-shrink-0">
                <i class="fas fa-comments fa-2x text-info"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1">💬 Have Questions?</h6>
                <p class="text-muted small mb-0">
                    Join the discussion about this lesson with other learners.
                </p>
            </div>
            <a href="/Discussion?Topic=@Model" class="btn btn-info btn-sm text-white">
                View Discussions <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>