<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_SeoHead")

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ===== FAVICONS ===== -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=2" sizes="any">
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" sizes="any">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png?v=2">
    <link rel="icon" type="image/png" sizes="192x192" href="~/android-chrome-192x192.png?v=2">
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="manifest" href="~/site.webmanifest">
    <meta name="msapplication-TileColor" content="#512BD4">
    <meta name="theme-color" content="#512BD4">
    <meta name="apple-mobile-web-app-title" content="C# Mastery Hub">
    <meta name="application-name" content="C# Mastery Hub">

    <!-- Animation Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />

    <style>
        /* ===== NAVBAR ENHANCED ===== */
        .navbar-custom {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 0.6rem 0;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
            transition: all 0.4s ease;
            border-bottom: 2px solid rgba(81, 43, 212, 0.3);
        }

            .navbar-custom.scrolled {
                padding: 0.3rem 0;
                background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #0f3460 100%);
                box-shadow: 0 4px 40px rgba(0, 0, 0, 0.6);
            }

            .navbar-custom .navbar-brand {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #fff;
                font-weight: 700;
                font-size: 1.2rem;
                transition: all 0.3s ease;
                text-decoration: none;
            }

                .navbar-custom .navbar-brand:hover {
                    transform: scale(1.02);
                    color: #FFC107;
                }

                .navbar-custom .navbar-brand .brand-icon {
                    animation: float 3s ease-in-out infinite;
                }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-3px);
            }
        }

        .navbar-custom .navbar-brand .brand-text {
            background: linear-gradient(90deg, #fff, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .navbar-custom .nav-link {
            color: rgba(255, 255, 255, 0.8) !important;
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            position: relative;
        }

            .navbar-custom .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background: linear-gradient(90deg, #FFC107, #FF6B6B);
                transition: all 0.3s ease;
                transform: translateX(-50%);
            }

            .navbar-custom .nav-link:hover::after {
                width: 60%;
            }

            .navbar-custom .nav-link:hover {
                color: #fff !important;
                background: rgba(255, 255, 255, 0.08);
                transform: translateY(-2px);
            }

            .navbar-custom .nav-link.active {
                color: #FFC107 !important;
            }

                .navbar-custom .nav-link.active::after {
                    width: 60%;
                    background: #FFC107;
                }

        .navbar-toggler {
            border: 2px solid rgba(255, 255, 255, 0.3);
            padding: 0.4rem 0.6rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .navbar-toggler:hover {
                border-color: #FFC107;
                transform: rotate(90deg);
            }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.9)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* Dropdown Enhanced */
        .navbar-custom .dropdown-menu {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
            padding: 0.5rem 0;
            min-width: 260px;
            animation: dropdownSlide 0.3s ease-out;
        }

        @@keyframes dropdownSlide {
            from {
                opacity: 0;
                transform: translateY(-10px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .navbar-custom .dropdown-item {
            color: rgba(255, 255, 255, 0.85);
            padding: 0.6rem 1.5rem;
            transition: all 0.3s ease;
            font-weight: 400;
            border-left: 3px solid transparent;
        }

            .navbar-custom .dropdown-item:hover {
                background: rgba(81, 43, 212, 0.3);
                color: #fff;
                border-left-color: #FFC107;
                transform: translateX(5px);
            }

            .navbar-custom .dropdown-item i {
                width: 24px;
                color: #a78bfa;
                transition: all 0.3s ease;
            }

            .navbar-custom .dropdown-item:hover i {
                color: #FFC107;
                transform: scale(1.1);
            }

        .navbar-custom .dropdown-header {
            color: #FFC107;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .navbar-custom .dropdown-divider {
            border-color: rgba(255, 255, 255, 0.05);
        }

        /* Search Icon */
        .navbar-custom .search-item .nav-link {
            padding: 0.5rem 0.75rem;
            font-size: 1.1rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

            .navbar-custom .search-item .nav-link:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: rotate(90deg);
            }

        /* ===== SEARCH BAR ===== */
        .search-container {
            background: linear-gradient(135deg, #0f0f1a, #1a1a2e);
            padding: 1rem 0;
            border-bottom: 2px solid rgba(81, 43, 212, 0.3);
            position: fixed;
            top: 72px;
            left: 0;
            right: 0;
            z-index: 999;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
            animation: slideDown 0.4s ease-out;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .search-container .form-control {
            border-radius: 50px 0 0 50px;
            padding: 0.75rem 1.5rem;
            border: 2px solid rgba(81, 43, 212, 0.3);
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .search-container .form-control:focus {
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
                border-color: #FFC107;
                box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.2);
            }

        .search-container .btn-primary {
            border-radius: 0 50px 50px 0;
            padding: 0.75rem 1.5rem;
            background: linear-gradient(135deg, #512BD4, #0D6EFD);
            border: none;
            color: #fff;
            transition: all 0.3s ease;
        }

            .search-container .btn-primary:hover {
                background: linear-gradient(135deg, #6d3de8, #1a7aff);
                transform: scale(1.02);
            }

        /* ============================================================
           MODERN FOOTER — COMPLETE REDESIGN
           ============================================================ */
        .footer-modern {
            position: relative;
            background: linear-gradient(160deg, #0a0a14 0%, #12121f 40%, #1a1a2e 100%);
            color: rgba(255, 255, 255, 0.75);
            padding: 5rem 0 0;
            margin-top: 5rem;
            overflow: hidden;
            isolation: isolate;
        }

            /* Animated gradient top border */
            .footer-modern::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #512BD4, #0D6EFD, #FFC107, #FF6B6B, #512BD4);
                background-size: 300% 100%;
                animation: gradientShift 6s linear infinite;
                z-index: 2;
            }

        @@keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            100% {
                background-position: 300% 50%;
            }
        }

        /* Ambient glow orbs */
        .footer-modern::after {
            content: '';
            position: absolute;
            top: -30%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(81, 43, 212, 0.12), transparent 65%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            animation: orbPulse 8s ease-in-out infinite;
        }

        @@keyframes orbPulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.7;
            }

            50% {
                transform: scale(1.15);
                opacity: 1;
            }
        }

        .footer-modern .footer-orb-left {
            position: absolute;
            bottom: -20%;
            left: -8%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(13, 110, 253, 0.08), transparent 65%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            animation: orbPulse 10s ease-in-out infinite reverse;
        }

        .footer-modern .container {
            position: relative;
            z-index: 1;
        }

        /* ---- Brand Section ---- */
        .footer-brand-section {
            text-align: center;
            margin-bottom: 3.5rem;
            padding-bottom: 3rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .footer-brand-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            padding: 0.5rem 1rem;
            border-radius: 16px;
        }

            .footer-brand-link:hover {
                transform: translateY(-4px) scale(1.02);
                background: rgba(255, 255, 255, 0.03);
            }

            .footer-brand-link img {
                height: 42px;
                filter: drop-shadow(0 0 12px rgba(81, 43, 212, 0.4));
                transition: all 0.4s ease;
                animation: logoFloat 4s ease-in-out infinite;
            }

            .footer-brand-link:hover img {
                filter: drop-shadow(0 0 20px rgba(255, 193, 7, 0.5));
                transform: rotate(-5deg) scale(1.08);
            }

        @@keyframes logoFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        .footer-brand-name {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(90deg, #fff 0%, #a78bfa 50%, #FFC107 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: shimmerText 4s linear infinite;
            letter-spacing: -0.5px;
        }

        @@keyframes shimmerText {
            0% {
                background-position: 0% center;
            }

            100% {
                background-position: 200% center;
            }
        }

        .footer-brand-tagline {
            display: block;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.45);
            margin-top: 6px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 500;
        }

        /* ---- Footer Columns ---- */
        .footer-col {
            margin-bottom: 2rem;
        }

        .footer-col-title {
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            position: relative;
            padding-bottom: 12px;
            letter-spacing: 0.3px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .footer-col-title::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 36px;
                height: 3px;
                border-radius: 2px;
                background: linear-gradient(90deg, #FFC107, #FF6B6B);
                transition: width 0.4s ease;
            }

            .footer-col-title:hover::after {
                width: 60px;
            }

            .footer-col-title i {
                color: #a78bfa;
                font-size: 0.9rem;
                transition: all 0.3s ease;
            }

        /* ---- Footer Links ---- */
        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 0.65rem;
                overflow: hidden;
            }

            .footer-links a {
                color: rgba(255, 255, 255, 0.6);
                text-decoration: none;
                font-size: 0.92rem;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                position: relative;
                padding: 2px 0;
            }

                .footer-links a i {
                    font-size: 0.7rem;
                    color: rgba(255, 193, 7, 0.7);
                    transition: all 0.35s ease;
                    transform: translateX(0);
                }

                .footer-links a::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 0;
                    height: 1px;
                    background: linear-gradient(90deg, #FFC107, transparent);
                    transition: width 0.35s ease;
                }

                .footer-links a:hover {
                    color: #fff;
                    transform: translateX(6px);
                }

                    .footer-links a:hover i {
                        color: #FFC107;
                        transform: translateX(2px) scale(1.2);
                    }

                    .footer-links a:hover::after {
                        width: 100%;
                    }

        /* ---- Social Icons ---- */
        .footer-social {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .footer-social-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.05rem;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

            .footer-social-btn::before {
                content: '';
                position: absolute;
                inset: 0;
                background: var(--social-color, #512BD4);
                opacity: 0;
                transform: scale(0);
                border-radius: 50%;
                transition: all 0.4s ease;
            }

            .footer-social-btn i {
                position: relative;
                z-index: 1;
                transition: all 0.3s ease;
            }

            .footer-social-btn:hover {
                color: #fff;
                border-color: transparent;
                transform: translateY(-5px) rotate(-5deg);
                box-shadow: 0 10px 25px var(--social-shadow, rgba(81, 43, 212, 0.4));
            }

                .footer-social-btn:hover::before {
                    opacity: 1;
                    transform: scale(1);
                    border-radius: 12px;
                }

                .footer-social-btn:hover i {
                    transform: scale(1.15);
                }

        /* Social brand colors */
        .footer-social-btn[data-social="github"] {
            --social-color: #24292e;
            --social-shadow: rgba(36, 41, 46, 0.5);
        }

        .footer-social-btn[data-social="twitter"] {
            --social-color: #1DA1F2;
            --social-shadow: rgba(29, 161, 242, 0.4);
        }

        .footer-social-btn[data-social="youtube"] {
            --social-color: #FF0000;
            --social-shadow: rgba(255, 0, 0, 0.4);
        }

        .footer-social-btn[data-social="linkedin"] {
            --social-color: #0A66C2;
            --social-shadow: rgba(10, 102, 194, 0.4);
        }

        .footer-social-btn[data-social="facebook"] {
            --social-color: #1877F2;
            --social-shadow: rgba(24, 119, 242, 0.4);
        }

        .footer-social-btn[data-social="instagram"] {
            --social-color: #E4405F;
            --social-shadow: rgba(228, 64, 95, 0.4);
        }

        /* ---- Newsletter Section ---- */
        .footer-newsletter {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 1.5rem;
            margin-top: 1rem;
            transition: all 0.4s ease;
        }

            .footer-newsletter:hover {
                background: rgba(255, 255, 255, 0.05);
                border-color: rgba(81, 43, 212, 0.3);
                box-shadow: 0 8px 30px rgba(81, 43, 212, 0.1);
            }

        .footer-newsletter p {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 1rem;
            line-height: 1.5;
        }

        .footer-newsletter-form {
            display: flex;
            gap: 8px;
        }

            .footer-newsletter-form input {
                flex: 1;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                padding: 0.6rem 1rem;
                color: #fff;
                font-size: 0.85rem;
                transition: all 0.3s ease;
                min-width: 0;
            }

                .footer-newsletter-form input::placeholder {
                    color: rgba(255, 255, 255, 0.35);
                }

                .footer-newsletter-form input:focus {
                    outline: none;
                    border-color: #FFC107;
                    background: rgba(255, 255, 255, 0.08);
                    box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.15);
                }

            .footer-newsletter-form button {
                background: linear-gradient(135deg, #512BD4, #0D6EFD);
                border: none;
                border-radius: 10px;
                padding: 0.6rem 1.2rem;
                color: #fff;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
                white-space: nowrap;
            }

                .footer-newsletter-form button:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(81, 43, 212, 0.4);
                }

                .footer-newsletter-form button:active {
                    transform: translateY(0);
                }

        /* ---- Footer Bottom Bar ---- */
        .footer-bottom-bar {
            margin-top: 3rem;
            padding: 1.5rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-copyright {
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.85rem;
            margin: 0;
        }

            .footer-copyright .heart {
                color: #FF6B6B;
                display: inline-block;
                animation: heartBeat 1.5s ease-in-out infinite;
                margin: 0 2px;
            }

        @@keyframes heartBeat {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.25);
            }
        }

        .footer-bottom-links {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

            .footer-bottom-links a {
                color: rgba(255, 255, 255, 0.4);
                text-decoration: none;
                font-size: 0.85rem;
                transition: all 0.3s ease;
                position: relative;
            }

                .footer-bottom-links a::after {
                    content: '';
                    position: absolute;
                    bottom: -3px;
                    left: 0;
                    width: 0;
                    height: 1px;
                    background: #FFC107;
                    transition: width 0.3s ease;
                }

                .footer-bottom-links a:hover {
                    color: #FFC107;
                }

                    .footer-bottom-links a:hover::after {
                        width: 100%;
                    }

        /* ---- Back to Top Button ---- */
        .footer-back-to-top {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: linear-gradient(135deg, #512BD4, #0D6EFD);
            color: #fff;
            border: none;
            display: none;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(81, 43, 212, 0.4);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 1000;
            font-size: 1.1rem;
        }

            .footer-back-to-top.visible {
                display: flex;
            }

            .footer-back-to-top:hover {
                transform: translateY(-4px) scale(1.05);
                box-shadow: 0 8px 30px rgba(81, 43, 212, 0.6);
            }

            .footer-back-to-top:active {
                transform: translateY(-2px) scale(1);
            }

        /* ---- Footer Responsive ---- */
        @@media (max-width: 991.98px) {
            .footer-modern {
                padding: 3.5rem 0 0;
            }

            .footer-brand-section {
                margin-bottom: 2.5rem;
                padding-bottom: 2rem;
            }

            .footer-brand-name {
                font-size: 1.3rem;
            }

            .footer-brand-link img {
                height: 35px;
            }

            .footer-col {
                margin-bottom: 1.75rem;
            }

            .footer-col-title {
                margin-bottom: 1.1rem;
                font-size: 0.95rem;
            }
        }

        @@media (max-width: 576px) {
            .footer-modern {
                padding: 2.5rem 0 0;
                margin-top: 3rem;
            }

            .footer-brand-section {
                margin-bottom: 2rem;
                padding-bottom: 1.5rem;
            }

            .footer-brand-link {
                flex-direction: column;
                gap: 8px;
            }

            .footer-brand-link img {
                height: 48px;
            }

            .footer-brand-name {
                font-size: 1.15rem;
            }

            .footer-brand-tagline {
                font-size: 0.7rem;
                letter-spacing: 1px;
            }

            .footer-col {
                margin-bottom: 1.5rem;
            }

            .footer-col-title {
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }

            .footer-links a {
                font-size: 0.85rem;
            }

            .footer-social-btn {
                width: 40px;
