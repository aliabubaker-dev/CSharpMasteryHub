    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ===== FAVICONS ===== -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=2" sizes="any">
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" sizes="any">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png?v=2">
    <link rel="icon" type="image/png" sizes="192x192" href="~/android-chrome-192x192.png?v=2">
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="manifest" href="~/site.webmanifest">
    <meta name="msapplication-TileColor" content="#512BD4">
    <meta name="theme-color" content="#512BD4">
    <meta name="apple-mobile-web-app-title" content="C# Mastery Hub">
    <meta name="application-name" content="C# Mastery Hub">

    <!-- Animation Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />

    <style>
            /* ===== NAVBAR ENHANCED ===== */
            .navbar-custom {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
                padding: 0.6rem 0;
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease;
                border-bottom: 2px solid rgba(81, 43, 212, 0.3);
            }

                .navbar-custom.scrolled {
                    padding: 0.3rem 0;
                    background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #0f3460 100%);
                    box-shadow: 0 4px 40px rgba(0, 0, 0, 0.6);
                }

                .navbar-custom .navbar-brand {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: #fff;
                    font-weight: 700;
                    font-size: 1.2rem;
                    transition: all 0.3s ease;
                    text-decoration: none;
                }

                    .navbar-custom .navbar-brand:hover {
                        transform: scale(1.02);
                        color: #FFC107;
                    }

                    .navbar-custom .navbar-brand .brand-icon {
                        animation: float 3s ease-in-out infinite;
                    }

            @@keyframes float {
                0%, 100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-3px);
                }
            }

            .navbar-custom .navbar-brand .brand-text {
                background: linear-gradient(90deg, #fff, #a78bfa);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                font-weight: 800;
            }

            .navbar-custom .nav-link {
                color: rgba(255, 255, 255, 0.8) !important;
                padding: 0.5rem 1rem;
                font-weight: 500;
                transition: all 0.3s ease;
                border-radius: 8px;
                position: relative;
            }

                .navbar-custom .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 50%;
                    width: 0;
                    height: 2px;
                    background: linear-gradient(90deg, #FFC107, #FF6B6B);
                    transition: all 0.3s ease;
                    transform: translateX(-50%);
                }

                .navbar-custom .nav-link:hover::after {
                    width: 60%;
                }

                .navbar-custom .nav-link:hover {
                    color: #fff !important;
                    background: rgba(255, 255, 255, 0.08);
                    transform: translateY(-2px);
                }

                .navbar-custom .nav-link.active {
                    color: #FFC107 !important;
                }

                    .navbar-custom .nav-link.active::after {
                        width: 60%;
                        background: #FFC107;
                    }

            .navbar-toggler {
                border: 2px solid rgba(255, 255, 255, 0.3);
                padding: 0.4rem 0.6rem;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

                .navbar-toggler:hover {
                    border-color: #FFC107;
                    transform: rotate(90deg);
                }

            .navbar-toggler-icon {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.9)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            }

            /* Dropdown Enhanced */
            .navbar-custom .dropdown-menu {
                background: linear-gradient(135deg, #1a1a2e, #16213e);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 16px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
                padding: 0.5rem 0;
                min-width: 260px;
                animation: dropdownSlide 0.3s ease-out;
            }

            @@keyframes dropdownSlide {
                from {
                    opacity: 0;
                    transform: translateY(-10px) scale(0.95);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .navbar-custom .dropdown-item {
                color: rgba(255, 255, 255, 0.85);
                padding: 0.6rem 1.5rem;
                transition: all 0.3s ease;
                font-weight: 400;
                border-left: 3px solid transparent;
            }

                .navbar-custom .dropdown-item:hover {
                    background: rgba(81, 43, 212, 0.3);
                    color: #fff;
                    border-left-color: #FFC107;
                    transform: translateX(5px);
                }

                .navbar-custom .dropdown-item i {
                    width: 24px;
                    color: #a78bfa;
                    transition: all 0.3s ease;
                }

                .navbar-custom .dropdown-item:hover i {
                    color: #FFC107;
                    transform: scale(1.1);
                }

            .navbar-custom .dropdown-header {
                color: #FFC107;
                font-weight: 600;
                padding: 0.5rem 1.5rem;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

            .navbar-custom .dropdown-divider {
                border-color: rgba(255, 255, 255, 0.05);
            }

            /* Search Icon */
            .navbar-custom .search-item .nav-link {
                padding: 0.5rem 0.75rem;
                font-size: 1.1rem;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
            }

                .navbar-custom .search-item .nav-link:hover {
                    background: rgba(255, 255, 255, 0.1);
                    transform: rotate(90deg);
                }

            /* ===== SEARCH BAR ===== */
            .search-container {
                background: linear-gradient(135deg, #0f0f1a, #1a1a2e);
                padding: 1rem 0;
                border-bottom: 2px solid rgba(81, 43, 212, 0.3);
                position: fixed;
                top: 72px;
                left: 0;
                right: 0;
                z-index: 999;
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
                animation: slideDown 0.4s ease-out;
            }

            @@keyframes slideDown {
                from {
                    opacity: 0;
                    transform: translateY(-20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .search-container .form-control {
                border-radius: 50px 0 0 50px;
                padding: 0.75rem 1.5rem;
                border: 2px solid rgba(81, 43, 212, 0.3);
                background: rgba(255, 255, 255, 0.05);
                color: #fff;
                font-size: 1rem;
                transition: all 0.3s ease;
            }

                .search-container .form-control:focus {
                    background: rgba(255, 255, 255, 0.1);
                    color: #fff;
                    border-color: #FFC107;
                    box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.2);
                }

            .search-container .btn-primary {
                border-radius: 0 50px 50px 0;
                padding: 0.75rem 1.5rem;
                background: linear-gradient(135deg, #512BD4, #0D6EFD);
                border: none;
                color: #fff;
                transition: all 0.3s ease;
            }

                .search-container .btn-primary:hover {
                    background: linear-gradient(135deg, #6d3de8, #1a7aff);
                    transform: scale(1.02);
                }

            /* ===== FOOTER ENHANCED ===== */
            .footer-custom {
                background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #0f3460 100%);
                color: rgba(255, 255, 255, 0.8);
                padding: 4rem 0 2rem;
                margin-top: 4rem;
                border-top: 2px solid rgba(81, 43, 212, 0.2);
                position: relative;
                overflow: hidden;
            }

                .footer-custom::before {
                    content: '';
                    position: absolute;
                    top: -50%;
                    right: -20%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(81, 43, 212, 0.05), transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .footer-custom .footer-brand {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    transition: all 0.3s ease;
                }

                    .footer-custom .footer-brand:hover {
                        transform: scale(1.02);
                    }

                    .footer-custom .footer-brand img {
                        animation: float 4s ease-in-out infinite;
                    }

                .footer-custom h5 {
                    color: #fff;
                    font-weight: 600;
                    margin-bottom: 1.5rem;
                    position: relative;
                    display: inline-block;
                }

                    .footer-custom h5::after {
                        content: '';
                        position: absolute;
                        bottom: -8px;
                        left: 0;
                        width: 40px;
                        height: 3px;
                        background: linear-gradient(90deg, #FFC107, #FF6B6B);
                        border-radius: 2px;
                    }

                    .footer-custom h5.text-center::after {
                        left: 50%;
                        transform: translateX(-50%);
                    }

                .footer-custom .social-links a {
                    display: inline-block;
                    color: rgba(255, 255, 255, 0.6);
                    width: 42px;
                    height: 42px;
                    line-height: 42px;
                    text-align: center;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.05);
                    transition: all 0.3s ease;
                    font-size: 1.1rem;
                }

                    .footer-custom .social-links a:hover {
                        color: #fff;
                        background: rgba(81, 43, 212, 0.4);
                        transform: translateY(-5px) scale(1.1);
                        box-shadow: 0 8px 25px rgba(81, 43, 212, 0.3);
                    }

                    .footer-custom .social-links a:nth-child(1):hover {
                        background: rgba(36, 41, 46, 0.8);
                    }

                    .footer-custom .social-links a:nth-child(2):hover {
                        background: #1DA1F2;
                    }

                    .footer-custom .social-links a:nth-child(3):hover {
                        background: #FF0000;
                    }

                    .footer-custom .social-links a:nth-child(4):hover {
                        background: #0A66C2;
                    }

                .footer-custom ul li {
                    margin-bottom: 0.5rem;
                }

                    .footer-custom ul li a {
                        color: rgba(255, 255, 255, 0.6);
                        text-decoration: none;
                        transition: all 0.3s ease;
                        display: inline-block;
                        position: relative;
                    }

                        .footer-custom ul li a::before {
                            content: '›';
                            margin-right: 6px;
                            color: #FFC107;
                            opacity: 0;
                            transition: all 0.3s ease;
                        }

                        .footer-custom ul li a:hover {
                            color: #fff;
                            transform: translateX(8px);
                        }

                            .footer-custom ul li a:hover::before {
                                opacity: 1;
                            }

                .footer-custom hr {
                    border-color: rgba(255, 255, 255, 0.06);
                    margin: 2rem 0 1.5rem;
                }

                .footer-custom .footer-bottom {
                    color: rgba(255, 255, 255, 0.4);
                    font-size: 0.9rem;
                }

                    .footer-custom .footer-bottom .heart {
                        color: #FF6B6B;
                        display: inline-block;
                        animation: heartBeat 1.5s ease-in-out infinite;
                    }

            @@keyframes heartBeat {
                0%, 100% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.2);
                }
            }

            /* ===== RESPONSIVE ===== */
            @@media (max-width: 991.98px) {
                .navbar-collapse {
                    background: linear-gradient(135deg, #1a1a2e, #16213e);
                    padding: 1.5rem;
                    border-radius: 16px;
                    margin-top: 0.5rem;
                    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
                    border: 1px solid rgba(255, 255, 255, 0.05);
                }

                .navbar-custom .nav-link::after {
                    display: none;
                }

                .navbar-custom .nav-link:hover {
                    background: rgba(255, 255, 255, 0.05);
                }

                .navbar-custom .dropdown-menu {
                    background: rgba(255, 255, 255, 0.05);
                    border-radius: 12px;
                    margin: 0.5rem 0 0 1rem;
                    padding: 0.5rem 0;
                    box-shadow: none;
                    animation: none;
                }

                .navbar-custom .dropdown-item:hover {
                    transform: none;
                }

                .search-container {
                    top: 66px;
                }

                .footer-custom {
                    padding: 2.5rem 0 1.5rem;
                }

                    .footer-custom .footer-brand {
                        flex-wrap: wrap;
                    }
            }

            @@media (max-width: 576px) {
                .navbar-custom .navbar-brand {
                    font-size: 1rem;
                }

                    .navbar-custom .navbar-brand img {
                        height: 28px;
                    }

                .search-container {
                    top: 60px;
                }

                    .search-container .form-control {
                        font-size: 0.9rem;
                        padding: 0.5rem 1rem;
                    }

                .footer-custom h5 {
                    font-size: 1.1rem;
                }

                .footer-custom .social-links a {
                    width: 36px;
                    height: 36px;
                    line-height: 36px;
                    font-size: 0.9rem;
                }
            }
    </style>
</head>
