    <span style="color: #82aaff;">Age</span> <span style="color: #f78c6c;">INT</span>
);

<span class="comment">-- 5️⃣ Insert some data</span>
<span style="color: #ffcb6b;">INSERT INTO</span> <span style="color: #82aaff;">Students</span> (<span style="color: #82aaff;">Name</span>, <span style="color: #82aaff;">Age</span>)
