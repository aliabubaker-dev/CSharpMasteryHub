@page
@model CSharpMasteryHub.Pages.SqlServer.SelectWhereOrderByModel
@{
    ViewData["Title"] = "SELECT, WHERE, ORDER BY - Learn Like a Pro";
}

<div class="container-fluid px-0">
    <!-- 🎨 Hero Section - SQL Server Theme -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right" data-aos-duration="1000">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.7);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/SqlServer" style="color: rgba(255,255,255,0.7);">SQL Server</a></li>
                            <li class="breadcrumb-item active" style="color: white;">SELECT, WHERE, ORDER BY</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 0 0 30px rgba(0, 123, 255, 0.3);">
                        SELECT, WHERE, ORDER BY 🔍
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Find, Filter, and Sort Your Data - Two Ways!
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-success fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-smile me-2"></i>Beginner Friendly
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>20 min read
                        </span>
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 4 of 13
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left" data-aos-duration="1000">
                    <i class="fas fa-search fa-8x text-white" style="opacity: 0.15; text-shadow: 0 0 50px rgba(0, 123, 255, 0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- 🎉 Welcome Section -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #e8f0fe 0%, #d4e4f7 100%);">
                        <div class="card-body p-5">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-smile-wink fa-3x text-warning"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">Find, Filter, and Sort Your Data! 🎯</h2>
                                    <p class="fs-5">
                                        In this lesson, you'll learn the <strong>most important SQL commands</strong>:
                                        <strong>SELECT</strong> (get data), <strong>WHERE</strong> (filter data), and
                                        <strong>ORDER BY</strong> (sort data). You'll learn <strong>TWO ways</strong> to do this!
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>By the end of this lesson, you'll be able to:</strong>
                                        <ul class="mb-0 mt-2">
                                            <li>✅ SELECT data from tables (get what you need)</li>
                                            <li>✅ Filter data with WHERE (find specific records)</li>
                                            <li>✅ Sort data with ORDER BY (organize your results)</li>
                                            <li>✅ Use the SSMS visual designer (right-click menus)</li>
                                            <li>✅ Write SQL queries (the professional way)</li>
                                            <li>✅ Build real-world queries for any application!</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 📚 Part 1: SELECT - Getting Your Data -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="100">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-eye me-2"></i>Part 1: SELECT - Getting Your Data</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>What is SELECT?</strong> It's how you <strong>ask</strong> the database for data.
                                    Like saying "Show me all students" or "Show me just the names."
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-mouse-pointer text-primary me-2"></i>🖱️ Method 1: Visual (SSMS)</h5>
                                                <ol>
                                                    <li>Right-click your table → <strong>Select Top 1000 Rows</strong></li>
                                                    <li>This automatically generates the SELECT query</li>
                                                    <li>You can modify the query in the query window</li>
                                                    <li>Press <kbd>F5</kbd> to see the results</li>
                                                </ol>
                                                <div class="card bg-success text-white mt-2">
                                                    <div class="card-body">
                                                        <i class="fas fa-check-circle me-2"></i>
                                                        <strong>✅ No typing needed!</strong> Right-click and see data instantly!
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 Method 2: SQL Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- Get everything from the table</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>;

<span class="comment">-- Get only specific columns</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">FirstName</span>, <span style="color: #82aaff;">LastName</span> 
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>;

<span class="comment">-- Get unique values only</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">DISTINCT</span> <span style="color: #82aaff;">City</span> 
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>;</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>Key Points:</strong></p>
                                                <ul>
                                                    <li><code>*</code> = All columns</li>
                                                    <li><code>DISTINCT</code> = Unique values only</li>
                                                    <li>Always end with a semicolon <code>;</code></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Fun Joke:</strong> Why did the SELECT * FROM Students return nothing?
                                        Because the students were all hiding! (Bad database joke 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔍 Part 2: WHERE - Filtering Your Data -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="200">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-filter me-2"></i>Part 2: WHERE - Filtering Your Data</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>What is WHERE?</strong> It's like asking "Show me ONLY the students who..."
                                    It filters your data based on conditions.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-mouse-pointer text-primary me-2"></i>🖱️ Visual Way (Filter with Right-Click)</h5>
                                                <ol>
                                                    <li>Right-click your table → <strong>Select Top 1000 Rows</strong></li>
                                                    <li>In the query window, find <code>WHERE</code> clause</li>
                                                    <li>Type your condition, e.g., <code>WHERE LastName = 'Smith'</code></li>
                                                    <li>Press <kbd>F5</kbd> to see filtered results</li>
                                                </ol>
                                                <div class="card bg-success text-white mt-2">
                                                    <div class="card-body">
                                                        <i class="fas fa-check-circle me-2"></i>
                                                        <strong>💡 Pro Tip:</strong> You can also right-click a value in the results grid
                                                        and select "Filter by Selection"!
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 Code Way</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- Exact match</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">LastName</span> = <span style="color: #c3e88d;">'Smith'</span>;

<span class="comment">-- Greater than</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">Age</span> <span style="color: #ffcb6b;">></span> <span style="color: #f78c6c;">18</span>;

<span class="comment">-- Like - find patterns</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">Email</span> <span style="color: #ffcb6b;">LIKE</span> <span style="color: #c3e88d;">'%@@%'</span>;</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>Common WHERE Operators:</strong></p>
                                                <ul>
                                                    <li><code>=</code> Equal to</li>
                                                    <li><code>></code> Greater than</li>
                                                    <li><code><</code> Less than</li>
                                                    <li><code>LIKE</code> Pattern matching</li>
                                                    <li><code>IN</code> List of values</li>
                                                    <li><code>BETWEEN</code> Range of values</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="table-responsive mt-3">
                                    <table class="table table-bordered table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Operator</th>
                                                <th>What It Does</th>
                                                <th>Example</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><strong>=</strong></td>
                                                <td>Equal to</td>
                                                <td><code>WHERE Age = 25</code></td>
                                            </tr>
                                            <tr>
                                                <td><strong>></strong></td>
                                                <td>Greater than</td>
                                                <td><code>WHERE Age > 18</code></td>
                                            </tr>
                                            <tr>
                                                <td><strong><</strong></td>
                                                <td>Less than</td>
                                                <td><code>WHERE Age < 30</code></td>
                                            </tr>
                                            <tr>
                                                <td><strong>LIKE</strong></td>
                                                <td>Pattern matching</td>
                                                <td><code>WHERE Name LIKE 'J%'</code></td>
                                            </tr>
                                            <tr>
                                                <td><strong>IN</strong></td>
                                                <td>List of values</td>
                                                <td><code>WHERE City IN ('NYC', 'LA')</code></td>
                                            </tr>
                                            <tr>
                                                <td><strong>BETWEEN</strong></td>
                                                <td>Range</td>
                                                <td><code>WHERE Age BETWEEN 18 AND 25</code></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>💡 Pro Tip:</strong> Use <code>WHERE</code> to filter data BEFORE you sort it.
                                        It's faster and more efficient!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 📊 Part 3: ORDER BY - Sorting Your Data -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="300">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-sort me-2"></i>Part 3: ORDER BY - Sorting Your Data</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>What is ORDER BY?</strong> It sorts your results. Like putting names in alphabetical order
                                    or numbers from smallest to largest.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-mouse-pointer text-primary me-2"></i>🖱️ Visual Way (Sort with Right-Click)</h5>
                                                <ol>
                                                    <li>Run a SELECT query to see results</li>
                                                    <li>Click any column header in the results grid</li>
                                                    <li>Click again to sort descending</li>
                                                    <li>Or add <code>ORDER BY</code> to your query</li>
                                                </ol>
                                                <div class="card bg-success text-white mt-2">
                                                    <div class="card-body">
                                                        <i class="fas fa-check-circle me-2"></i>
                                                        <strong>✅ Easy!</strong> Just click the column header to sort!
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 Code Way</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- Sort A-Z (ascending)</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">LastName</span> <span style="color: #ffcb6b;">ASC</span>;

<span class="comment">-- Sort Z-A (descending)</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">Age</span> <span style="color: #ffcb6b;">DESC</span>;

<span class="comment">-- Multiple columns</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">LastName</span> <span style="color: #ffcb6b;">ASC</span>, <span style="color: #82aaff;">FirstName</span> <span style="color: #ffcb6b;">ASC</span>;</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>Key Points:</strong></p>
                                                <ul>
                                                    <li><code>ASC</code> = Ascending (A-Z, 1-10) - default</li>
                                                    <li><code>DESC</code> = Descending (Z-A, 10-1)</li>
                                                    <li>Can sort by multiple columns</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Fun Joke:</strong> Why did the developer sort their data?
                                        Because they wanted to get their affairs in order! (I'll show myself out 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔗 Part 4: Putting It All Together -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="400">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-link me-2"></i>Part 4: SELECT + WHERE + ORDER BY Together</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-star me-2"></i>
                                    <strong>Master Combination:</strong> Use all three together for powerful queries!
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 Complete Example</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- Find all students in a city, sorted by name</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">FirstName</span>, <span style="color: #82aaff;">LastName</span>, <span style="color: #82aaff;">City</span>, <span style="color: #82aaff;">Age</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">City</span> = <span style="color: #c3e88d;">'New York'</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">LastName</span> <span style="color: #ffcb6b;">ASC</span>;

<span class="comment">-- Adult students with high GPA, sorted by GPA</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">FirstName</span>, <span style="color: #82aaff;">LastName</span>, <span style="color: #82aaff;">GPA</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">Age</span> <span style="color: #ffcb6b;">>=</span> <span style="color: #f78c6c;">18</span> <span style="color: #ffcb6b;">AND</span> <span style="color: #82aaff;">GPA</span> <span style="color: #ffcb6b;">>=</span> <span style="color: #f78c6c;">3.5</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">GPA</span> <span style="color: #ffcb6b;">DESC</span>;

<span class="comment">-- Top 5 oldest students</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">TOP</span> <span style="color: #f78c6c;">5</span> <span style="color: #ffcb6b;">*</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">Age</span> <span style="color: #ffcb6b;">DESC</span>;</code></pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>✅ Real-World Examples</h5>
                                                <ul>
                                                    <li><strong>E-Commerce:</strong> "Show me all products under $50, sorted by price"</li>
                                                    <li><strong>CRM:</strong> "Find all customers from New York, sorted by name"</li>
                                                    <li><strong>School:</strong> "Show all students with GPA > 3.0, sorted by GPA"</li>
                                                    <li><strong>HR:</strong> "Find all employees hired after 2020, sorted by hire date"</li>
                                                </ul>
                                                <div class="card bg-success text-white mt-2">
                                                    <div class="card-body">
                                                        <i class="fas fa-check-circle me-2"></i>
                                                        <strong>🎯 Result:</strong> Exactly what you need, when you need it!
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>💡 Pro Tip:</strong> Always use <code>WHERE</code> before <code>ORDER BY</code>.
                                        Filter first, then sort. It's more efficient!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🎮 Part 5: Exercise -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="500">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-pencil-alt me-2"></i>Let's Practice! 🎮</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-success">
                                    <i class="fas fa-rocket me-2"></i>
                                    <strong>Your Challenge:</strong> Practice SELECT, WHERE, and ORDER BY with real data!
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6><i class="fas fa-list text-primary me-2"></i>Your Mission:</h6>
                                                <ol>
                                                    <li>
                                                        <strong>Set up sample data</strong>
                                                        <ul>
                                                            <li>Create a "Products" table</li>
                                                            <li>Columns: ProductId, Name, Category, Price, Stock</li>
                                                            <li>Insert 5-10 sample products</li>
                                                        </ul>
                                                    </li>
                                                    <li>
                                                        <strong>Write queries using BOTH methods:</strong>
                                                        <ul>
                                                            <li>🖱️ Visual: Right-click → Select Top 1000 Rows</li>
                                                            <li>💻 Code: Write SQL queries</li>
                                                        </ul>
                                                    </li>
                                                    <li>
                                                        <strong>Find:</strong>
                                                        <ul>
                                                            <li>All products under $50</li>
