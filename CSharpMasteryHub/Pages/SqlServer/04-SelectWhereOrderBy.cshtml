<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">Price</span> <span style="color: #ffcb6b;"><</span> <span style="color: #f78c6c;">50</span>;

<span class="comment">-- 2️⃣ All Electronics products</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Products</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">Category</span> = <span style="color: #c3e88d;">'Electronics'</span>;

<span class="comment">-- 3️⃣ Products with stock > 10, sorted by price</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Products</span>
<span style="color: #ffcb6b;">WHERE</span> <span style="color: #82aaff;">Stock</span> <span style="color: #ffcb6b;">></span> <span style="color: #f78c6c;">10</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">Price</span> <span style="color: #ffcb6b;">ASC</span>;

<span class="comment">-- 4️⃣ Top 5 most expensive products</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">TOP</span> <span style="color: #f78c6c;">5</span> <span style="color: #ffcb6b;">*</span> <span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Products</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">Price</span> <span style="color: #ffcb6b;">DESC</span>;

