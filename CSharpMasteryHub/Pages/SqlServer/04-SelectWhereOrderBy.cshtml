    (<span style="color: #c3e88d;">'Desk'</span>, <span style="color: #c3e88d;">'Furniture'</span>, <span style="color: #f78c6c;">199.99</span>, <span style="color: #f78c6c;">5</span>),
    (<span style="color: #c3e88d;">'Chair'</span>, <span style="color: #c3e88d;">'Furniture'</span>, <span style="color: #f78c6c;">149.99</span>, <span style="color: #f78c6c;">8</span>);
<span style="color: #ffcb6b;">GO</span>

<span class="comment">-- Step 3: Practice Queries</span>

<span class="comment">-- 1️⃣ All products under $50</span>
