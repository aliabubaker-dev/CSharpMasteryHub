                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-sort me-2"></i>
                                    <strong>ORDER BY:</strong> This command sorts your data. Like saying "Show me students sorted by name!"
                                </div>

                                <div class="code-block">
                                    <pre><code class="language-csharp"><span class="comment">// ===== SORT BY NAME =====</span>
<span class="comment">// This method uses ORDER BY to sort students by last name</span>

<span class="keyword">private void</span> <span class="function">SortByName</span>()
{
    <span class="keyword">try</span>
    {
        <span class="keyword">using</span> (<span class="keyword">var</span> conn = <span class="keyword">new</span> <span class="class">SqlConnection</span>(connectionString))
        {
            <span class="comment">// 1️⃣ SELECT with ORDER BY clause</span>
            <span class="keyword">string</span> query = <span class="string">"SELECT StudentId, FirstName, LastName, Age, City "</span> +
                          <span class="string">"FROM Students ORDER BY LastName ASC"</span>;
            
            <span class="keyword">using</span> (<span class="keyword">var</span> adapter = <span class="keyword">new</span> <span class="class">SqlDataAdapter</span>(query, conn))
            {
                <span class="class">DataTable</span> dt = <span class="keyword">new</span> <span class="class">DataTable</span>();
                adapter.<span class="function">Fill</span>(dt);
                
                dgvStudents.DataSource = dt;
                
                lblStatus.Text = <span class="string">$"📊 Sorted by Last Name (A-Z)"</span>;
                lblStatus.ForeColor = Color.Green;
            }
        }
    }
    <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
    {
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Error: {ex.Message}"</span>, <span class="string">"Database Error"</span>);
    }
}

<span class="comment">// ===== SORT BY AGE (Descending) =====</span>
<span class="comment">// This method uses ORDER BY to sort students by age (oldest first)</span>

<span class="keyword">private void</span> <span class="function">SortByAgeDescending</span>()
{
    <span class="keyword">try</span>
    {
        <span class="keyword">using</span> (<span class="keyword">var</span> conn = <span class="keyword">new</span> <span class="class">SqlConnection</span>(connectionString))
        {
            <span class="comment">// ORDER BY with DESC (descending)</span>
            <span class="keyword">string</span> query = <span class="string">"SELECT StudentId, FirstName, LastName, Age, City "</span> +
                          <span class="string">"FROM Students ORDER BY Age DESC"</span>;
            
            <span class="keyword">using</span> (<span class="keyword">var</span> adapter = <span class="keyword">new</span> <span class="class">SqlDataAdapter</span>(query, conn))
            {
                <span class="class">DataTable</span> dt = <span class="keyword">new</span> <span class="class">DataTable</span>();
                adapter.<span class="function">Fill</span>(dt);
                
                dgvStudents.DataSource = dt;
                
                lblStatus.Text = <span class="string">$"📊 Sorted by Age (Oldest First)"</span>;
                lblStatus.ForeColor = Color.Green;
            }
        }
    }
