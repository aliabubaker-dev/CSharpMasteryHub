                    <!-- 🔍 Part 4: WHERE - Filtering Data -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="400">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>Step 4: WHERE - Filtering Data</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-filter me-2"></i>
                                    <strong>WHERE:</strong> This command filters data. Like saying "Show me ONLY students from New York!"
                                </div>

                                <div class="code-block">
                                    <pre><code class="language-csharp"><span class="comment">// ===== FILTER BY CITY =====</span>
<span class="comment">// This method uses WHERE to filter students by city</span>

<span class="keyword">private void</span> <span class="function">FilterByCity</span>(<span class="keyword">string</span> city)
{
    <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(city))
    {
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Please enter a city name!"</span>);
        <span class="keyword">return</span>;
    }
    
    <span class="keyword">try</span>
    {
        <span class="keyword">using</span> (<span class="keyword">var</span> conn = <span class="keyword">new</span> <span class="class">SqlConnection</span>(connectionString))
        {
            <span class="comment">// 1️⃣ SELECT with WHERE clause</span>
            <span class="keyword">string</span> query = <span class="string">"SELECT StudentId, FirstName, LastName, Age, City "</span> +
                          <span class="string">"FROM Students WHERE City = @@City"</span>;
            
            <span class="comment">// 2️⃣ Create command with parameter (prevents SQL injection)</span>
            <span class="keyword">using</span> (<span class="keyword">var</span> cmd = <span class="keyword">new</span> <span class="class">SqlCommand</span>(query, conn))
            {
                cmd.Parameters.AddWithValue(<span class="string">"@@City"</span>, city);
                
                <span class="keyword">using</span> (<span class="keyword">var</span> adapter = <span class="keyword">new</span> <span class="class">SqlDataAdapter</span>(cmd))
                {
                    <span class="class">DataTable</span> dt = <span class="keyword">new</span> <span class="class">DataTable</span>();
                    adapter.<span class="function">Fill</span>(dt);
                    
                    dgvStudents.DataSource = dt;
                    
                    lblStatus.Text = <span class="string">$"🔍 Found {dt.Rows.Count} students in {city}"</span>;
                    lblStatus.ForeColor = Color.Blue;
                }
            }
        }
    }
    <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
    {
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Error: {ex.Message}"</span>, <span class="string">"Database Error"</span>);
    }
}

<span class="comment">// ===== FILTER BY AGE =====</span>
<span class="comment">// This method uses WHERE to filter students older than a certain age</span>

<span class="keyword">private void</span> <span class="function">FilterByAge</span>(<span class="keyword">int</span> minAge)
{
    <span class="keyword">if</span> (minAge <= <span class="number">0</span>)
    {
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Please enter a valid age!"</span>);
        <span class="keyword">return</span>;
    }
    
    <span class="keyword">try</span>
    {
        <span class="keyword">using</span> (<span class="keyword">var</span> conn = <span class="keyword">new</span> <span class="class">SqlConnection</span>(connectionString))
        {
            <span class="comment">// WHERE with greater than operator</span>
            <span class="keyword">string</span> query = <span class="string">"SELECT StudentId, FirstName, LastName, Age, City "</span> +
                          <span class="string">"FROM Students WHERE Age >= @@MinAge"</span>;
            
            <span class="keyword">using</span> (<span class="keyword">var</span> cmd = <span class="keyword">new</span> <span class="class">SqlCommand</span>(query, conn))
            {
                cmd.Parameters.AddWithValue(<span class="string">"@@MinAge"</span>, minAge);
                
                <span class="keyword">using</span> (<span class="keyword">var</span> adapter = <span class="keyword">new</span> <span class="class">SqlDataAdapter</span>(cmd))
                {
                    <span class="class">DataTable</span> dt = <span class="keyword">new</span> <span class="class">DataTable</span>();
                    adapter.<span class="function">Fill</span>(dt);
                    
                    dgvStudents.DataSource = dt;
                    
                    lblStatus.Text = <span class="string">$"🔍 Found {dt.Rows.Count} students older than {minAge}"</span>;
                    lblStatus.ForeColor = Color.Blue;
                }
            }
        }
    }
    <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
    {
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Error: {ex.Message}"</span>, <span class="string">"Database Error"</span>);
    }
}</code></pre>
                                </div>
