<span style="color: #ffcb6b;">VALUES</span> 
    (<span style="color: #c3e88d;">'Laptop'</span>, <span style="color: #c3e88d;">'Electronics'</span>, <span style="color: #f78c6c;">999.99</span>, <span style="color: #f78c6c;">10</span>),
    (<span style="color: #c3e88d;">'Mouse'</span>, <span style="color: #c3e88d;">'Electronics'</span>, <span style="color: #f78c6c;">25.50</span>, <span style="color: #f78c6c;">50</span>),
    (<span style="color: #c3e88d;">'Keyboard'</span>, <span style="color: #c3e88d;">'Electronics'</span>, <span style="color: #f78c6c;">45.00</span>, <span style="color: #f78c6c;">30</span>),
