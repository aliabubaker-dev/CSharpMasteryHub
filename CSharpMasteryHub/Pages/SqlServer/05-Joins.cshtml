<span class="comment">-- 3️⃣ JOIN PRACTICE</span>

<span class="comment">-- 🔹 INNER JOIN: Customers with orders</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #ffcb6b;">DISTINCT</span> <span style="color: #82aaff;">c.Name</span>, <span style="color: #82aaff;">c.City</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Customers</span> <span style="color: #82aaff;">c</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Orders</span> <span style="color: #82aaff;">o</span> <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">o.CustomerId</span> = <span style="color: #82aaff;">c.CustomerId</span>;

<span class="comment">-- 🔹 LEFT JOIN: All customers + their orders</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">c.Name</span>, <span style="color: #82aaff;">o.OrderId</span>, <span style="color: #82aaff;">o.OrderDate</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Customers</span> <span style="color: #82aaff;">c</span>
<span style="color: #ffcb6b;">LEFT JOIN</span> <span style="color: #82aaff;">Orders</span> <span style="color: #82aaff;">o</span> <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">o.CustomerId</span> = <span style="color: #82aaff;">c.CustomerId</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">c.Name</span>;

<span class="comment">-- 🔹 RIGHT JOIN: All products + order items</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">p.Name</span> <span style="color: #ffcb6b;">AS</span> <span style="color: #82aaff;">Product</span>, <span style="color: #ffcb6b;">ISNULL</span>(<span style="color: #82aaff;">SUM</span>(<span style="color: #82aaff;">oi.Quantity</span>), <span style="color: #f78c6c;">0</span>) <span style="color: #ffcb6b;">AS</span> <span style="color: #82aaff;">TotalSold</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">OrderItems</span> <span style="color: #82aaff;">oi</span>
<span style="color: #ffcb6b;">RIGHT JOIN</span> <span style="color: #82aaff;">Products</span> <span style="color: #82aaff;">p</span> <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">p.ProductId</span> = <span style="color: #82aaff;">oi.ProductId</span>
<span style="color: #ffcb6b;">GROUP BY</span> <span style="color: #82aaff;">p.Name</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">TotalSold</span> <span style="color: #ffcb6b;">DESC</span>;

<span class="comment">-- 🔹 4-Table JOIN: Customer → Orders → OrderItems → Products</span>
<span style="color: #ffcb6b;">SELECT</span> 
    <span style="color: #82aaff;">c.Name</span> <span style="color: #ffcb6b;">AS</span> <span style="color: #82aaff;">Customer</span>,
    <span style="color: #82aaff;">o.OrderId</span>,
    <span style="color: #82aaff;">o.OrderDate</span>,
    <span style="color: #82aaff;">p.Name</span> <span style="color: #ffcb6b;">AS</span> <span style="color: #82aaff;">Product</span>,
    <span style="color: #82aaff;">oi.Quantity</span>,
    <span style="color: #82aaff;">p.Price</span>,
    <span style="color: #82aaff;">oi.Quantity</span> <span style="color: #ffcb6b;">*</span> <span style="color: #82aaff;">p.Price</span> <span style="color: #ffcb6b;">AS</span> <span style="color: #82aaff;">Total</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Customers</span> <span style="color: #82aaff;">c</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Orders</span> <span style="color: #82aaff;">o</span> <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">o.CustomerId</span> = <span style="color: #82aaff;">c.CustomerId</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">OrderItems</span> <span style="color: #82aaff;">oi</span> <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">oi.OrderId</span> = <span style="color: #82aaff;">o.OrderId</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Products</span> <span style="color: #82aaff;">p</span> <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">p.ProductId</span> = <span style="color: #82aaff;">oi.ProductId</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">c.Name</span>, <span style="color: #82aaff;">o.OrderDate</span>;</code></pre>
