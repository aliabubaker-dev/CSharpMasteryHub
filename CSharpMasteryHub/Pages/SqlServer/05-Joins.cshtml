                            </div>
                            <div class="card-body p-4">
                                <div class="code-block">
                                    <pre><code class="language-csharp"><span class="comment">// ===== 4-TABLE JOIN - Complete Student Report =====</span>

<span class="keyword">private void</span> <span class="function">LoadCompleteReport</span>()
{
