@page
@model CSharpMasteryHub.Pages.SqlServer.JoinsModel
@{
    ViewData["Title"] = "Joins";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/SqlServer">SQL Server</a></li>
                    <li class="breadcrumb-item active">Joins</li>
                </ol>
            </nav>

            <div class="lesson-content">
                <h1 class="display-4 mb-3">Joins</h1>
                <div class="d-flex gap-3 mb-4">
                    <span class="badge bg-warning text-dark">Intermediate</span>
                    <span class="badge bg-info text-dark">25 min read</span>
                    <span class="badge bg-primary">Lesson 5 of 10</span>
                </div>

                <p>Joins combine rows from two or more tables based on a related column.</p>

                <h2>INNER JOIN — only matching rows</h2>
                <pre><code>SELECT s.FirstName, s.LastName, e.CourseId
FROM Students s
INNER JOIN Enrollments e ON e.StudentId = s.StudentId;</code></pre>

                <h2>LEFT JOIN — all rows from the left table, matched or not</h2>
                <pre><code>SELECT s.FirstName, e.CourseId
FROM Students s
LEFT JOIN Enrollments e ON e.StudentId = s.StudentId;
-- students with no enrollments show CourseId as NULL</code></pre>

                <h2>RIGHT JOIN and FULL JOIN</h2>
                <p>
                    <code>RIGHT JOIN</code> is the mirror of <code>LEFT JOIN</code>.
                    <code>FULL JOIN</code> returns all rows from both sides, matched where possible.
                </p>

                <h2>Joining three tables</h2>
                <pre><code>SELECT s.FirstName, c.Title
FROM Students s
INNER JOIN Enrollments e ON e.StudentId = s.StudentId
INNER JOIN Courses c ON c.CourseId = e.CourseId;</code></pre>

                <h2>Rule of thumb</h2>
                <p>
                    Use <code>INNER JOIN</code> when you only want records that exist on both
                    sides. Use <code>LEFT JOIN</code> when you want everything from your main
                    table even if there's no match — very common for reports ("show all
                    students, including ones with zero enrollments").
                </p>

                <div class="card bg-info bg-opacity-10 mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>Joins are essential for relational databases. INNER JOIN returns only matching rows, LEFT JOIN returns all rows from the left table.</p>
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between">
                    <a href="/SqlServer/04-SelectWhereOrderBy" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Previous Lesson
                    </a>
                    <a href="/SqlServer/06-InsertUpdateDelete" class="btn btn-primary-custom">
                        Next Lesson <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            @await Html.PartialAsync("_SidebarNav", Model.SidebarNav)
        </div>
    </div>
</div>


@await Html.PartialAsync("_QuizButton", "SqlServer_Lesson5")