@page
@model CSharpMasteryHub.Pages.SqlServer.JoinsModel
@{
    ViewData["Title"] = "Joins - Master Guide";
}

<div class="container-fluid px-0">
    <!-- 🎨 Hero Section - SQL Server Theme -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right" data-aos-duration="1000">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.7);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/SqlServer" style="color: rgba(255,255,255,0.7);">SQL Server</a></li>
                            <li class="breadcrumb-item active" style="color: white;">Joins</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 0 0 30px rgba(0, 123, 255, 0.3);">
                        Joins 🔗
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Master the Art of Connecting Tables
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-success fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-smile me-2"></i>Beginner Friendly
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>30 min read
                        </span>
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 5 of 13
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left" data-aos-duration="1000">
                    <i class="fas fa-link fa-8x text-white" style="opacity: 0.15; text-shadow: 0 0 50px rgba(0, 123, 255, 0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- 🎉 Welcome Section -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #e8f0fe 0%, #d4e4f7 100%);">
                        <div class="card-body p-5">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-smile-wink fa-3x text-warning"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">Master the Art of Joining Tables! 🎯</h2>
                                    <p class="fs-5">
                                        <strong>Joins</strong> are the most powerful feature in SQL. They allow you to
                                        <strong>combine data</strong> from multiple tables to answer complex questions.
                                        This is what makes relational databases so powerful!
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>By the end of this lesson, you'll be able to:</strong>
                                        <ul class="mb-0 mt-2">
                                            <li>✅ Understand ALL join types (INNER, LEFT, RIGHT, FULL, CROSS)</li>
                                            <li>✅ Know exactly when to use each join type</li>
                                            <li>✅ Join 3, 4, or even 5 tables together</li>
                                            <li>✅ Use the visual Query Designer (drag & drop)</li>
                                            <li>✅ Write complex join queries like a pro</li>
                                            <li>✅ Build real-world reports with multiple tables</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 📚 Part 1: Why Joins Matter -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="100">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-question-circle me-2"></i>Part 1: Why Do We Need Joins?</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>In Simple Words:</strong> In a relational database, data is split across multiple tables
                                    to avoid duplication. Joins let you <strong>bring it back together</strong> when you need it!
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-database text-primary me-2"></i>📊 Why Split Data?</h5>
                                                <p><strong>Without splitting (BAD):</strong></p>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- One big table with duplicated data</span>
<span style="color: #82aaff;">Students</span>
+----+-------+--------+------------+
| ID | Name  | Course | Instructor |
+----+-------+--------+------------+
| 1  | John  | Math   | Dr. Smith  |
| 2  | Jane  | Math   | Dr. Smith  | <span class="comment">-- Duplicate!</span>
| 3  | John  | Sci    | Dr. Jones  |
+----+-------+--------+------------+</code></pre>
                                                </div>
                                                <p class="text-danger">❌ Wasted space, hard to update!</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>✅ With Splitting (GOOD)</h5>
                                                <p><strong>Separate tables with relationships:</strong></p>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span style="color: #82aaff;">Students</span>     <span style="color: #82aaff;">Courses</span>      <span style="color: #82aaff;">Enrollments</span>
+----+-------+  +----+------+  +----+--------+----------+
| ID | Name  |  | ID | Title|  | ID | StuID  | CourseID |
+----+-------+  +----+------+  +----+--------+----------+
| 1  | John  |  | 1  | Math |  | 1  | 1      | 1        |
| 2  | Jane  |  | 2  | Sci  |  | 2  | 2      | 1        |
+----+-------+  +----+------+  +----+--------+----------+</code></pre>
                                                </div>
                                                <p class="text-success">✅ No duplication! JOIN to combine!</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>💡 Key Insight:</strong> Joins are how you <strong>answer questions</strong> that involve multiple tables.
                                        "Show me all students and their courses" = JOIN Students + Enrollments + Courses.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🎯 Part 2: INNER JOIN - The Most Common -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="200">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-1 me-2"></i>INNER JOIN - Only Matches</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>What it does:</strong> Returns only rows that have a <strong>match</strong> in BOTH tables.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-venn-diagram text-primary me-2"></i>🎯 Visual Representation</h5>
                                                <div class="text-center">
                                                    <div style="background: #1a1a2e; padding: 20px; border-radius: 12px; color: white;">
                                                        <div style="display: flex; justify-content: center; align-items: center; gap: 20px;">
                                                            <div style="border: 2px solid #4facfe; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                                                Table A<br>Students
                                                            </div>
                                                            <div style="background: #4facfe; padding: 5px 15px; border-radius: 20px; color: white; font-weight: bold;">
                                                                INNER JOIN
                                                            </div>
                                                            <div style="border: 2px solid #43e97b; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                                                Table B<br>Courses
                                                            </div>
                                                        </div>
                                                        <div style="margin-top: 10px; padding: 10px; background: #2a2a4e; border-radius: 8px;">
                                                            <span style="color: #ffcb6b;">✅ Returns only students WITH courses</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 INNER JOIN Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- INNER JOIN - Students with courses</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">s.Name</span>, <span style="color: #82aaff;">c.Title</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span> <span style="color: #82aaff;">s</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Enrollments</span> <span style="color: #82aaff;">e</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">e.StudentId</span> = <span style="color: #82aaff;">s.StudentId</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Courses</span> <span style="color: #82aaff;">c</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">c.CourseId</span> = <span style="color: #82aaff;">e.CourseId</span>;

<span class="comment">-- Result: Only students who are enrolled</span>
<span class="comment">-- Students with NO enrollments won't show</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>When to use:</strong> When you ONLY want records that exist in both tables.</p>
                                                <p><span class="badge bg-success">✅</span> <strong>Example:</strong> "Show me all employees who have sales"</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔄 Part 3: LEFT JOIN - Keep Everything on Left -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="300">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-2 me-2"></i>LEFT JOIN - Keep All Left Table Rows</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    <strong>What it does:</strong> Returns ALL rows from the LEFT table, and matching rows from the RIGHT table.
                                    If no match, NULL is returned for right table columns.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-venn-diagram text-warning me-2"></i>🎯 Visual Representation</h5>
                                                <div class="text-center">
                                                    <div style="background: #1a1a2e; padding: 20px; border-radius: 12px; color: white;">
                                                        <div style="display: flex; justify-content: center; align-items: center; gap: 20px;">
                                                            <div style="border: 2px solid #f093fb; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px; background: rgba(240, 147, 251, 0.1);">
                                                                ALL<br>Students
                                                            </div>
                                                            <div style="background: #f093fb; padding: 5px 15px; border-radius: 20px; color: white; font-weight: bold;">
                                                                LEFT JOIN
                                                            </div>
                                                            <div style="border: 2px solid #43e97b; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                                                Courses<br>(if any)
                                                            </div>
                                                        </div>
                                                        <div style="margin-top: 10px; padding: 10px; background: #2a2a4e; border-radius: 8px;">
                                                            <span style="color: #ffcb6b;">✅ ALL students + their courses (NULL if none)</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 LEFT JOIN Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- LEFT JOIN - All students</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">s.Name</span>, <span style="color: #82aaff;">c.Title</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span> <span style="color: #82aaff;">s</span>
<span style="color: #ffcb6b;">LEFT JOIN</span> <span style="color: #82aaff;">Enrollments</span> <span style="color: #82aaff;">e</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">e.StudentId</span> = <span style="color: #82aaff;">s.StudentId</span>
<span style="color: #ffcb6b;">LEFT JOIN</span> <span style="color: #82aaff;">Courses</span> <span style="color: #82aaff;">c</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">c.CourseId</span> = <span style="color: #82aaff;">e.CourseId</span>;

<span class="comment">-- Result: ALL students show up</span>
<span class="comment">-- Students with no courses show NULL</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>When to use:</strong> When you want ALL records from the main table, even if they have no matches.</p>
                                                <p><span class="badge bg-success">✅</span> <strong>Example:</strong> "Show all students (even those with no courses)"</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>💡 Pro Tip:</strong> LEFT JOIN is the most common join type in real-world reports.
                                        You almost always want to see ALL records from your main table!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔄 Part 4: RIGHT JOIN -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="400">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-3 me-2"></i>RIGHT JOIN - Keep All Right Table Rows</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-arrow-right me-2"></i>
                                    <strong>What it does:</strong> Returns ALL rows from the RIGHT table, and matching rows from the LEFT table.
                                    This is the mirror image of LEFT JOIN.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-venn-diagram text-info me-2"></i>🎯 Visual Representation</h5>
                                                <div class="text-center">
                                                    <div style="background: #1a1a2e; padding: 20px; border-radius: 12px; color: white;">
                                                        <div style="display: flex; justify-content: center; align-items: center; gap: 20px;">
                                                            <div style="border: 2px solid #4facfe; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                                                Students<br>(if any)
                                                            </div>
                                                            <div style="background: #667eea; padding: 5px 15px; border-radius: 20px; color: white; font-weight: bold;">
                                                                RIGHT JOIN
                                                            </div>
                                                            <div style="border: 2px solid #f093fb; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px; background: rgba(240, 147, 251, 0.1);">
                                                                ALL<br>Courses
                                                            </div>
                                                        </div>
                                                        <div style="margin-top: 10px; padding: 10px; background: #2a2a4e; border-radius: 8px;">
                                                            <span style="color: #ffcb6b;">✅ ALL courses + students enrolled (NULL if none)</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 RIGHT JOIN Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- RIGHT JOIN - All courses</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">s.Name</span>, <span style="color: #82aaff;">c.Title</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span> <span style="color: #82aaff;">s</span>
<span style="color: #ffcb6b;">RIGHT JOIN</span> <span style="color: #82aaff;">Enrollments</span> <span style="color: #82aaff;">e</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">e.StudentId</span> = <span style="color: #82aaff;">s.StudentId</span>
<span style="color: #ffcb6b;">RIGHT JOIN</span> <span style="color: #82aaff;">Courses</span> <span style="color: #82aaff;">c</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">c.CourseId</span> = <span style="color: #82aaff;">e.CourseId</span>;

<span class="comment">-- Result: ALL courses show up</span>
<span class="comment">-- Courses with no students show NULL</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>When to use:</strong> When you want ALL records from the right table.</p>
                                                <p><span class="badge bg-success">✅</span> <strong>Example:</strong> "Show all courses (even those with no students enrolled)"</p>
                                                <div class="alert alert-info mt-2">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    <strong>💡 Note:</strong> RIGHT JOIN is less common because you can just flip the tables and use LEFT JOIN.
                                                    Most developers prefer LEFT JOIN for readability.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🔄 Part 5: FULL JOIN -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="500">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>FULL JOIN - Keep Everything</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-arrows-alt-h me-2"></i>
                                    <strong>What it does:</strong> Returns ALL rows from BOTH tables. Matching rows are combined,
                                    unmatched rows show NULL for the missing side.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-venn-diagram text-danger me-2"></i>🎯 Visual Representation</h5>
                                                <div class="text-center">
                                                    <div style="background: #1a1a2e; padding: 20px; border-radius: 12px; color: white;">
                                                        <div style="display: flex; justify-content: center; align-items: center; gap: 20px;">
                                                            <div style="border: 2px solid #f093fb; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px; background: rgba(240, 147, 251, 0.1);">
                                                                ALL<br>Students
                                                            </div>
                                                            <div style="background: #f5576c; padding: 5px 15px; border-radius: 20px; color: white; font-weight: bold;">
                                                                FULL JOIN
                                                            </div>
                                                            <div style="border: 2px solid #f093fb; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px; background: rgba(240, 147, 251, 0.1);">
                                                                ALL<br>Courses
                                                            </div>
                                                        </div>
                                                        <div style="margin-top: 10px; padding: 10px; background: #2a2a4e; border-radius: 8px;">
                                                            <span style="color: #ffcb6b;">✅ EVERYTHING - students AND courses</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 FULL JOIN Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- FULL JOIN - Everything</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">s.Name</span>, <span style="color: #82aaff;">c.Title</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span> <span style="color: #82aaff;">s</span>
<span style="color: #ffcb6b;">FULL JOIN</span> <span style="color: #82aaff;">Enrollments</span> <span style="color: #82aaff;">e</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">e.StudentId</span> = <span style="color: #82aaff;">s.StudentId</span>
<span style="color: #ffcb6b;">FULL JOIN</span> <span style="color: #82aaff;">Courses</span> <span style="color: #82aaff;">c</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">c.CourseId</span> = <span style="color: #82aaff;">e.CourseId</span>;

<span class="comment">-- Result: EVERYTHING shows up</span>
<span class="comment">-- Students with no courses show NULL</span>
<span class="comment">-- Courses with no students show NULL</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>When to use:</strong> When you need to see ALL records from both tables.</p>
                                                <p><span class="badge bg-success">✅</span> <strong>Example:</strong> "Show all students AND all courses, regardless of enrollment"</p>
                                                <div class="alert alert-warning mt-2">
                                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                                    <strong>⚠️ Note:</strong> FULL JOIN can return a lot of NULLs. Use it carefully!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🎯 Part 6: CROSS JOIN -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="600">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-5 me-2"></i>CROSS JOIN - Every Combination</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-times me-2"></i>
                                    <strong>What it does:</strong> Returns the <strong>Cartesian product</strong> - every row from Table A
                                    combined with every row from Table B. (All possible combinations!)
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 CROSS JOIN Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- CROSS JOIN - All combinations</span>
<span style="color: #ffcb6b;">SELECT</span> <span style="color: #82aaff;">s.Name</span>, <span style="color: #82aaff;">c.Title</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span> <span style="color: #82aaff;">s</span>
<span style="color: #ffcb6b;">CROSS JOIN</span> <span style="color: #82aaff;">Courses</span> <span style="color: #82aaff;">c</span>;

<span class="comment">-- If you have 3 students and 4 courses</span>
<span class="comment">-- You get 3 × 4 = 12 rows!</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>When to use:</strong> Generating combinations, testing, or creating all possible pairs.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-table text-success me-2"></i>📊 Example Result</h5>
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-sm">
                                                        <thead class="table-dark">
                                                            <tr><th>Student</th><th>Course</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr><td>John</td><td>Math</td></tr>
                                                            <tr><td>John</td><td>Science</td></tr>
                                                            <tr><td>John</td><td>History</td></tr>
                                                            <tr><td>Jane</td><td>Math</td></tr>
                                                            <tr><td>Jane</td><td>Science</td></tr>
                                                            <tr><td>Jane</td><td>History</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <p><span class="badge bg-success">✅</span> Every student paired with every course!</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-danger text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>⚠️ Warning:</strong> CROSS JOIN can create HUGE result sets!
                                        If you have 1000 students and 100 courses, you get 100,000 rows!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 📊 Part 7: Joining Multiple Tables -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="700">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-6 me-2"></i>Joining Multiple Tables (3+)</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-plus-circle me-2"></i>
                                    <strong>What it does:</strong> Combines data from 3 or more tables to answer complex questions.
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-diagram-project text-primary me-2"></i>📊 3-Table Join Diagram</h5>
                                                <div class="text-center">
                                                    <div style="background: #1a1a2e; padding: 20px; border-radius: 12px; color: white;">
                                                        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;">
                                                            <div style="border: 2px solid #4facfe; padding: 8px 12px; border-radius: 8px;">
                                                                Students
                                                            </div>
                                                            <span style="color: #89ddff;">🔗</span>
                                                            <div style="border: 2px solid #43e97b; padding: 8px 12px; border-radius: 8px;">
                                                                Enrollments
                                                            </div>
                                                            <span style="color: #89ddff;">🔗</span>
                                                            <div style="border: 2px solid #f093fb; padding: 8px 12px; border-radius: 8px;">
                                                                Courses
                                                            </div>
                                                        </div>
                                                        <div style="margin-top: 10px; padding: 10px; background: #2a2a4e; border-radius: 8px; font-size: 12px;">
                                                            <span style="color: #c3e88d;">Students have Enrollments → Enrollments are for Courses</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-code text-primary me-2"></i>💻 3-Table Join Code</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-sql"><span class="comment">-- Show students with their courses</span>
<span style="color: #ffcb6b;">SELECT</span> 
    <span style="color: #82aaff;">s.FirstName</span>,
    <span style="color: #82aaff;">s.LastName</span>,
    <span style="color: #82aaff;">c.Title</span> <span style="color: #ffcb6b;">AS</span> <span style="color: #82aaff;">Course</span>,
    <span style="color: #82aaff;">c.Credits</span>
<span style="color: #ffcb6b;">FROM</span> <span style="color: #82aaff;">Students</span> <span style="color: #82aaff;">s</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Enrollments</span> <span style="color: #82aaff;">e</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">e.StudentId</span> = <span style="color: #82aaff;">s.StudentId</span>
<span style="color: #ffcb6b;">INNER JOIN</span> <span style="color: #82aaff;">Courses</span> <span style="color: #82aaff;">c</span>
    <span style="color: #ffcb6b;">ON</span> <span style="color: #82aaff;">c.CourseId</span> = <span style="color: #82aaff;">e.CourseId</span>
<span style="color: #ffcb6b;">ORDER BY</span> <span style="color: #82aaff;">s.LastName</span>;

<span class="comment">-- Add more tables: Departments, Instructors, etc.</span></code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">📌</span> <strong>Order matters:</strong> Start with the main table, then add related tables.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>💡 Pro Tip:</strong> When joining multiple tables, think of it as a <strong>chain</strong>.
                                        Each join connects two tables, forming a chain from your starting point to your final data.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 📊 Part 8: Join Comparison Table -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="800">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #0f3460;">
                            <div class="card-header" style="background: linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-7 me-2"></i>Quick Reference: Which Join to Use?</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Join Type</th>
                                                <th>What It Returns</th>
                                                <th>Real-World Example</th>
                                                <th>When to Use</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><span class="badge bg-primary">INNER</span></td>
                                                <td>Only matching rows</td>
                                                <td>Students with courses</td>
                                                <td>When you only want records that exist in both tables</td>
                                            </tr>
                                            <tr>
                                                <td><span class="badge bg-warning">LEFT</span></td>
                                                <td>All rows from left, matches from right</td>
                                                <td>All students, with courses if they have any</td>
                                                <td><strong>Most common!</strong> When you want all records from your main table</td>
                                            </tr>
                                            <tr>
                                                <td><span class="badge bg-info">RIGHT</span></td>
                                                <td>All rows from right, matches from left</td>
                                                <td>All courses, with students if any</td>
                                                <td>When you want all records from the right table</td>
                                            </tr>
                                            <tr>
                                                <td><span class="badge bg-danger">FULL</span></td>
                                                <td>All rows from both tables</td>
                                                <td>All students AND all courses</td>
                                                <td>When you need everything from both tables</td>
                                            </tr>
                                            <tr>
                                                <td><span class="badge bg-secondary">CROSS</span></td>
                                                <td>Every combination</td>
                                                <td>All students paired with all courses</td>
                                                <td>Generating all possible combinations</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-star me-2"></i>
                                        <strong>💡 The 80/20 Rule:</strong>
                                        <br>80% of your joins will be <strong>INNER JOIN</strong> and <strong>LEFT JOIN</strong>.
                                        Master these two and you'll handle most real-world scenarios!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

