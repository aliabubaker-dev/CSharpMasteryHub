                                            <pre><code class="language-sql"><span class="comment">-- ===== SALES DATABASE - COMPLETE SOLUTION =====</span>

<span class="comment">-- 1️⃣ CREATE TABLES</span>
<span style="color: #ffcb6b;">CREATE TABLE</span> <span style="color: #82aaff;">Customers</span> (
