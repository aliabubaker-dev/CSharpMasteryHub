    (<span style="color: #f78c6c;">3</span>, <span style="color: #f78c6c;">5</span>, <span style="color: #f78c6c;">1</span>),
    (<span style="color: #f78c6c;">4</span>, <span style="color: #f78c6c;">2</span>, <span style="color: #f78c6c;">3</span>), (<span style="color: #f78c6c;">4</span>, <span style="color: #f78c6c;">6</span>, <span style="color: #f78c6c;">2</span>),
    (<span style="color: #f78c6c;">5</span>, <span style="color: #f78c6c;">1</span>, <span style="color: #f78c6c;">1</span>), (<span style="color: #f78c6c;">5</span>, <span style="color: #f78c6c;">7</span>, <span style="color: #f78c6c;">1</span>),
    (<span style="color: #f78c6c;">6</span>, <span style="color: #f78c6c;">8</span>, <span style="color: #f78c6c;">1</span>);
