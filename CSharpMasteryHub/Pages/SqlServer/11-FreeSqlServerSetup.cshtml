                            </div>
                            <div class="card-body p-4">

                                <!-- Step 1 -->
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h5><span class="badge bg-primary me-2">STEP 1</span> <i class="fas fa-user-plus text-primary me-2"></i> Create a Free Aiven Account</h5>
                                        <ol>
                                            <li>Go to <strong>aiven.io</strong> (opens in new tab)</li>
                                            <li>Click <strong>"Start Free"</strong> or <strong>"Sign Up"</strong></li>
                                            <li>Choose <strong>"Sign up with Google"</strong> or enter your email</li>
                                            <li>Create a password</li>
                                            <li>Check your email and verify your account</li>
                                        </ol>
                                        <div class="alert alert-success mt-2">
                                            <i class="fas fa-check-circle me-2"></i>
                                            <strong>✅ Done!</strong> You now have a free Aiven account.
                                            <br>
                                            <small>No credit card required for the free tier!</small>
                                        </div>
                                    </div>
                                </div>

