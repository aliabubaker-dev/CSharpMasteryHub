                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6><i class="fas fa-list text-primary me-2"></i>Your Mission:</h6>
                                                <ol>
                                                    <li>
                                                        <strong>Create Aiven Account</strong>
                                                        <ul>
                                                            <li>Go to aiven.io</li>
                                                            <li>Sign up for free</li>
