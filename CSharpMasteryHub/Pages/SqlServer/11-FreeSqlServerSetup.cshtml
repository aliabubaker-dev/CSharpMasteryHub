                                <button class="btn btn-primary mt-3" onclick="toggleSolution()" style="border-radius: 50px; padding: 12px 30px;">
                                    <i class="fas fa-eye me-2"></i> Show Connection Code
                                </button>

                                <div id="solution" style="display: none; margin-top: 20px;">
                                    <div class="p-3 rounded border" style="background: #1e1e2e;">
                                        <div class="code-block">
                                            <pre><code class="language-csharp"><span class="comment">// ===== CONNECT TO AIVEN FROM C# =====</span>
<span class="comment">// Full working example for your C# application</span>

<span class="keyword">using</span> System;
<span class="keyword">using</span> System.Data;
<span class="keyword">using</span> Microsoft.Data.SqlClient;

<span class="keyword">public</span> <span class="keyword">class</span> <span class="class">CloudDatabaseExample</span>
{
    <span class="comment">// Your Aiven connection string</span>
    <span class="keyword">private</span> <span class="keyword">static</span> <span class="keyword">string</span> connectionString = 
        <span class="string">"Server=your-database.aivencloud.com,5432;"</span> +
        <span class="string">"Database=defaultdb;"</span> +
        <span class="string">"User Id=avnadmin;"</span> +
        <span class="string">"Password=YourPassword;"</span> +
        <span class="string">"TrustServerCertificate=True;"</span> +
        <span class="string">"Encrypt=True;"</span>;

    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">Main</span>()
    {
        <span class="comment">// 1️⃣ Connect to the database</span>
        <span class="keyword">using</span> (<span class="keyword">var</span> conn = <span class="keyword">new</span> <span class="class">SqlConnection</span>(connectionString))
        {
            conn.<span class="function">Open</span>();
            Console.WriteLine(<span class="string">"✅ Connected to Aiven cloud database!"</span>);
            
            <span class="comment">// 2️⃣ Run a query</span>
            <span class="keyword">string</span> query = <span class="string">"SELECT @@VERSION"</span>;
            <span class="keyword">using</span> (<span class="keyword">var</span> cmd = <span class="keyword">new</span> <span class="class">SqlCommand</span>(query, conn))
            {
                <span class="keyword">string</span> version = cmd.<span class="function">ExecuteScalar</span>().<span class="function">ToString</span>();
                Console.WriteLine(<span class="string">$"📌 SQL Server Version: {version}"</span>);
            }
        }
    }
    
    <span class="comment">// 3️⃣ Example: Get data from a table</span>
    <span class="keyword">public</span> <span class="keyword">static</span> <span class="keyword">void</span> <span class="function">GetStudents</span>()
    {
        <span class="keyword">using</span> (<span class="keyword">var</span> conn = <span class="keyword">new</span> <span class="class">SqlConnection</span>(connectionString))
        {
            conn.<span class="function">Open</span>();
            <span class="keyword">string</span> query = <span class="string">"SELECT * FROM Students"</span>;
            <span class="keyword">using</span> (<span class="keyword">var</span> cmd = <span class="keyword">new</span> <span class="class">SqlCommand</span>(query, conn))
            {
                <span class="keyword">using</span> (<span class="keyword">var</span> reader = cmd.<span class="function">ExecuteReader</span>())
                {
                    <span class="keyword">while</span> (reader.<span class="function">Read</span>())
                    {
                        Console.WriteLine(<span class="string">$"Name: {reader["Name"]}"</span>);
                    }
                }
            }
        }
    }
}</code></pre>
