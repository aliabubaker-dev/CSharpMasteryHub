@page
@model CSharpMasteryHub.Pages.WindowsForms.CreatingWinFormsProjectModel
@{
    ViewData["Title"] = "Creating a WinForms Project";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms">Windows Forms</a></li>
                    <li class="breadcrumb-item active">Creating a WinForms Project</li>
                </ol>
            </nav>

            <div class="lesson-content">
                <h1 class="display-4 mb-3">Creating a WinForms Project</h1>
                <div class="d-flex gap-3 mb-4">
                    <span class="badge bg-success">Beginner</span>
                    <span class="badge bg-info text-dark">15 min read</span>
                    <span class="badge bg-primary">Lesson 1 of 7</span>
                </div>

                <h2>Step 1 — New Project</h2>
                <p>
                    In Visual Studio: <strong>File &rarr; New &rarr; Project</strong>. Search
                    for <strong>"Windows Forms App"</strong>. There are two templates —
                    choose the one targeting <strong>.NET Framework</strong> if your goal is
                    the classic .NET Framework runtime this module focuses on (a <strong>
                    .NET
                    (Core)
                </strong> WinForms template also exists and works almost identically).
            </p>

            <h2>Step 2 — Name and location</h2>
            <p>
                Name it something like <code>StudentManagerWinForms</code>. Choose a
                location and click <strong>Create</strong>.
            </p>

            <h2>Step 3 — The Designer</h2>
            <p>
                Visual Studio opens <code>Form1.cs [Design]</code> — a blank window with
                a <strong>Toolbox</strong> on the left (drag controls from here) and a
                <strong>Properties</strong> panel on the right (configure the selected
                control).
            </p>

            <h2>Step 4 — Run it</h2>
            <p>
                Press <kbd>F5</kbd>. An empty window appears — that's a running WinForms
                application. Close it to stop debugging.
            </p>

            <h2>Understanding the generated files</h2>
            <ul>
                <li><strong>Form1.cs</strong> — your code-behind, where event handlers and logic live.</li>
                <li><strong>Form1.Designer.cs</strong> — auto-generated by the designer; don't hand-edit this unless you know exactly what you're doing.</li>
                <li><strong>Program.cs</strong> — the entry point that launches <code>Form1</code>.</li>
            </ul>

            <pre><code>// Program.cs
static class Program
{
    [STAThread]
    static void Main()
    {
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);
        Application.Run(new Form1());
    }
}</code></pre>

            <div class="card bg-info bg-opacity-10 mb-4">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                    <p>Windows Forms uses a visual designer to build desktop applications. The <code>Program.cs</code> file is the entry point that launches your main form.</p>
                </div>
            </div>

            <div class="mt-5 d-flex justify-content-between">
                <a href="/WindowsForms" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Lessons
                </a>
                <a href="/WindowsForms/02-ControlsBasics" class="btn btn-primary-custom">
                    Next Lesson <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        @await Html.PartialAsync("_SidebarNav", Model.SidebarNav)
    </div>
</div>
</div>

@await Html.PartialAsync("_QuizButton", "WindowsForms_Lesson1")