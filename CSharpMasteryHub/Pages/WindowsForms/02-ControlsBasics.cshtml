        {
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"No users to clear!"</span>);
            <span class="keyword">return</span>;
        }
        
        <span class="keyword">if</span> (<span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Clear all users?"</span>, <span class="string">"Confirm"</span>,
                          <span class="class">MessageBoxButtons</span>.YesNo) == <span class="class">DialogResult</span>.Yes)
        {
            lstUsers.Items.Clear();
            users.Clear();
            lblStatus.Text = <span class="string">"🗑️ All users cleared"</span>;
            lblStatus.ForeColor = Color.Red;
        }
    }
    
    <span class="comment">// 📊 Display total users count</span>
