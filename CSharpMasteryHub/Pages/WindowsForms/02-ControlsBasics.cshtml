@page
@model CSharpMasteryHub.Pages.WindowsForms.ControlsBasicsModel
@{
    ViewData["Title"] = "Controls Basics - Learn Like a Pro";
}

<div class="container-fluid px-0">
    <!-- 🎨 Hero Section -->
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right" data-aos-duration="1000">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="/" style="color: rgba(255,255,255,0.7);">Home</a></li>
                            <li class="breadcrumb-item"><a href="/WindowsForms" style="color: rgba(255,255,255,0.7);">Windows Forms</a></li>
                            <li class="breadcrumb-item active" style="color: white;">Controls Basics</li>
                        </ol>
                    </nav>
                    <h1 class="display-2 fw-bold text-white" style="text-shadow: 0 0 30px rgba(102, 126, 234, 0.3);">
                        Controls Basics 🧩
                    </h1>
                    <p class="lead text-white-50 fs-4 mt-3">
                        Building Your User Interface - One Piece at a Time
                    </p>
                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <span class="badge bg-success fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-smile me-2"></i>Beginner Friendly
                        </span>
                        <span class="badge bg-info text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-clock me-2"></i>20 min read
                        </span>
                        <span class="badge bg-warning text-dark fs-6 px-4 py-2" style="border-radius: 50px;">
                            <i class="fas fa-book me-2"></i>Lesson 2 of 7
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-center" data-aos="fade-left" data-aos-duration="1000">
                    <i class="fas fa-puzzle-piece fa-8x text-white" style="opacity: 0.15; text-shadow: 0 0 50px rgba(102, 126, 234, 0.2);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Main Content -->
                <div class="lesson-content">

                    <!-- 🎉 Welcome Section -->
                    <div class="card border-0 shadow-lg mb-5" data-aos="fade-up" style="border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                        <div class="card-body p-5">
                            <div class="d-flex align-items-start">
                                <div class="me-4">
                                    <i class="fas fa-smile-wink fa-3x text-warning"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold text-primary">Let's Build Your User Interface! 🎯</h2>
                                    <p class="fs-5">
                                        In this lesson, you'll learn about <strong>controls</strong> - the building blocks
                                        of Windows Forms applications. Controls are like <strong>furniture</strong> for your app's window!
                                    </p>
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>By the end of this lesson, you'll be able to:</strong>
                                        <ul class="mb-0 mt-2">
                                            <li>✅ Understand what controls are and why they matter</li>
                                            <li>✅ Use the most common controls (Label, TextBox, Button, etc.)</li>
                                            <li>✅ Name controls properly (so your code makes sense)</li>
                                            <li>✅ Read and set control values in code</li>
                                            <li>✅ Make controls resize properly with Anchor and Dock</li>
                                            <li>✅ Feel confident building your first user interface!</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 📦 Part 1: What Are Controls? -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="100">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #4facfe;">
                            <div class="card-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-1 me-2"></i>What Are Controls?</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <strong>In Simple Words:</strong> Controls are the <strong>interactive elements</strong>
                                    on your form. They let users interact with your application - like buttons, textboxes, labels, and more!
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-home text-primary me-2"></i>🏠 Real-World Analogy</h5>
                                                <p><strong>Think of Controls like furniture in a house:</strong></p>
                                                <ul>
                                                    <li>🏷️ <strong>Label</strong> = A sign on the wall (displays text)</li>
                                                    <li>✏️ <strong>TextBox</strong> = A notepad (user writes text)</li>
                                                    <li>🔘 <strong>Button</strong> = A doorbell (user presses it)</li>
                                                    <li>📋 <strong>ListBox</strong> = A menu (shows options)</li>
                                                    <li>✅ <strong>CheckBox</strong> = A light switch (on/off)</li>
                                                </ul>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Result:</strong> A functional, interactive app!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-toolbox text-success me-2"></i>📦 Where to Find Controls</h5>
                                                <p>Controls are in the <strong>Toolbox</strong>:</p>
                                                <ul>
                                                    <li>🔹 Open <strong>View → Toolbox</strong> (or press <kbd>Ctrl + Alt + X</kbd>)</li>
                                                    <li>🔹 Controls are organized in groups (Common Controls, Containers, etc.)</li>
                                                    <li>🔹 Just drag and drop any control onto your form!</li>
                                                </ul>
                                                <div class="card bg-info text-white mt-2">
                                                    <div class="card-body">
                                                        <i class="fas fa-lightbulb me-2"></i>
                                                        <strong>Pro Tip:</strong> If you don't see the Toolbox,
                                                        click the <strong>Toolbox</strong> tab on the left side of Visual Studio!
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Fun Joke:</strong> Why did the control break up with the form?
                                        Because it needed more space! (Anchor and Dock jokes are coming later 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 🧩 Part 2: The Most Common Controls -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="200">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #43e97b;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-2 me-2"></i>The Most Common Controls</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Control</th>
                                                <th>Icon</th>
                                                <th>Use For</th>
                                                <th>Example</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><strong>Label</strong></td>
                                                <td><i class="fas fa-tag text-primary"></i></td>
                                                <td>Display static text</td>
                                                <td>"Enter your name:"</td>
                                            </tr>
                                            <tr>
                                                <td><strong>TextBox</strong></td>
                                                <td><i class="fas fa-edit text-success"></i></td>
                                                <td>User text input</td>
                                                <td>Name, email, password</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Button</strong></td>
                                                <td><i class="fas fa-square text-warning"></i></td>
                                                <td>Trigger actions</td>
                                                <td>"Save", "Cancel", "Submit"</td>
                                            </tr>
                                            <tr>
                                                <td><strong>ComboBox</strong></td>
                                                <td><i class="fas fa-caret-square-down text-info"></i></td>
                                                <td>Dropdown selection</td>
                                                <td>Choose a country, city</td>
                                            </tr>
                                            <tr>
                                                <td><strong>CheckBox</strong></td>
                                                <td><i class="fas fa-check-square text-danger"></i></td>
                                                <td>Yes/No choices</td>
                                                <td>"I agree to terms"</td>
                                            </tr>
                                            <tr>
                                                <td><strong>RadioButton</strong></td>
                                                <td><i class="fas fa-dot-circle text-primary"></i></td>
                                                <td>Choose one option</td>
                                                <td>Male / Female / Other</td>
                                            </tr>
                                            <tr>
                                                <td><strong>ListBox</strong></td>
                                                <td><i class="fas fa-list text-success"></i></td>
                                                <td>Scrollable list</td>
                                                <td>List of students</td>
                                            </tr>
                                            <tr>
                                                <td><strong>DataGridView</strong></td>
                                                <td><i class="fas fa-table text-info"></i></td>
                                                <td>Tabular data</td>
                                                <td>Customer list, orders</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Fun Fact:</strong> There are over 50 controls in WinForms!
                                        But you'll only need about 10-15 for most applications. The rest are for special cases!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ✏️ Part 3: Adding and Configuring Controls -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="300">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #f093fb;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-3 me-2"></i>Adding and Configuring Controls</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-plus-circle text-success me-2"></i>✅ How to Add a Control</h5>
                                                <p><strong>Two ways to add controls:</strong></p>
                                                <ol>
                                                    <li><strong>Drag and Drop</strong> - Click a control in Toolbox and drag it onto your form</li>
                                                    <li><strong>Double-click</strong> - Double-click a control in Toolbox and it appears on the form</li>
                                                </ol>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Tip:</strong> After adding a control, use the <strong>Properties</strong> window
                                                    to change its appearance and behavior!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-sliders-h text-primary me-2"></i>🔧 Common Properties</h5>
                                                <p>Here are the most useful properties to change:</p>
                                                <ul>
                                                    <li><strong>Name</strong> - What you'll use in code (e.g., <code>txtFirstName</code>)</li>
                                                    <li><strong>Text</strong> - What users see (e.g., "Enter Name")</li>
                                                    <li><strong>BackColor</strong> - Background color</li>
                                                    <li><strong>ForeColor</strong> - Text color</li>
                                                    <li><strong>Font</strong> - Font style and size</li>
                                                    <li><strong>Enabled</strong> - Can users interact with it?</li>
                                                    <li><strong>Visible</strong> - Is it shown on the form?</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Pro Tip:</strong> Always change the <strong>Name</strong> property first!
                                        It's like giving your pet a name - you'll need it to call them later! 🐶
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 📝 Part 4: Naming Controls Properly -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="400">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #667eea;">
                            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-4 me-2"></i>Naming Controls Properly</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-tag me-2"></i>
                                    <strong>Why Naming Matters:</strong> Good names make your code <strong>readable</strong>
                                    and <strong>maintainable</strong>. Bad names make you (and your team) confused!
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-times-circle text-danger me-2"></i>❌ Bad Names</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// What does "textBox1" mean?</span>
<span class="keyword">string</span> name = textBox1.Text;  <span class="comment">// ??</span>
<span class="keyword">string</span> age = textBox2.Text;   <span class="comment">// ??</span></code></pre>
                                                </div>
                                                <p class="text-danger">😵 You'll forget what these are for in 5 minutes!</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>✅ Good Names</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Clear! Meaningful!</span>
<span class="keyword">string</span> name = txtFirstName.Text;
<span class="keyword">string</span> age = txtAge.Text;
<span class="keyword">bool</span> active = chkIsActive.Checked;</code></pre>
                                                </div>
                                                <p class="text-success">😊 You'll know exactly what each control does!</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="table-responsive mt-3">
                                    <table class="table table-bordered">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Prefix</th>
                                                <th>Control Type</th>
                                                <th>Example Name</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr><td><strong>txt</strong></td><td>TextBox</td><td><code>txtName</code></td></tr>
                                            <tr><td><strong>btn</strong></td><td>Button</td><td><code>btnSave</code></td></tr>
                                            <tr><td><strong>lbl</strong></td><td>Label</td><td><code>lblTitle</code></td></tr>
                                            <tr><td><strong>cmb</strong></td><td>ComboBox</td><td><code>cmbCountry</code></td></tr>
                                            <tr><td><strong>chk</strong></td><td>CheckBox</td><td><code>chkAgree</code></td></tr>
                                            <tr><td><strong>rad</strong></td><td>RadioButton</td><td><code>radMale</code></td></tr>
                                            <tr><td><strong>lst</strong></td><td>ListBox</td><td><code>lstStudents</code></td></tr>
                                            <tr><td><strong>dgv</strong></td><td>DataGridView</td><td><code>dgvCustomers</code></td></tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="card bg-warning text-dark mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-laugh-beam me-2"></i>
                                        <strong>😂 Joke:</strong> Why did the developer name their control "textBox1"?
                                        Because they wanted to confuse their future self! (Don't do this! 😅)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 💻 Part 5: Using Controls in Code -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="500">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #43e97b;">
                            <div class="card-header" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-5 me-2"></i>Using Controls in Code</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-arrow-right text-primary me-2"></i>📖 Reading Values</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Get text from a TextBox</span>
<span class="keyword">string</span> name = txtName.Text;

<span class="comment">// Get checkbox state</span>
<span class="keyword">bool</span> isActive = chkActive.Checked;

<span class="comment">// Get selected ComboBox item</span>
<span class="keyword">string</span> course = cmbCourse.SelectedItem?.ToString();</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">.Text</span> <span class="badge bg-success">.Checked</span> <span class="badge bg-info">.SelectedItem</span></p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-arrow-left text-success me-2"></i>✏️ Setting Values</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Set text in a TextBox</span>
txtName.Text = <span class="string">"John"</span>;

<span class="comment">// Change label text</span>
lblStatus.Text = <span class="string">"Saved!"</span>;

<span class="comment">// Change color</span>
lblStatus.ForeColor = Color.Green;

<span class="comment">// Enable/disable a button</span>
btnSave.Enabled = <span class="keyword">false</span>;</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">.Text</span> <span class="badge bg-success">.ForeColor</span> <span class="badge bg-warning text-dark">.Enabled</span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-success text-white mt-3">
                                    <div class="card-body">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Pro Tip:</strong> Always validate user input before using it!
                                        <br>
                                        <code>if (string.IsNullOrWhiteSpace(txtName.Text)) { ... }</code>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 📐 Part 6: Anchoring and Docking -->
                    <section class="mb-5" data-aos="fade-up" data-aos-delay="600">
                        <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; border-left: 6px solid #f093fb;">
                            <div class="card-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                                <h3 class="mb-0"><i class="fas fa-6 me-2"></i>Anchoring and Docking - Making Controls Resize</h3>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-anchor text-primary me-2"></i>⚓ Anchor</h5>
                                                <p><strong>What it does:</strong> Keeps a control at a fixed distance from form edges.</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// In Properties window</span>
<span class="comment">// Anchor: Top, Bottom, Left, Right</span>
<span class="comment">// Choose which edges to "stick" to</span>

<span class="comment">// Example: Stick to bottom-right</span>
btnOK.Anchor = AnchorStyles.Bottom | AnchorStyles.Right;</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">Top</span> <span class="badge bg-success">Bottom</span> <span class="badge bg-info">Left</span> <span class="badge bg-warning text-dark">Right</span></p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light h-100">
                                            <div class="card-body">
                                                <h5><i class="fas fa-ship text-success me-2"></i>🚢 Dock</h5>
                                                <p><strong>What it does:</strong> Makes a control fill an entire edge or the whole form.</p>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// In Properties window</span>
<span class="comment">// Dock: Top, Bottom, Left, Right, Fill</span>

<span class="comment">// Example: DataGridView fills the form</span>
dgvData.Dock = DockStyle.Fill;</code></pre>
                                                </div>
                                                <p><span class="badge bg-primary">Fill</span> <span class="badge bg-success">Top</span> <span class="badge bg-info">Bottom</span> <span class="badge bg-warning text-dark">Left/Right</span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-check-circle text-success me-2"></i>✅ When to Use Each</h5>
                                                <ul>
                                                    <li><strong>Anchor</strong> - For buttons, labels, small controls</li>
                                                    <li><strong>Dock</strong> - For DataGridView, large panels, toolbars</li>
                                                    <li><strong>Both</strong> - Can be used together!</li>
                                                </ul>
                                                <div class="alert alert-success mt-2">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    <strong>Tip:</strong> Preview how controls behave by resizing the form in the designer!
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h5><i class="fas fa-example text-primary me-2"></i>💡 Common Patterns</h5>
                                                <div class="code-block small">
                                                    <pre><code class="language-csharp"><span class="comment">// Button at bottom-right (OK/Cancel)</span>
btnOK.Anchor = AnchorStyles.Bottom | AnchorStyles.Right;

<span class="comment">// Top toolbar</span>
toolStrip1.Dock = DockStyle.Top;

<span class="comment">// DataGridView fills rest</span>
dgvData.Dock = DockStyle.Fill;

<span class="comment">// Status bar at bottom</span>
statusStrip1.Dock = DockStyle.Bottom;</code></pre>
                                                </div>
                                            </div>
                                        </div>
