        <span class="comment">// 🤔 Validate inputs using If/Else</span>
        <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(txtFirstName.Text))
        {
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Please enter first name!"</span>);
            <span class="keyword">return</span>;
        }
        
        <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(txtLastName.Text))
        {
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Please enter last name!"</span>);
            <span class="keyword">return</span>;
        }
        
        <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(txtEmail.Text))
        {
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Please enter email!"</span>);
            <span class="keyword">return</span>;
        }
        
        <span class="keyword">if</span> (!chkAgree.Checked)
        {
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Please agree to terms!"</span>);
            <span class="keyword">return</span>;
        }
        
        <span class="comment">// ✅ All validated - save user</span>
        <span class="keyword">string</span> fullName = <span class="string">$"{txtFirstName.Text} {txtLastName.Text}"</span>;
        <span class="keyword">string</span> userInfo = <span class="string">$"👤 {fullName} ({txtEmail.Text})"</span>;
        
        <span class="comment">// 📋 Add to ListBox</span>
        lstUsers.Items.Add(userInfo);
        users.Add(userInfo);
        
        <span class="comment">// 💬 Show success message</span>
        lblStatus.Text = <span class="string">$"✅ {fullName} registered successfully!"</span>;
        lblStatus.ForeColor = Color.Green;
        
        <span class="comment">// 🧹 Clear form</span>
        txtFirstName.Clear();
        txtLastName.Clear();
        txtEmail.Clear();
        chkAgree.Checked = <span class="keyword">false</span>;
        txtFirstName.Focus();  <span class="comment">// Set focus to first field</span>
        
        <span class="comment">// 🔢 Show total users</span>
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Total registered users: {lstUsers.Items.Count}"</span>, 
                          <span class="string">"Registration Complete"</span>);
    }
    
    <span class="comment">// 🧹 Clear all users</span>
    <span class="keyword">private void</span> <span class="function">btnClearAll_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
