            height: 500px;
            background: rgba(255,255,255,0.03);
            border-radius: 50%;
            pointer-events: none;
        }

        /* Code Block Styling */
        .code-block {
            position: relative;
        }

        .code-block pre {
            background: #1e1e2e !important;
            color: #cdd6f4 !important;
