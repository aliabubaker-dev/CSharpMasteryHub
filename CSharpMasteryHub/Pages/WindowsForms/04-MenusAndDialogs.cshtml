                                            <pre><code class="language-csharp"><span class="comment">// ===== SIMPLE TEXT EDITOR =====</span>

<span class="keyword">public</span> <span class="keyword">partial</span> <span class="keyword">class</span> <span class="class">MainForm</span> : <span class="class">Form</span>
{
    <span class="keyword">private</span> <span class="keyword">string</span> currentFileName = <span class="string">""</span>;
    <span class="keyword">private</span> <span class="keyword">bool</span> hasChanges = <span class="keyword">false</span>;
    
    <span class="keyword">public</span> <span class="function">MainForm</span>()
    {
        <span class="function">InitializeComponent</span>();
        <span class="function">UpdateStatus</span>();
    }
    
    <span class="comment">// 📂 FILE MENU</span>
    
    <span class="keyword">private void</span> <span class="function">newToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (<span class="function">CheckSaveChanges</span>())
        {
            txtContent.Clear();
            currentFileName = <span class="string">""</span>;
            hasChanges = <span class="keyword">false</span>;
            <span class="function">UpdateStatus</span>();
        }
    }
    
    <span class="keyword">private void</span> <span class="function">openToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (!<span class="function">CheckSaveChanges</span>()) <span class="keyword">return</span>;
        
        <span class="keyword">using</span> (<span class="class">OpenFileDialog</span> openDlg = <span class="keyword">new</span> <span class="class">OpenFileDialog</span>())
        {
            openDlg.Filter = <span class="string">"Text Files (*.txt)|*.txt|All Files (*.*)|*.*"</span>;
            openDlg.Title = <span class="string">"Open a text file"</span>;
            
            <span class="keyword">if</span> (openDlg.ShowDialog() == <span class="class">DialogResult</span>.OK)
            {
                <span class="keyword">try</span>
                {
                    txtContent.Text = <span class="class">File</span>.<span class="function">ReadAllText</span>(openDlg.FileName);
                    currentFileName = openDlg.FileName;
                    hasChanges = <span class="keyword">false</span>;
                    <span class="function">UpdateStatus</span>();
                }
                <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
                {
                    <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Error opening file: {ex.Message}"</span>, 
                        <span class="string">"Error"</span>, <span class="class">MessageBoxButtons</span>.OK, <span class="class">MessageBoxIcon</span>.Error);
                }
            }
        }
    }
    
    <span class="keyword">private void</span> <span class="function">saveToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(currentFileName))
        {
            <span class="function">saveAsToolStripMenuItem_Click</span>(sender, e);
            <span class="keyword">return</span>;
        }
        
        <span class="function">SaveFile</span>(currentFileName);
    }
    
    <span class="keyword">private void</span> <span class="function">saveAsToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">using</span> (<span class="class">SaveFileDialog</span> saveDlg = <span class="keyword">new</span> <span class="class">SaveFileDialog</span>())
        {
            saveDlg.Filter = <span class="string">"Text Files (*.txt)|*.txt|All Files (*.*)|*.*"</span>;
            saveDlg.DefaultExt = <span class="string">"txt"</span>;
            saveDlg.Title = <span class="string">"Save your file"</span>;
            
            <span class="keyword">if</span> (saveDlg.ShowDialog() == <span class="class">DialogResult</span>.OK)
            {
                <span class="function">SaveFile</span>(saveDlg.FileName);
                currentFileName = saveDlg.FileName;
                <span class="function">UpdateStatus</span>();
            }
        }
    }
    
    <span class="keyword">private void</span> <span class="function">SaveFile</span>(<span class="keyword">string</span> fileName)
    {
        <span class="keyword">try</span>
        {
            <span class="class">File</span>.<span class="function">WriteAllText</span>(fileName, txtContent.Text);
            hasChanges = <span class="keyword">false</span>;
            <span class="function">UpdateStatus</span>();
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"File saved successfully!"</span>, <span class="string">"Success"</span>);
        }
        <span class="keyword">catch</span> (<span class="class">Exception</span> ex)
        {
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Error saving file: {ex.Message}"</span>, 
                <span class="string">"Error"</span>, <span class="class">MessageBoxButtons</span>.OK, <span class="class">MessageBoxIcon</span>.Error);
        }
    }
    
    <span class="keyword">private void</span> <span class="function">exitToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
