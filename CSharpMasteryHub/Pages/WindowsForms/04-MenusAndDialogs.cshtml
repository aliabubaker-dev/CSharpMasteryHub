    <span class="comment">// ✏️ EDIT MENU</span>
    
    <span class="keyword">private void</span> <span class="function">cutToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (txtContent.SelectedText != <span class="string">""</span>)
        {
            <span class="class">Clipboard</span>.<span class="function">SetText</span>(txtContent.SelectedText);
            txtContent.<span class="function">Cut</span>();
            hasChanges = <span class="keyword">true</span>;
            <span class="function">UpdateStatus</span>();
        }
    }
    
    <span class="keyword">private void</span> <span class="function">copyToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (txtContent.SelectedText != <span class="string">""</span>)
        {
            <span class="class">Clipboard</span>.<span class="function">SetText</span>(txtContent.SelectedText);
        }
    }
    
    <span class="keyword">private void</span> <span class="function">pasteToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (<span class="class">Clipboard</span>.<span class="function">ContainsText</span>())
        {
            txtContent.<span class="function">Paste</span>();
            hasChanges = <span class="keyword">true</span>;
            <span class="function">UpdateStatus</span>();
        }
    }
    
    <span class="comment">// ❓ HELP MENU</span>
    
    <span class="keyword">private void</span> <span class="function">aboutToolStripMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="class">AboutBox</span> about = <span class="keyword">new</span> <span class="class">AboutBox</span>();
        about.ShowDialog();
    }
    
    <span class="comment">// 📊 STATUS AND HELPERS</span>
    
    <span class="keyword">private void</span> <span class="function">txtContent_TextChanged</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        hasChanges = <span class="keyword">true</span>;
        <span class="function">UpdateStatus</span>();
    }
    
    <span class="keyword">private void</span> <span class="function">UpdateStatus</span>()
    {
        <span class="keyword">int</span> wordCount = txtContent.Text.<span class="function">Split</span>(<span class="keyword">new</span> <span class="keyword">char</span>[] { <span class="string">' '</span>, <span class="string">'\n'</span>, <span class="string">'\r'</span> }, 
            <span class="class">StringSplitOptions</span>.RemoveEmptyEntries).Length;
        
        <span class="keyword">string</span> fileName = <span class="keyword">string</span>.IsNullOrWhiteSpace(currentFileName) ? 
            <span class="string">"Untitled"</span> : <span class="class">Path</span>.<span class="function">GetFileName</span>(currentFileName);
        
        <span class="keyword">string</span> modified = hasChanges ? <span class="string">" *"</span> : <span class="string">""</span>;
        
        lblStatus.Text = <span class="string">$"📄 {fileName}{modified} | 📊 Words: {wordCount} | 📝 Characters: {txtContent.Text.Length}"</span>;
    }
    
    <span class="keyword">private bool</span> <span class="function">CheckSaveChanges</span>()
    {
        <span class="keyword">if</span> (!hasChanges) <span class="keyword">return</span> <span class="keyword">true</span>;
        
        <span class="class">DialogResult</span> result = <span class="class">MessageBox</span>.<span class="function">Show</span>(
            <span class="string">"Do you want to save changes before closing?"</span>,
            <span class="string">"Unsaved Changes"</span>,
            <span class="class">MessageBoxButtons</span>.YesNoCancel,
            <span class="class">MessageBoxIcon</span>.Warning
        );
        
        <span class="keyword">if</span> (result == <span class="class">DialogResult</span>.Yes)
        {
            <span class="function">saveToolStripMenuItem_Click</span>(<span class="keyword">this</span>, <span class="class">EventArgs</span>.Empty);
            <span class="keyword">return</span> !hasChanges;  <span class="comment">// Return true if saved</span>
        }
        <span class="keyword">else</span> <span class="keyword">if</span> (result == <span class="class">DialogResult</span>.No)
        {
            <span class="keyword">return</span> <span class="keyword">true</span>;  <span class="comment">// Discard changes</span>
        }
        <span class="keyword">else</span>
        {
            <span class="keyword">return</span> <span class="keyword">false</span>;  <span class="comment">// Cancel - don't continue</span>
        }
    }
    
    <span class="comment">// 🚪 Form Closing</span>
    <span class="keyword">private void</span> <span class="function">MainForm_FormClosing</span>(<span class="keyword">object</span> sender, <span class="class">FormClosingEventArgs</span> e)
    {
        <span class="keyword">if</span> (!<span class="function">CheckSaveChanges</span>())
        {
            e.Cancel = <span class="keyword">true</span>;
        }
    }
}

