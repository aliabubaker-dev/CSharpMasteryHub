                                            <pre><code class="language-csharp"><span class="comment">// ===== STUDENT MANAGEMENT APP =====</span>
<span class="comment">// This form uses lists, if/else, loops, and more!</span>

<span class="keyword">public</span> <span class="keyword">partial</span> <span class="keyword">class</span> <span class="class">StudentForm</span> : <span class="class">Form</span>
{
    <span class="comment">// 📋 List to store students</span>
    <span class="keyword">private</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt; students = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt;();
    
    <span class="keyword">public</span> <span class="function">StudentForm</span>()
    {
        <span class="function">InitializeComponent</span>();
        <span class="function">UpdateStudentList</span>();  <span class="comment">// Show students</span>
    }
    
    <span class="comment">// ➕ Add Student Button</span>
    <span class="keyword">private void</span> <span class="function">btnAdd_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">string</span> name = txtName.Text.Trim();
        
        <span class="comment">// 🤔 If/Else validation</span>
        <span class="keyword">if</span> (<span class="keyword">string</span>.IsNullOrWhiteSpace(name))
        {
            MessageBox.Show(<span class="string">"Please enter a name!"</span>);
            <span class="keyword">return</span>;
        }
        
        <span class="comment">// ✅ Add to list</span>
        students.Add(name);
        txtName.Clear();
        <span class="function">UpdateStudentList</span>();
    }
    
    <span class="comment">// ➖ Remove Student Button</span>
    <span class="keyword">private void</span> <span class="function">btnRemove_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">if</span> (lstStudents.SelectedIndex < <span class="number">0</span>)
        {
            MessageBox.Show(<span class="string">"Please select a student!"</span>);
            <span class="keyword">return</span>;
        }
        
        students.RemoveAt(lstStudents.SelectedIndex);
        <span class="function">UpdateStudentList</span>();
    }
    
    <span class="comment">// 🔁 Update the ListBox and Count</span>
    <span class="keyword">private void</span> <span class="function">UpdateStudentList</span>()
    {
        <span class="comment">// 🔁 Foreach loop to add items</span>
        lstStudents.Items.Clear();
        <span class="keyword">foreach</span> (<span class="keyword">string</span> student <span class="keyword">in</span> students)
        {
            lstStudents.Items.Add(student);
        }
        
        <span class="comment">// Show total count</span>
        lblCount.Text = <span class="string">$"Total Students: {students.Count}"</span>;
    }
    
    <span class="comment">// 🔁 For loop example - add 5 sample students</span>
    <span class="keyword">private void</span> <span class="function">btnAddSamples_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
    {
        <span class="keyword">string</span>[] sampleNames = { <span class="string">"Alice"</span>, <span class="string">"Bob"</span>, <span class="string">"Charlie"</span>, <span class="string">"Diana"</span>, <span class="string">"Eve"</span> };
        
        <span class="comment">// 🔁 For loop through the array</span>
        <span class="keyword">for</span> (<span class="keyword">int</span> i = <span class="number">0</span>; i < sampleNames.Length; i++)
        {
            students.Add(sampleNames[i]);
        }
        <span class="function">UpdateStudentList</span>();
    }
}</code></pre>
                                        </div>
