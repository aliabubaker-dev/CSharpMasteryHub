@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize AOS
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    once: true,
                    offset: 40,
                    duration: 600
                });
            }

            // Optional: add a little "copy" interaction for code blocks
            document.querySelectorAll('.code-block pre code').forEach(block => {
                block.style.cursor = 'default';
            });
        });
    </script>

    <style>
        /* ===== REFRESHER PAGE STYLES ===== */
        .refresher-lesson .refresher-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-radius: 16px !important;
        }

            .refresher-lesson .refresher-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 30px rgba(0,0,0,0.08) !important;
            }

        .refresher-lesson .code-block {
            background: #1a1a2e !important;
            border-radius: 12px;
            overflow-x: auto;
        }

            .refresher-lesson .code-block pre {
                background: transparent !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .refresher-lesson .code-block code {
                font-family: 'JetBrains Mono', 'Consolas', monospace;
                font-size: 0.9rem;
                color: #e4e4e4;
                line-height: 1.6;
            }

        /* Syntax colors (light on dark) */
        .language-csharp .keyword {
            color: #c792ea;
            font-weight: 600;
        }

        .language-csharp .comment {
            color: #676e95;
            font-style: italic;
        }

        .language-csharp .string {
            color: #c3e88d;
        }

        .language-csharp .number {
            color: #f78c6c;
        }

        .language-csharp .function {
            color: #82aaff;
        }

        .language-csharp .variable {
            color: #eeffff;
        }

        .language-csharp .class {
            color: #ffcb6b;
        }

        .language-csharp .property {
            color: #80cbc4;
        }

        .refresher-summary {
            border-left: 4px solid var(--primary-color) !important;
        }

        .refresher-header .badge {
            font-size: 0.85rem;
            font-weight: 500;
        }

        .winforms-tip {
            border-left: 3px solid #FFC107;
        }

        .quick-reference table th {
            background-color: #1a1a2e !important;
            color: #fff !important;
        }

        /* Responsive tweaks */
        @@media (max-width: 768px) {
            .refresher-lesson .refresher-card {
                padding: 1.25rem !important;
            }

            .refresher-lesson .code-block code {
                font-size: 0.8rem;
            }
        }
    </style>
}