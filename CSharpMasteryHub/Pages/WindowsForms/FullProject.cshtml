@page
@model CSharpMasteryHub.Pages.WindowsForms.FullProjectModel
@{
    ViewData["Title"] = "Full WinForms Project - All 29 Controls";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms">Windows Forms</a></li>
                    <li class="breadcrumb-item active">Full WinForms Project</li>
                </ol>
            </nav>

            <div class="lesson-content" data-aos="fade-up">
                <div class="d-flex gap-3 mb-4 flex-wrap">
                    <span class="badge bg-danger p-2 px-3 rounded-pill">Advanced</span>
                    <span class="badge bg-info text-dark p-2 px-3 rounded-pill"><i class="far fa-clock me-1"></i> 60 min read</span>
                    <span class="badge" style="background-color: #6f42c1; color: #fff;">All 29 Controls</span>
                    <span class="badge bg-warning text-dark">Step by Step</span>
                </div>

                <h1 class="display-5 fw-bold mb-3">
                    <i class="fas fa-project-diagram text-primary me-2"></i>Full WinForms Project
                </h1>
                <p class="lead mb-4">
                    Build a complete Windows Forms application using <span class="fw-bold text-primary">all 29 controls</span>
                    from the Toolbox. Follow this <span class="text-warning fw-bold">step-by-step</span> guide.
                </p>

                <!-- Important Note -->
                <div class="alert alert-danger mb-4" data-aos="fade-right">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>IMPORTANT:</strong> You will <u>ONLY</u> drag controls from the Toolbox.
                    <strong>DO NOT</strong> touch or edit the <code>MainForm.Designer.cs</code> file.
                    The designer file is auto-generated and will be updated automatically when you drag controls.
                </div>

                <!-- Project Overview -->
                <div class="card mb-4 border-primary" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>Project Overview</h4>
                        <p>
                            We'll build a <strong>"Student Management System"</strong> that uses every control in the
                            Windows Forms Toolbox.
                        </p>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <div class="p-2 bg-light rounded text-center">
                                    <i class="fas fa-check-circle text-success me-1"></i>
                                    <span class="small">29 Controls</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-2 bg-light rounded text-center">
                                    <i class="fas fa-check-circle text-success me-1"></i>
                                    <span class="small">Drag & Drop</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-2 bg-light rounded text-center">
                                    <i class="fas fa-check-circle text-success me-1"></i>
                                    <span class="small">Full Code</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-2 bg-light rounded text-center">
                                    <i class="fas fa-check-circle text-success me-1"></i>
                                    <span class="small">Working App</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 1: SETUP ===== -->
                <div class="section-divider mt-5 mb-4" data-aos="fade-up">
                    <h2 class="fw-bold text-primary"><i class="fas fa-tools me-2"></i>Part 1: Project Setup</h2>
                    <hr>
                </div>

                <!-- Step 1 -->
                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-1 me-2"></i>Step 1: Open Visual Studio</h4>
                        <p>
                            Open <strong>Visual Studio 2022</strong> from your Start Menu or Desktop shortcut.
                        </p>
                        <div class="alert alert-info">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Need Visual Studio?</strong> Download it for free from
                            <a href="https://visualstudio.microsoft.com/" target="_blank">visualstudio.microsoft.com</a>
                        </div>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="card mb-4" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-2 me-2"></i>Step 2: Create New Project</h4>
                        <ol>
                            <li>Click <strong>"Create a new project"</strong></li>
                            <li>Search for <strong>"Windows Forms App"</strong></li>
                            <li>Select <strong>"Windows Forms App (.NET Framework)"</strong></li>
                            <li>Click <strong>"Next"</strong></li>
                        </ol>
                        <div class="code-block bg-dark p-3 rounded-3 mt-2">
                            <pre><code class="language-text">Project Name: StudentManager
Location: C:\Users\YourName\Documents\Projects\
Framework: .NET 8.0</code></pre>
                        </div>
                        <div class="mt-2">
                            <span class="badge bg-primary">Project Name</span>
                            <span class="badge bg-success">StudentManager</span>
                            <span class="badge bg-info text-dark">.NET 8.0</span>
                        </div>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-3 me-2"></i>Step 3: Understand the Solution Explorer</h4>
                        <p>
                            After creating the project, look at the <strong>Solution Explorer</strong> on the right side.
                            You'll see this structure:
                        </p>
                        <div class="code-block bg-dark p-3 rounded-3 mt-2">
                            <pre><code class="language-text">📁 StudentManager/
├── 📁 Properties/
│   └── Resources.resx          (Images, icons - we'll use this)
├── 📄 Form1.cs                 (Your code - we'll rename this)
├── 📄 Form1.Designer.cs        (⚠️ DO NOT TOUCH this file!)
├── 📄 Program.cs               (Entry point - don't change)
├── 📄 App.config               (Settings - don't change)
└── 📄 StudentManager.csproj    (Project file)</code></pre>
                        </div>
                        <div class="alert alert-warning mt-2">
                            <i class="fas fa-hand-paper me-2"></i>
                            <strong>REMEMBER:</strong> <code>Form1.Designer.cs</code> is auto-generated.
                            <span class="text-danger fw-bold">NEVER edit it manually!</span>
                        </div>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="card mb-4" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-4 me-2"></i>Step 4: Rename Form1 to MainForm</h4>
                        <ol>
                            <li>In Solution Explorer, <strong>right-click</strong> on <code>Form1.cs</code></li>
                            <li>Select <strong>"Rename"</strong></li>
                            <li>Change it to <strong>MainForm.cs</strong></li>
                            <li>Press <strong>Enter</strong></li>
                            <li>When asked, click <strong>"Yes"</strong> to rename all references</li>
                        </ol>
                        <div class="alert alert-info mt-2">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Done!</strong> You should now see <code>MainForm.cs</code> in Solution Explorer.
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 2: BASIC CONTROLS ===== -->
                <div class="section-divider mt-5 mb-4" data-aos="fade-up">
                    <h2 class="fw-bold text-primary"><i class="fas fa-cubes me-2"></i>Part 2: Basic Controls</h2>
                    <hr>
                </div>

                <!-- Step 5 -->
                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-5 me-2"></i>Step 5: Open the Form Designer</h4>
                        <p>
                            <strong>Double-click</strong> on <code>MainForm.cs</code> in Solution Explorer to open the
                            form designer. You should see a blank form.
                        </p>
                        <div class="alert alert-info">
                            <i class="fas fa-mouse-pointer me-2"></i>
                            <strong>Make sure:</strong> The <strong>Toolbox</strong> is visible. If not, go to
                            <strong>View → Toolbox</strong>.
                        </div>
                    </div>
                </div>

                <!-- Step 6 -->
                <div class="card mb-4" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-6 me-2"></i>Step 6: Add Controls (Drag from Toolbox)</h4>
                        <p>
                            <strong>IMPORTANT:</strong> For each control, <u>drag it from the Toolbox</u> onto the form.
                            <span class="text-danger fw-bold">DO NOT type code</span> - the designer will handle everything!
                        </p>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>REMEMBER:</strong> You are <u>only</u> dragging controls from the Toolbox.
                            You will <u>never</u> open or edit the <code>MainForm.Designer.cs</code> file.
                        </div>

                        <div class="mt-3">
                            <h6 class="fw-bold">Add these controls in order:</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-sm">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>#</th>
                                            <th>Control</th>
                                            <th>Name</th>
                                            <th>Text/Properties</th>
                                            <th>Where to Find</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>1</td>
                                            <td>Label</td>
                                            <td><code>lblTitle</code></td>
                                            <td>"Student Manager"</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>2</td>
                                            <td>TextBox</td>
                                            <td><code>txtFirstName</code></td>
                                            <td>""</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>3</td>
                                            <td>TextBox</td>
                                            <td><code>txtLastName</code></td>
                                            <td>""</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>4</td>
                                            <td>Button</td>
                                            <td><code>btnSave</code></td>
                                            <td>"Save Student"</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>5</td>
                                            <td>CheckBox</td>
                                            <td><code>chkActive</code></td>
                                            <td>"Active"</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>6</td>
                                            <td>RadioButton</td>
                                            <td><code>rbMale</code></td>
                                            <td>"Male"</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>7</td>
                                            <td>RadioButton</td>
                                            <td><code>rbFemale</code></td>
                                            <td>"Female"</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>8</td>
                                            <td>ComboBox</td>
                                            <td><code>cmbCourse</code></td>
                                            <td>Items: Math, Science, History</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>9</td>
                                            <td>ListBox</td>
                                            <td><code>lstStudents</code></td>
                                            <td>Items: (empty for now)</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                        <tr>
                                            <td>10</td>
                                            <td>CheckedListBox</td>
                                            <td><code>clbHobbies</code></td>
                                            <td>Items: Reading, Sports, Music</td>
                                            <td>Toolbox → Common Controls</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Show Code for Step 6 -->
                        <div class="mt-3">
                            <button class="btn btn-outline-primary btn-sm" onclick="toggleCode('codeStep6')">
                                <i class="fas fa-code me-1"></i> Show Code for Step 6
                            </button>
                            <div id="codeStep6" style="display: none;" class="mt-2">
                                <div class="code-block bg-dark p-3 rounded-3">
                                    <pre><code class="language-csharp"><span class="comment">// After dragging all controls from the Toolbox</span>
<span class="comment">// The designer file (MainForm.Designer.cs) will automatically have:</span>

<span class="comment">// 1. Label - lblTitle</span>
<span class="keyword">this</span>.<span class="variable">lblTitle</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">Label</span>();
<span class="keyword">this</span>.<span class="variable">lblTitle</span>.<span class="property">Text</span> = <span class="string">"Student Manager"</span>;

<span class="comment">// 2. TextBox - txtFirstName</span>
<span class="keyword">this</span>.<span class="variable">txtFirstName</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">TextBox</span>();

<span class="comment">// 3. TextBox - txtLastName</span>
<span class="keyword">this</span>.<span class="variable">txtLastName</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">TextBox</span>();

<span class="comment">// 4. Button - btnSave</span>
<span class="keyword">this</span>.<span class="variable">btnSave</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">Button</span>();
<span class="keyword">this</span>.<span class="variable">btnSave</span>.<span class="property">Text</span> = <span class="string">"Save Student"</span>;

<span class="comment">// ... and so on for all controls</span>
<span class="comment">// ⚠️ DO NOT EDIT THIS FILE - It's auto-generated!</span></code></pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 3: CONTAINER CONTROLS ===== -->
                <div class="section-divider mt-5 mb-4" data-aos="fade-up">
                    <h2 class="fw-bold text-info"><i class="fas fa-layer-group me-2"></i>Part 3: Container Controls</h2>
                    <hr>
                </div>

                <!-- Step 7 -->
                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold text-info"><i class="fas fa-7 me-2"></i>Step 7: Add Container Controls</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Control</th>
                                        <th>Name</th>
                                        <th>Properties</th>
                                        <th>Where to Find</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>11</td>
                                        <td>GroupBox</td>
                                        <td><code>grpPersonalInfo</code></td>
                                        <td>Text: "Personal Information"</td>
                                        <td>Toolbox → Containers</td>
                                    </tr>
                                    <tr>
                                        <td>12</td>
                                        <td>Panel</td>
                                        <td><code>pnlButtons</code></td>
                                        <td>Dock: Bottom</td>
                                        <td>Toolbox → Containers</td>
                                    </tr>
                                    <tr>
                                        <td>13</td>
                                        <td>SplitContainer</td>
                                        <td><code>splitContainer</code></td>
                                        <td>Orientation: Vertical</td>
                                        <td>Toolbox → Containers</td>
                                    </tr>
                                    <tr>
                                        <td>14</td>
                                        <td>TableLayoutPanel</td>
                                        <td><code>tblLayout</code></td>
                                        <td>2 columns, 5 rows</td>
                                        <td>Toolbox → Containers</td>
                                    </tr>
                                    <tr>
                                        <td>15</td>
                                        <td>DataGridView</td>
                                        <td><code>dgvStudents</code></td>
                                        <td>Dock: Fill</td>
                                        <td>Toolbox → Data</td>
                                    </tr>
                                    <tr>
                                        <td>16</td>
                                        <td>ListView</td>
                                        <td><code>lvStudents</code></td>
                                        <td>View: Details</td>
                                        <td>Toolbox → Common Controls</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="alert alert-info mt-2">
                            <i class="fas fa-mouse-pointer me-2"></i>
                            <strong>Tip:</strong> Drag the <strong>SplitContainer</strong> first, then drag other
                            controls inside its panels.
                        </div>

                        <!-- Show Code for Step 7 -->
                        <div class="mt-3">
                            <button class="btn btn-outline-info btn-sm" onclick="toggleCode('codeStep7')">
                                <i class="fas fa-code me-1"></i> Show Code for Step 7
                            </button>
                            <div id="codeStep7" style="display: none;" class="mt-2">
                                <div class="code-block bg-dark p-3 rounded-3">
                                    <pre><code class="language-csharp"><span class="comment">// After dragging container controls from the Toolbox</span>
<span class="comment">// The designer file will automatically have:</span>

<span class="comment">// 11. GroupBox</span>
<span class="keyword">this</span>.<span class="variable">grpPersonalInfo</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">GroupBox</span>();
<span class="keyword">this</span>.<span class="variable">grpPersonalInfo</span>.<span class="property">Text</span> = <span class="string">"Personal Information"</span>;

<span class="comment">// 12. Panel</span>
<span class="keyword">this</span>.<span class="variable">pnlButtons</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">Panel</span>();
<span class="keyword">this</span>.<span class="variable">pnlButtons</span>.<span class="property">Dock</span> = <span class="class">DockStyle</span>.<span class="property">Bottom</span>;

<span class="comment">// 13. SplitContainer</span>
<span class="keyword">this</span>.<span class="variable">splitContainer</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">SplitContainer</span>();
<span class="keyword">this</span>.<span class="variable">splitContainer</span>.<span class="property">Orientation</span> = <span class="class">Orientation</span>.<span class="property">Vertical</span>;

<span class="comment">// 14. TableLayoutPanel</span>
<span class="keyword">this</span>.<span class="variable">tblLayout</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">TableLayoutPanel</span>();

<span class="comment">// 15. DataGridView</span>
<span class="keyword">this</span>.<span class="variable">dgvStudents</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">DataGridView</span>();
<span class="keyword">this</span>.<span class="variable">dgvStudents</span>.<span class="property">Dock</span> = <span class="class">DockStyle</span>.<span class="property">Fill</span>;

<span class="comment">// 16. ListView</span>
<span class="keyword">this</span>.<span class="variable">lvStudents</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">ListView</span>();
<span class="keyword">this</span>.<span class="variable">lvStudents</span>.<span class="property">View</span> = <span class="class">View</span>.<span class="property">Details</span>;</code></pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== SECTION 4: SPECIALIZED CONTROLS ===== -->
                <div class="section-divider mt-5 mb-4" data-aos="fade-up">
                    <h2 class="fw-bold text-warning"><i class="fas fa-cog me-2"></i>Part 4: Specialized Controls</h2>
                    <hr>
                </div>

                <!-- Step 8 -->
                <div class="card mb-4" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold text-warning"><i class="fas fa-8 me-2"></i>Step 8: Add Specialized Controls</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Control</th>
                                        <th>Name</th>
                                        <th>Properties</th>
                                        <th>Where to Find</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>17</td>
                                        <td>DateTimePicker</td>
                                        <td><code>dtpBirthDate</code></td>
                                        <td>Format: Short</td>
                                        <td>Toolbox → Common Controls</td>
                                    </tr>
                                    <tr>
                                        <td>18</td>
                                        <td>PictureBox</td>
                                        <td><code>pbProfile</code></td>
                                        <td>SizeMode: Zoom</td>
                                        <td>Toolbox → Common Controls</td>
                                    </tr>
                                    <tr>
                                        <td>19</td>
                                        <td>ImageList</td>
                                        <td><code>imgList</code></td>
                                        <td>Images: Add icons (click the ... button)</td>
                                        <td>Toolbox → Components</td>
                                    </tr>
                                    <tr>
                                        <td>20</td>
                                        <td>RichTextBox</td>
                                        <td><code>rtbNotes</code></td>
                                        <td>""</td>
                                        <td>Toolbox → Common Controls</td>
                                    </tr>
                                    <tr>
                                        <td>21</td>
                                        <td>WebBrowser</td>
                                        <td><code>webBrowser</code></td>
                                        <td>Navigate to "about:blank"</td>
                                        <td>Toolbox → Common Controls</td>
                                    </tr>
                                    <tr>
                                        <td>22</td>
                                        <td>Timer</td>
                                        <td><code>timerClock</code></td>
                                        <td>Interval: 1000 (Enabled: false)</td>
                                        <td>Toolbox → Components</td>
                                    </tr>
                                    <tr>
                                        <td>23</td>
                                        <td>LinkLabel</td>
                                        <td><code>llHelp</code></td>
                                        <td>"Need Help?"</td>
                                        <td>Toolbox → Common Controls</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="alert alert-warning mt-2">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Note:</strong> The <strong>ImageList</strong> and <strong>Timer</strong> controls
                            appear in the <strong>component tray</strong> (the gray area below the form), not on the form itself.
                        </div>

                        <!-- Show Code for Step 8 -->
                        <div class="mt-3">
                            <button class="btn btn-outline-warning btn-sm" onclick="toggleCode('codeStep8')">
                                <i class="fas fa-code me-1"></i> Show Code for Step 8
                            </button>
                            <div id="codeStep8" style="display: none;" class="mt-2">
                                <div class="code-block bg-dark p-3 rounded-3">
                                    <pre><code class="language-csharp"><span class="comment">// After dragging specialized controls from the Toolbox</span>

<span class="comment">// 17. DateTimePicker</span>
<span class="keyword">this</span>.<span class="variable">dtpBirthDate</span> = <span class="keyword">new</span> <span class="class">System</span>.<span class="class">Windows</span>.<span class="class">Forms</span>.<span class="class">DateTimePicker</span>();
<span class="keyword">this</span>.<span class="variable">dtpBirthDate</span>.<span class="property">Format</span> = <span class="class">DateTimePickerFormat</span>.<span class="property">Short</span>;

