<a href="c:\users\ali pc\onedrive\desktop\csharpmasteryhub\csharpmasteryhub\pages\windowsforms\toolboxmastery\controls\checkbox.cshtml">c:\users\ali pc\onedrive\desktop\csharpmasteryhub\csharpmasteryhub\pages\windowsforms\toolboxmastery\controls\checkbox.cshtml</a>
