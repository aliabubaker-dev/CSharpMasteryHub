@page
@model CSharpMasteryHub.Pages.WindowsForms.ToolboxMastery.Controls.CheckedListBoxModel
@{
    ViewData["Title"] = "CheckedListBox Control - Toolbox Mastery";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms">Windows Forms</a></li>
