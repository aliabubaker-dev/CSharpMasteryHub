@{
    ViewData["Title"] = "ListBox Control - Toolbox Mastery";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms">Windows Forms</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms/ToolboxMastery">Toolbox Mastery</a></li>
                    <li class="breadcrumb-item active">ListBox</li>
                </ol>
            </nav>

            <div class="lesson-content" data-aos="fade-up">
                <div class="control-header d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="badge bg-warning text-dark p-2 px-3 rounded-pill">Intermediate</span>
                    <span class="badge bg-info text-dark p-2 px-3 rounded-pill"><i class="far fa-clock me-1"></i> 10 min read</span>
                    <span class="badge bg-primary p-2 px-3 rounded-pill">Control #11</span>
                </div>

                <h1 class="display-5 fw-bold mb-3">
                    <i class="fas fa-list text-primary me-2"></i>ListBox Control
                </h1>
                <p class="lead mb-4">
                    The ListBox displays a scrollable list of items. Users can select one or more items.
                </p>

                <div class="card mb-4 border-primary" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>What is a ListBox?</h4>
                        <p>
                            A ListBox shows items in a list. Users can scroll through and select items.
                            It's great for showing a list of options, files, or names.
                        </p>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-code text-warning me-2"></i>Code Example</h4>
                        <div class="code-block bg-dark p-3 rounded-3">
                            <pre><code class="language-csharp"><span class="comment">// Add items</span>
<span class="variable">listBox1</span>.<span class="property">Items</span>.<span class="function">Add</span>(<span class="string">"Item 1"</span>);
<span class="variable">listBox1</span>.<span class="property">Items</span>.<span class="function">AddRange</span>(<span class="keyword">new</span> <span class="keyword">object</span>[] { <span class="string">"Item 2"</span>, <span class="string">"Item 3"</span> });

<span class="comment">// Get selected item</span>
<span class="keyword">private void</span> <span class="function">btnGetSelected_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
{
    <span class="keyword">if</span> (<span class="variable">listBox1</span>.<span class="property">SelectedItem</span> != <span class="keyword">null</span>)
    {
        <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Selected: {<span class="variable">listBox1</span>.SelectedItem}"</span>);
    }
}

<span class="comment">// Multi-selection</span>
<span class="variable">listBox1</span>.<span class="property">SelectionMode</span> = <span class="class">SelectionMode</span>.<span class="property">MultiExtended</span>;

<span class="comment">// Get all selected items</span>
<span class="keyword">private void</span> <span class="function">btnGetAllSelected_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
{
    <span class="keyword">var</span> <span class="variable">selected</span> = <span class="keyword">new</span> <span class="class">List</span>&lt;<span class="keyword">string</span>&gt;();
    <span class="keyword">foreach</span> (<span class="keyword">var</span> <span class="variable">item</span> <span class="keyword">in</span> <span class="variable">listBox1</span>.<span class="property">SelectedItems</span>)
    {
        <span class="variable">selected</span>.<span class="function">Add</span>(<span class="variable">item</span>.<span class="function">ToString</span>());
    }
    <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Selected: {<span class="keyword">string</span>.Join(", ", selected)}"</span>);
}</code></pre>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-pencil-alt me-2"></i>Exercise</h4>
                        <p><strong>Task:</strong> Create a simple shopping list app.</p>
                        <ol>
                            <li>Add a ListBox with shopping items.</li>
                            <li>Add a TextBox and Button to add new items.</li>
                            <li>Add a Button to remove selected items.</li>
                            <li>Add a Button to clear all items.</li>
                            <li>Add a Label showing total items count.</li>
                        </ol>
                    </div>
                </div>

                <div class="card bg-info bg-opacity-10 mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>
                            ListBox is great for displaying lists. Use <code>SelectionMode</code> to control
                            whether users can select one or multiple items.
                        </p>
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between flex-wrap gap-2">
