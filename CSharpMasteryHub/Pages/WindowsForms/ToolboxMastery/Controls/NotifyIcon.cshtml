@page
@model CSharpMasteryHub.Pages.WindowsForms.ToolboxMastery.Controls.NotifyIconModel
@{
    ViewData["Title"] = "NotifyIcon Control - Toolbox Mastery";
}

<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms">Windows Forms</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms/ToolboxMastery">Toolbox Mastery</a></li>
                    <li class="breadcrumb-item active">NotifyIcon</li>
                </ol>
            </nav>

            <div class="lesson-content" data-aos="fade-up">
                <div class="control-header d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="badge bg-danger p-2 px-3 rounded-pill">Advanced</span>
                    <span class="badge bg-info text-dark p-2 px-3 rounded-pill"><i class="far fa-clock me-1"></i> 12 min read</span>
                    <span class="badge bg-primary p-2 px-3 rounded-pill">Control #14</span>
                </div>

                <h1 class="display-5 fw-bold mb-3">
                    <i class="fas fa-bell text-primary me-2"></i>NotifyIcon Control
                </h1>
                <p class="lead mb-4">
                    NotifyIcon adds an icon to the system tray (notification area) and allows you to
                    show balloon tips and context menus.
                </p>

                <div class="card mb-4 border-primary" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>What is a NotifyIcon?</h4>
                        <p>
                            NotifyIcon is a non-visual component that displays an icon in the system tray.
                            It's perfect for background applications that need to show notifications or
                            provide quick access from the taskbar.
                        </p>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-code text-warning me-2"></i>Code Example</h4>
                        <div class="code-block bg-dark p-3 rounded-3">
                            <pre><code class="language-csharp"><span class="comment">// Setup NotifyIcon</span>
<span class="variable">notifyIcon1</span>.<span class="property">Icon</span> = <span class="class">SystemIcons</span>.<span class="property">Information</span>;
<span class="variable">notifyIcon1</span>.<span class="property">Text</span> = <span class="string">"My Application"</span>;
<span class="variable">notifyIcon1</span>.<span class="property">Visible</span> = <span class="keyword">true</span>;

<span class="comment">// Show balloon tip</span>
<span class="variable">notifyIcon1</span>.<span class="function">ShowBalloonTip</span>(<span class="number">3000</span>, <span class="string">"Notification"</span>, 
    <span class="string">"Hello! This is a balloon tip."</span>, 
    <span class="class">ToolTipIcon</span>.<span class="property">Info</span>);

<span class="comment">// Handle click on NotifyIcon</span>
<span class="keyword">private void</span> <span class="function">notifyIcon1_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
{
    <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">"Notification clicked!"</span>);
}

<span class="comment">// Add ContextMenuStrip</span>
<span class="comment">// In designer, set ContextMenuStrip property</span>
<span class="comment">// Add items: Open, Settings, Exit</span>

<span class="keyword">private void</span> <span class="function">openMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
{
    <span class="comment">// Show your main form</span>
    <span class="function">ShowForm</span>();
}

<span class="keyword">private void</span> <span class="function">exitMenuItem_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
{
    <span class="variable">notifyIcon1</span>.<span class="property">Visible</span> = <span class="keyword">false</span>;
    <span class="class">Application</span>.<span class="function">Exit</span>();
}</code></pre>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-pencil-alt me-2"></i>Exercise</h4>
                        <p><strong>Task:</strong> Create a background timer app with NotifyIcon.</p>
                        <ol>
                            <li>Add a NotifyIcon with an icon and tooltip.</li>
                            <li>Add a ContextMenuStrip with: Show, Hide, Exit.</li>
                            <li>Add a Timer that shows a balloon tip every 30 seconds.</li>
                            <li>When the user clicks the notify icon, show/hide the main form.</li>
                            <li>When the user closes the form, hide it and keep the app running.</li>
                        </ol>
                    </div>
                </div>

                <div class="card bg-info bg-opacity-10 mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>
                            NotifyIcon is essential for background applications. Use it with ContextMenuStrip
                            to provide quick access to features from the system tray.
                        </p>
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between flex-wrap gap-2">
