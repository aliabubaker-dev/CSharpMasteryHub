@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({ once: true, offset: 40, duration: 600 });
            }
        });
    </script>
    <style>
        .code-block pre {
