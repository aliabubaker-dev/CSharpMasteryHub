                    <li class="breadcrumb-item active">SaveFileDialog</li>
                </ol>
            </nav>

            <div class="lesson-content" data-aos="fade-up">
                <div class="control-header d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="badge bg-warning text-dark p-2 px-3 rounded-pill">Intermediate</span>
                    <span class="badge bg-info text-dark p-2 px-3 rounded-pill"><i class="far fa-clock me-1"></i> 10 min read</span>
                    <span class="badge bg-primary p-2 px-3 rounded-pill">Control #23</span>
                </div>

                <h1 class="display-5 fw-bold mb-3">
                    <i class="fas fa-save text-primary me-2"></i>SaveFileDialog Control
                </h1>
                <p class="lead mb-4">
                    SaveFileDialog lets users choose where to save a file. It provides a standard Windows
                    save dialog with file type filtering.
                </p>

                <div class="card mb-4 border-primary" data-aos="fade-right">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>What is a SaveFileDialog?</h4>
                        <p>
                            SaveFileDialog shows the standard save file dialog. Users can navigate folders,
                            enter a filename, and select file types. It returns the selected path if the
                            user clicks Save.
                        </p>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-left">
                    <div class="card-body">
                        <h4 class="fw-bold"><i class="fas fa-code text-warning me-2"></i>Code Example</h4>
                        <div class="code-block bg-dark p-3 rounded-3">
                            <pre><code class="language-csharp"><span class="comment">// Show SaveFileDialog</span>
<span class="keyword">private void</span> <span class="function">btnSave_Click</span>(<span class="keyword">object</span> sender, <span class="class">EventArgs</span> e)
{
    <span class="keyword">using</span> (<span class="keyword">var</span> <span class="variable">saveDialog</span> = <span class="keyword">new</span> <span class="class">SaveFileDialog</span>())
    {
        <span class="comment">// Configure the dialog</span>
        <span class="variable">saveDialog</span>.<span class="property">Filter</span> = <span class="string">"Text Files (*.txt)|*.txt|All Files (*.*)|*.*"</span>;
        <span class="variable">saveDialog</span>.<span class="property">DefaultExt</span> = <span class="string">"txt"</span>;
        <span class="variable">saveDialog</span>.<span class="property">AddExtension</span> = <span class="keyword">true</span>;
        <span class="variable">saveDialog</span>.<span class="property">FileName</span> = <span class="string">"MyDocument"</span>;
        
        <span class="keyword">if</span> (<span class="variable">saveDialog</span>.<span class="function">ShowDialog</span>() == <span class="class">DialogResult</span>.<span class="property">OK</span>)
        {
            <span class="comment">// Save the file using saveDialog.FileName</span>
            <span class="class">File</span>.<span class="function">WriteAllText</span>(<span class="variable">saveDialog</span>.<span class="property">FileName</span>, <span class="variable">content</span>);
            <span class="class">MessageBox</span>.<span class="function">Show</span>(<span class="string">$"Saved to: {saveDialog.FileName}"</span>);
        }
    }
}

<span class="comment">// Save with different file types</span>
<span class="keyword">private void</span> <span class="function">SaveAsRichText</span>()
{
    <span class="keyword">using</span> (<span class="keyword">var</span> <span class="variable">saveDialog</span> = <span class="keyword">new</span> <span class="class">SaveFileDialog</span>())
    {
        <span class="variable">saveDialog</span>.<span class="property">Filter</span> = <span class="string">"RTF Files (*.rtf)|*.rtf|Text Files (*.txt)|*.txt"</span>;
        <span class="variable">saveDialog</span>.<span class="property">DefaultExt</span> = <span class="string">"rtf"</span>;
        
        <span class="keyword">if</span> (<span class="variable">saveDialog</span>.<span class="function">ShowDialog</span>() == <span class="class">DialogResult</span>.<span class="property">OK</span>)
        {
            <span class="variable">richTextBox1</span>.<span class="function">SaveFile</span>(<span class="variable">saveDialog</span>.<span class="property">FileName</span>);
        }
    }
}</code></pre>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <h4 class="fw-bold text-success"><i class="fas fa-pencil-alt me-2"></i>Exercise</h4>
                        <p><strong>Task:</strong> Create a text editor with save functionality.</p>
                        <ol>
                            <li>Add a RichTextBox for editing.</li>
                            <li>Add a Button: "Save".</li>
                            <li>Show SaveFileDialog when clicked.</li>
                            <li>Save the content as a text file.</li>
                            <li>Add a Button: "Save As".</li>
                            <li>Add support for different file types (TXT, RTF).</li>
                        </ol>
                    </div>
                </div>

                <div class="card bg-info bg-opacity-10 mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-key me-2"></i>Key Takeaway</h5>
                        <p>
                            SaveFileDialog provides a professional save experience. Use <code>Filter</code>
                            to limit file types and <code>FileName</code> for the default name.
                        </p>
                    </div>
