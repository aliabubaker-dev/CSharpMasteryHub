                    </a>
                    <a href="/WindowsForms/ToolboxMastery/Controls/ToolStrip" class="btn btn-primary-custom">
                        Next: ToolStrip <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="sidebar-nav">
                <h5 class="mb-3"><i class="fas fa-list me-2"></i>Controls</h5>
                <nav class="nav flex-column">
                    <a class="nav-link" href="/WindowsForms/ToolboxMastery/Controls/Button">Button</a>
