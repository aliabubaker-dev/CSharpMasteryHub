@page
@model CSharpMasteryHub.Pages.WindowsForms.ToolboxMastery.IndexModel
@{
    ViewData["Title"] = "Windows Forms Toolbox Mastery";
}

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WindowsForms">Windows Forms</a></li>
                    <li class="breadcrumb-item active">Toolbox Mastery</li>
                </ol>
            </nav>

            <div class="text-center mb-5" data-aos="fade-up">
                <h1 class="display-4 fw-bold">
                    <i class="fas fa-toolbox text-primary me-3"></i>Windows Forms Toolbox Mastery
                </h1>
                <p class="lead text-muted">
                    Master every control in the Windows Forms Toolbox. Learn what each control does,
                    how to use it, and practice with hands-on exercises.
                </p>
                <div class="mt-3">
                    <span class="badge bg-primary p-2 px-3 me-2">29 Controls</span>
                    <span class="badge bg-success p-2 px-3 me-2">Beginner to Advanced</span>
                    <span class="badge bg-warning text-dark p-2 px-3">60-Question Quiz</span>
                </div>
            </div>

            <!-- Controls Grid -->
            <div class="row g-4">
                <!-- Row 1: Basic Controls -->
                <div class="col-12">
                    <h3 class="mb-3" data-aos="fade-right">
                        <i class="fas fa-star text-warning me-2"></i>Basic Controls
                    </h3>
                </div>

                <!-- Label -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/Label" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-tag fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">Label</h5>
                            <p class="text-muted small">Display static text on a form</p>
                            <span class="badge bg-success">Beginner</span>
                        </a>
                    </div>
                </div>

                <!-- TextBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="150">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/TextBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-font fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">TextBox</h5>
                            <p class="text-muted small">Single or multi-line text input</p>
                            <span class="badge bg-success">Beginner</span>
                        </a>
                    </div>
                </div>

                <!-- Button -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/Button" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-square fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">Button</h5>
                            <p class="text-muted small">Trigger actions with a click</p>
                            <span class="badge bg-success">Beginner</span>
                        </a>
                    </div>
                </div>

                <!-- CheckBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="250">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/CheckBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-check-square fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">CheckBox</h5>
                            <p class="text-muted small">True/False or On/Off selection</p>
                            <span class="badge bg-success">Beginner</span>
                        </a>
                    </div>
                </div>

                <!-- RadioButton -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/RadioButton" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-circle fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">RadioButton</h5>
                            <p class="text-muted small">Mutually exclusive selection</p>
                            <span class="badge bg-success">Beginner</span>
                        </a>
                    </div>
                </div>

                <!-- ComboBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="350">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/ComboBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-caret-square-down fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">ComboBox</h5>
                            <p class="text-muted small">Dropdown selection list</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- ListBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="400">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/ListBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-list fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">ListBox</h5>
                            <p class="text-muted small">Scrollable list of items</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- CheckedListBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="450">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/CheckedListBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-list-check fa-2x text-primary"></i>
                            </div>
                            <h5 class="fw-bold">CheckedListBox</h5>
                            <p class="text-muted small">List with checkable items</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- Row 2: Data & Container Controls -->
                <div class="col-12 mt-4">
                    <h3 class="mb-3" data-aos="fade-right">
                        <i class="fas fa-database text-info me-2"></i>Data & Container Controls
                    </h3>
                </div>

                <!-- DataGridView -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="500">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/DataGridView" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-table fa-2x text-info"></i>
                            </div>
                            <h5 class="fw-bold">DataGridView</h5>
                            <p class="text-muted small">Display and edit tabular data</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- ListView -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="550">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/ListView" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-th-list fa-2x text-info"></i>
                            </div>
                            <h5 class="fw-bold">ListView</h5>
                            <p class="text-muted small">Display items in different views</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- GroupBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="600">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/GroupBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-layer-group fa-2x text-info"></i>
                            </div>
                            <h5 class="fw-bold">GroupBox</h5>
                            <p class="text-muted small">Group related controls</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- Panel -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="650">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/Panel" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-square fa-2x text-info"></i>
                            </div>
                            <h5 class="fw-bold">Panel</h5>
                            <p class="text-muted small">Container for grouping controls</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- SplitContainer -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="700">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/SplitContainer" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-columns fa-2x text-info"></i>
                            </div>
                            <h5 class="fw-bold">SplitContainer</h5>
                            <p class="text-muted small">Resizable split panels</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- TableLayoutPanel -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="750">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/TableLayoutPanel" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-table fa-2x text-info"></i>
                            </div>
                            <h5 class="fw-bold">TableLayoutPanel</h5>
                            <p class="text-muted small">Grid-based layout container</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- Row 3: Specialized Controls -->
                <div class="col-12 mt-4">
                    <h3 class="mb-3" data-aos="fade-right">
                        <i class="fas fa-cogs text-success me-2"></i>Specialized Controls
                    </h3>
                </div>

                <!-- DateTimePicker -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="800">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/DateTimePicker" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-calendar fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">DateTimePicker</h5>
                            <p class="text-muted small">Select date and time</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- PictureBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="850">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/PictureBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-image fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">PictureBox</h5>
                            <p class="text-muted small">Display images</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- ImageList -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="900">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/ImageList" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-images fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">ImageList</h5>
                            <p class="text-muted small">Store images for other controls</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- RichTextBox -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="950">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/RichTextBox" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-align-left fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">RichTextBox</h5>
                            <p class="text-muted small">Format text with colors and fonts</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- WebBrowser -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1000">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/WebBrowser" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-globe fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">WebBrowser</h5>
                            <p class="text-muted small">Display web pages</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- Timer -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1050">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/Timer" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-clock fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">Timer</h5>
                            <p class="text-muted small">Execute code at intervals</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- LinkLabel -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1100">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/LinkLabel" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-link fa-2x text-success"></i>
                            </div>
                            <h5 class="fw-bold">LinkLabel</h5>
                            <p class="text-muted small">Clickable hyperlink</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- Row 4: Menus, Dialogs & Printing -->
                <div class="col-12 mt-4">
                    <h3 class="mb-3" data-aos="fade-right">
                        <i class="fas fa-print text-danger me-2"></i>Menus, Dialogs & Printing
                    </h3>
                </div>

                <!-- MenuStrip -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1150">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/MenuStrip" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-bars fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">MenuStrip</h5>
                            <p class="text-muted small">Create menus (File, Edit, Help)</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- ToolStrip -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1200">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/ToolStrip" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-toolbar fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">ToolStrip</h5>
                            <p class="text-muted small">Create toolbars with buttons</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- NotifyIcon -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1250">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/NotifyIcon" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-bell fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">NotifyIcon</h5>
                            <p class="text-muted small">System tray notifications</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- PrintDocument -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1300">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/PrintDocument" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-file-alt fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">PrintDocument</h5>
                            <p class="text-muted small">Define what to print</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- PrintDialog -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1350">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/PrintDialog" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-print fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">PrintDialog</h5>
                            <p class="text-muted small">Printer selection dialog</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- PrintPreviewDialog -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1400">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/PrintPreviewDialog" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-eye fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">PrintPreviewDialog</h5>
                            <p class="text-muted small">Preview before printing</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- PageSetupDialog -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1450">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/PageSetupDialog" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-file-pdf fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">PageSetupDialog</h5>
                            <p class="text-muted small">Page layout settings</p>
                            <span class="badge bg-danger">Advanced</span>
                        </a>
                    </div>
                </div>

                <!-- SaveFileDialog -->
                <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="1500">
                    <div class="control-card p-3 rounded-3 bg-white shadow-sm h-100">
                        <a href="/WindowsForms/ToolboxMastery/Controls/SaveFileDialog" class="text-decoration-none">
                            <div class="control-icon mb-2">
                                <i class="fas fa-save fa-2x text-danger"></i>
                            </div>
                            <h5 class="fw-bold">SaveFileDialog</h5>
                            <p class="text-muted small">Save file selection dialog</p>
                            <span class="badge bg-warning text-dark">Intermediate</span>
                        </a>
                    </div>
                </div>

                <!-- Quiz Button -->
                <div class="col-12 mt-5" data-aos="fade-up">
                    <div class="text-center p-5 bg-primary bg-opacity-10 rounded-4">
                        <h3 class="fw-bold mb-3">
                            <i class="fas fa-brain text-warning me-2"></i>Test Your Knowledge
                        </h3>
                        <p class="lead mb-4">
                            Take the 60-question Toolbox Mastery quiz to test your understanding of all controls.
                        </p>
                        <a href="/WindowsForms/ToolboxMastery/Quiz" class="btn btn-warning btn-lg pulse-btn">
                            <i class="fas fa-play me-2"></i>Start Quiz
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .control-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 12px !important;
    }

        .control-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

        .control-card a {
            display: block;
            color: inherit;
        }

    .control-icon {
        text-align: center;
    }

    .control-card h5 {
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }

    .control-card p {
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
    }

    .pulse-btn {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255,193,7,0.4);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(255,193,7,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255,193,7,0);
        }
    }

    @@media (max-width: 768px) {
        .control-card {
            padding: 1rem !important;
        }

            .control-card h5 {
                font-size: 0.85rem;
            }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({ once: true, offset: 40, duration: 600 });
            }
        });
    </script>
}